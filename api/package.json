{
  "name": "sofija-nutrition-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "func start --cors \"*\"",
    "build": "tsc && node -e \"require('fs').cpSync('src/fonts', 'dist/fonts', {recursive: true})\" && node -e \"require('fs').copyFileSync('host.json', 'dist/host.json')\" && node scripts/prepare-dist-package.js",
    "build:watch": "tsc --watch",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint:types": "tsc --noEmit --strict"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.11.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "date-fns": "^4.1.0",
    "json5": "^2.2.3",
    "pdf-lib": "^1.17.1",
    "resend": "^6.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
