{
  "model": "sonnet",
  "effortLevel": "medium",
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/quiet-node.js\"",
            "timeout": 10,
            "statusMessage": "Trimming test output..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-file-guard.js\"",
            "timeout": 10,
            "statusMessage": "Checking task file size and log entry..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-log.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-log.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(git rebase main)",
      "Bash(git rebase --abort)",
      "Bash(git push origin main)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm run build)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git merge --ff-only:*)",
      "PowerShell(git rebase main)",
      "PowerShell(git rebase --abort)",
      "PowerShell(git push origin main)",
      "PowerShell(npx jest:*)",
      "PowerShell(npx tsc:*)",
      "PowerShell(npx playwright test:*)",
      "PowerShell(npm run build)",
      "PowerShell(& .\\.claude\\scripts\\prepare-branch.ps1:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./api/local.settings.json)",
      "Read(./.auth/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git push origin main -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .:*)",
      "Bash(git restore:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push origin main --force:*)",
      "PowerShell(git push origin main -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git checkout -- :*)",
      "PowerShell(git checkout .:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git stash:*)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "20"
  }
}
