        initializeDateInputs();
        initDatePicker();

        // Проверяем авторизацию - Microsoft OAuth или E2E Token
        const e2eTokenStored = sessionStorage.getItem('e2e_token');
        if (e2eTokenStored) {
            // E2E режим - проверяем токен через API
            fetch(API_BASE + '/test/auth', {
                headers: { 'X-E2E-Token': e2eTokenStored }
            }).then(r => r.json()).then(data => {
                if (data.clientPrincipal) {
                    document.getElementById('user-info').textContent = data.clientPrincipal.userDetails + ' (E2E)';
                }
            }).catch(() => {
                // Токен невалиден - очищаем
                sessionStorage.removeItem('e2e_token');
            });
        } else {
            // Стандартная Microsoft авторизация
            fetch('/.auth/me').then(r => r.json()).then(data => {
                if (data.clientPrincipal) {
                    document.getElementById('user-info').textContent = data.clientPrincipal.userDetails || data.clientPrincipal.userId;
                }
            }).catch(() => {});
        }

        const tabBtns = document.querySelectorAll('.admin-tab');
        const tabContents = document.querySelectorAll('.admin-content');
        const mobileSelect = document.getElementById('mobile-tab-selector');

        function switchTab(tabId) {
            tabBtns.forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`.admin-tab[data-tab="${tabId}"]`);
            if (activeBtn) activeBtn.classList.add('active');
            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            mobileSelect.value = tabId;
            if (tabId === 'bookings') loadCalendar();
            if (tabId === 'availability') loadAvailability();
            if (tabId === 'settings') loadSettings();
            if (tabId === 'data') loadTableData();
        }

        tabBtns.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
        mobileSelect.addEventListener('change', e => switchTab(e.target.value));

        document.getElementById('prev-month').addEventListener('click', () => { 
            const currentDate = getCurrentDate();
            currentDate.setDate(1); 
            currentDate.setMonth(currentDate.getMonth() - 1); 
            setCurrentDate(currentDate);
            loadCalendar(); 
        });
        document.getElementById('next-month').addEventListener('click', () => { 
            const currentDate = getCurrentDate();
            currentDate.setDate(1); 
            currentDate.setMonth(currentDate.getMonth() + 1); 
            setCurrentDate(currentDate);
            loadCalendar(); 
        });
        document.getElementById('today-btn').addEventListener('click', () => { 
            setCurrentDate(new Date()); 
            loadCalendar(); 
        });
        document.getElementById('refresh-bookings').addEventListener('click', loadCalendar);
        document.getElementById('close-day-details').addEventListener('click', () => document.getElementById('day-details').classList.add('hidden'));

        async function loadCalendar() {
            const loading = document.getElementById('bookings-loading');
            const container = document.getElementById('calendar-container');
            loading.classList.remove('hidden');
            container.classList.add('hidden');
            document.getElementById('day-details').classList.add('hidden');
            
            const currentDate = getCurrentDate();
            document.getElementById('current-month').textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;

            try {
                const year = currentDate.getFullYear();
                
                // Use centralized API client
                const data = await loadCalendarData(year);
                
                allBookings = data.bookings;
                holidays = data.holidays;
                schedule = data.schedule;
                blockedDates = data.blockedDates;
                vacationPeriods = data.vacations;
                
                // Update calendar data in calendar module
                setCalendarData({ bookings: allBookings, schedule, holidays, blockedDates, vacationPeriods });
                
                console.log('📅 Loaded vacation periods:', vacationPeriods);
                renderCalendar();
                loading.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (error) {
                loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>';
            }
        }

        // Находит ближайшую будущую запись и переключает календарь на этот месяц
        async function navigateToFirstUpcomingBooking() {
            try {
                const firstBooking = await findFirstUpcomingBooking();
                
                if (firstBooking) {
                    const today = new Date();
                    const bookingDate = new Date(firstBooking.date);
                    
                    // Если запись в другом месяце - переключаемся
                    if (bookingDate.getMonth() !== today.getMonth() || bookingDate.getFullYear() !== today.getFullYear()) {
                        setCurrentDate(new Date(bookingDate.getFullYear(), bookingDate.getMonth(), 1));
                        console.log(`📅 Переключено на месяц с ближайшей записью: ${firstBooking.date}`);
                    }
                }
            } catch (error) {
                console.error('Ошибка при поиске ближайших записей:', error);
            }
        }

        // Expose showDayDetails to window for calendar cells onclick
        window.showDayDetails = showDayDetails;

        // Helper function to check if date is in vacation period (for non-calendar use)
        function isDateInVacation(dateStr) {
            return vacationPeriods.some(v => dateStr >= v.startDate && dateStr <= v.endDate);
        }

        window.confirmBooking = async function(id) {
            const confirmed = await showConfirm('Vai tiešām vēlaties apstiprināt šo ierakstu?', 'Apstiprināt ierakstu');
            if (!confirmed) return;
            try { 
                await confirmBookingApi(id);
                await loadCalendar();
                // Refresh day details if a date is selected
                const selectedDate = getSelectedDate();
                if (selectedDate) {
                    showDayDetails(selectedDate);
                }
                showToast('Ieraksts veiksmīgi apstiprināts', 'success'); 
            } catch (e) { 
                showToast(e.message, 'error'); 
            }
        };

        window.cancelBooking = async function(id) {
            const confirmed = await showConfirm('Vai tiešām vēlaties atcelt šo ierakstu?', 'Atcelt ierakstu');
            if (!confirmed) return;
            try { 
                await cancelBookingApi(id);
                await loadCalendar();
                // Refresh day details if a date is selected
                const selectedDate = getSelectedDate();
                if (selectedDate) {
                    showDayDetails(selectedDate);
                }
                showToast('Ieraksts veiksmīgi atcelts', 'success'); 
            } catch (e) { 
                showToast(e.message, 'error'); 
            }
        };

        // Availability functions using utilities
        function loadAvailability() {
            loadAvailabilityForm(API_BASE, () => loadHolidays(API_BASE));
            setupVacationDateValidation();
        }

        // Setup holidays listeners
        setupHolidaysListeners(API_BASE);

        document.getElementById('save-availability').addEventListener('click', () => saveAvailability(API_BASE));

        document.getElementById('add-vacation').addEventListener('click', () => {
            addVacation(API_BASE, () => {
                loadAvailability();
                loadCalendar();
            });
        });

        window.removeVacation = async function(id) {
            await removeVacationUtil(API_BASE, id, () => {
                loadAvailability();
                loadCalendar();
            });
        };

        document.getElementById('add-blocked-date').addEventListener('click', () => {
            addBlockedDate(API_BASE, loadAvailability);
        });

        window.removeBlockedDate = async function(date) {
            await removeBlockedDateUtil(API_BASE, date, loadAvailability);
        };

        function loadSettings() {
            fetch(API_BASE + '/dashboard/settings').then(r => r.json()).then(data => {
                if (data.prices) { document.getElementById('price-initial').value = data.prices.initial || 65; document.getElementById('price-followup').value = data.prices.followup || 45; }
                if (data.contact) { document.getElementById('contact-email').value = data.contact.email || ''; document.getElementById('contact-phone').value = data.contact.phone || ''; document.getElementById('contact-address').value = data.contact.address || ''; }
                if (data.duration) { document.getElementById('duration-initial').value = data.duration.initial || 60; document.getElementById('duration-followup').value = data.duration.followup || 30; }
                if (data.bank) { document.getElementById('bank-name').value = data.bank.name || ''; document.getElementById('bank-iban').value = data.bank.iban || ''; }
            }).catch(() => {});
        }

        document.getElementById('save-settings').addEventListener('click', async () => {
            const settings = { prices: { initial: parseInt(document.getElementById('price-initial').value), followup: parseInt(document.getElementById('price-followup').value) }, contact: { email: document.getElementById('contact-email').value, phone: document.getElementById('contact-phone').value, address: document.getElementById('contact-address').value }, duration: { initial: parseInt(document.getElementById('duration-initial').value), followup: parseInt(document.getElementById('duration-followup').value) }, bank: { name: document.getElementById('bank-name').value, iban: document.getElementById('bank-iban').value } };
            try { await fetch(API_BASE + '/dashboard/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(settings) }); showToast('Iestatījumi saglabāti!', 'success'); } catch (e) { showToast(e.message, 'error'); }
        });

        // При первой загрузке - переходим к месяцу с ближайшими записями
        navigateToFirstUpcomingBooking().then(() => loadCalendar());

        let currentTableData = null;
        let filteredTableData = [];
        let selectedRows = new Set();
        let currentSortColumn = null;
        let currentSortDirection = 'asc';

        async function loadTableData() {
            const tableName = document.getElementById('table-select').value;
            const loading = document.getElementById('table-loading');
            const container = document.getElementById('table-container');
            const filters = document.getElementById('table-filters');
            const empty = document.getElementById('table-empty');
            
            loading.classList.remove('hidden'); 
            container.classList.add('hidden'); 
            if (empty) empty.classList.add('hidden');
            
            selectedRows.clear();
            updateBatchActionsUI();
            
            try { 
                const response = await fetch(API_BASE + '/dashboard/tables/' + tableName); 
                const data = await response.json(); 
                currentTableData = data; 
                filteredTableData = data.entities || [];
                
                loading.classList.add('hidden'); 
                
                if (!data.entities || data.entities.length === 0) { 
                    if (empty) empty.classList.remove('hidden'); 
                    document.getElementById('table-count').textContent = '0'; 
                    filters.classList.add('hidden');
                    return; 
                }
                
                filters.classList.remove('hidden');
                applyFilters();
            } catch (error) { 
                loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>'; 
            }
        }

        function applyFilters() {
            if (!currentTableData || !currentTableData.entities) return;
            
            const searchTerm = document.getElementById('table-search').value.toLowerCase();
            const statusFilter = document.getElementById('filter-status').value;
            const dateFrom = document.getElementById('filter-date-from').value;
            const dateTo = document.getElementById('filter-date-to').value;
            
            let filtered = currentTableData.entities;
            
            // Search filter
            if (searchTerm) {
                filtered = filtered.filter(entity => {
                    return Object.values(entity).some(value => {
                        if (value === null || value === undefined) return false;
                        return String(value).toLowerCase().includes(searchTerm);
                    });
                });
            }
            
            // Status filter
            if (statusFilter) {
                filtered = filtered.filter(entity => entity.status === statusFilter);
            }
            
            // Date range filter
            if (dateFrom || dateTo) {
                filtered = filtered.filter(entity => {
                    const entityDate = entity.date;
                    if (!entityDate) return false;
                    
                    const dateStr = entityDate.split('T')[0]; // Get yyyy-mm-dd part
                    
                    if (dateFrom) {
                        const [day, month, year] = dateFrom.split('/');
                        const fromDate = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                        if (dateStr < fromDate) return false;
                    }
                    
                    if (dateTo) {
                        const [day, month, year] = dateTo.split('/');
                        const toDate = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                        if (dateStr > toDate) return false;
                    }
                    
                    return true;
                });
            }
            
            filteredTableData = filtered;
            renderTable();
            updateFilterCount();
        }

        function updateFilterCount() {
            const total = currentTableData?.entities?.length || 0;
            const filtered = filteredTableData.length;
            const countEl = document.getElementById('filtered-count');
            
            document.getElementById('table-count').textContent = total;
            
            if (filtered < total) {
                countEl.textContent = `(rāda ${filtered})`;
                countEl.classList.remove('hidden');
            } else {
                countEl.classList.add('hidden');
            }
        }

        function sortTable(column) {
            if (currentSortColumn === column) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortDirection = 'asc';
            }
            
            filteredTableData.sort((a, b) => {
                let valA = a[column];
                let valB = b[column];
                
                // Handle null/undefined
                if (valA === null || valA === undefined) return 1;
                if (valB === null || valB === undefined) return -1;
                
                // Convert to string for comparison
                valA = String(valA).toLowerCase();
                valB = String(valB).toLowerCase();
                
                const comparison = valA < valB ? -1 : valA > valB ? 1 : 0;
                return currentSortDirection === 'asc' ? comparison : -comparison;
            });
            
            renderTable();
        }

        function renderTable() {
            const header = document.getElementById('table-header');
            const body = document.getElementById('table-body');
            const container = document.getElementById('table-container');
            const columns = currentTableData.columns || [];
            
            // Header with sorting
            const allSelected = filteredTableData.length > 0 && selectedRows.size === filteredTableData.length;
            header.innerHTML = `<tr>
                <th style="width: 50px;">
                    <input type="checkbox" id="select-all" ${allSelected ? 'checked' : ''} title="${allSelected ? 'Noņemt izvēli no visiem' : 'Izvēlēties visus'}">
                </th>
                ${columns.map(col => `
                    <th onclick="sortTable('${col}')" style="cursor: pointer; user-select: none;">
                        ${col}
                        ${currentSortColumn === col ? 
                            (currentSortDirection === 'asc' ? ' ▲' : ' ▼') : 
                            ' ⇅'}
                    </th>
                `).join('')}
                <th>Darbības</th>
            </tr>`;
            
            // Body
            body.innerHTML = filteredTableData.map((entity, index) => {
                const pk = encodeURIComponent(entity.partitionKey || '');
                const rk = encodeURIComponent(entity.rowKey || '');
                const rowId = `${pk}_${rk}`;
                const isSelected = selectedRows.has(rowId);
                
                return `<tr class="${isSelected ? 'row-selected' : ''}" data-row-id="${rowId}">
                    <td>
                        <input type="checkbox" class="row-checkbox" data-row-id="${rowId}" ${isSelected ? 'checked' : ''}>
                    </td>
                    ${columns.map(col => { 
                        let value = entity[col]; 
                        if (value === undefined || value === null) value = ''; 
                        if (typeof value === 'object') value = JSON.stringify(value); 
                        const displayValue = String(value).length > 40 ? String(value).substring(0, 40) + '...' : value; 
                        let style = ''; 
                        if (col === 'status') { 
                            if (value === 'confirmed') style = 'color:#16a34a;font-weight:600;'; 
                            else if (value === 'pending') style = 'color:#ca8a04;font-weight:600;'; 
                            else if (value === 'cancelled') style = 'color:#dc2626;font-weight:600;'; 
                        } 
                        return `<td style="${style}" title="${String(value).replace(/"/g, '&quot;')}">${displayValue}</td>`; 
                    }).join('')}
                    <td>
                        <button onclick="deleteEntity('${pk}', '${rk}')" class="btn-close" title="Dzēst">
                            <i class="ph ph-trash"></i>
                        </button>
                    </td>
                </tr>`;
            }).join('');
            
            container.classList.remove('hidden');
            
            // Attach checkbox listeners (remove old ones first to prevent duplicates)
            const selectAllCheckbox = document.getElementById('select-all');
            if (selectAllCheckbox) {
                selectAllCheckbox.replaceWith(selectAllCheckbox.cloneNode(true));
                document.getElementById('select-all').addEventListener('change', handleSelectAll);
            }
            
            document.querySelectorAll('.row-checkbox').forEach(cb => {
                cb.addEventListener('change', handleRowSelect);
            });
        }

        function handleSelectAll(e) {
            const checked = e.target.checked;
            selectedRows.clear();
            
            if (checked) {
                filteredTableData.forEach(entity => {
                    const pk = encodeURIComponent(entity.partitionKey || '');
                    const rk = encodeURIComponent(entity.rowKey || '');
                    selectedRows.add(`${pk}_${rk}`);
                });
            }
            
            renderTable();
            updateBatchActionsUI();
        }

        function handleRowSelect(e) {
            const rowId = e.target.dataset.rowId;
            
            if (e.target.checked) {
                selectedRows.add(rowId);
            } else {
                selectedRows.delete(rowId);
            }
            
            updateBatchActionsUI();
            
            // Update row styling
            const row = document.querySelector(`tr[data-row-id="${rowId}"]`);
            if (row) {
                if (e.target.checked) {
                    row.classList.add('row-selected');
                } else {
                    row.classList.remove('row-selected');
                }
            }
            
            // Update select-all checkbox
            const selectAll = document.getElementById('select-all');
            if (selectAll) {
                selectAll.checked = selectedRows.size === filteredTableData.length && filteredTableData.length > 0;
            }
        }

        function updateBatchActionsUI() {
            const batchActions = document.getElementById('batch-actions');
            const selectedCount = document.getElementById('selected-count');
            
            selectedCount.textContent = selectedRows.size;
            
            if (selectedRows.size > 0) {
                batchActions.classList.remove('hidden');
            } else {
                batchActions.classList.add('hidden');
            }
        }

        async function batchDelete() {
            if (selectedRows.size === 0) return;
            
            const confirmed = await showConfirm(
                `Vai tiešām dzēst ${selectedRows.size} ierakstu${selectedRows.size === 1 ? '' : 's'}?`,
                'Dzēst ierakstus'
            );
            
            if (!confirmed) return;
            
            const tableName = document.getElementById('table-select').value;
            let successCount = 0;
            let errorCount = 0;
            
            for (const rowId of selectedRows) {
                const [pk, rk] = rowId.split('_').map(decodeURIComponent);
                
                try {
                    const response = await fetch(`${API_BASE}/dashboard/tables/${tableName}/${encodeURIComponent(pk)}/${encodeURIComponent(rk)}`, {
                        method: 'DELETE'
                    });
                    
                    if (response.ok) {
                        successCount++;
                    } else {
                        errorCount++;
                    }
                } catch (e) {
                    errorCount++;
                }
            }
            
            selectedRows.clear();
            await loadTableData();
            
            if (errorCount === 0) {
                showToast(`${successCount} ieraksti dzēsti`, 'success');
            } else {
                showToast(`${successCount} dzēsti, ${errorCount} kļūdas`, 'warning');
            }
        }

        function batchExport() {
            if (selectedRows.size === 0) return;
            
            const columns = currentTableData.columns;
            const selectedEntities = filteredTableData.filter(entity => {
                const pk = encodeURIComponent(entity.partitionKey || '');
                const rk = encodeURIComponent(entity.rowKey || '');
                return selectedRows.has(`${pk}_${rk}`);
            });
            
            const csvContent = [
                columns.join(','),
                ...selectedEntities.map(row => 
                    columns.map(col => {
                        let value = row[col];
                        if (value === undefined || value === null) return '';
                        if (typeof value === 'object') value = JSON.stringify(value);
                        value = String(value).replace(/"/g, '""');
                        if (value.includes(',') || value.includes('"') || value.includes('\n')) value = `"${value}"`;
                        return value;
                    }).join(',')
                )
            ].join('\n');
            
            const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `${document.getElementById('table-select').value}_selected_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(url);
            
            showToast(`${selectedEntities.length} ieraksti eksportēti`, 'success');
        }

        window.deleteEntity = async function(partitionKey, rowKey) {
            const confirmed = await showConfirm('Vai tiešām dzēst šo ierakstu?', 'Dzēst ierakstu');
            if (!confirmed) return;
            const tableName = document.getElementById('table-select').value;
            try { const response = await fetch(`${API_BASE}/dashboard/tables/${tableName}/${partitionKey}/${rowKey}`, { method: 'DELETE' }); if (response.ok) { loadTableData(); showToast('Ieraksts dzēsts', 'success'); } else { const error = await response.json(); showToast(error.details || error.error, 'error'); } } catch (e) { showToast(e.message, 'error'); }
        };

        function exportTableToCSV() {
            if (!currentTableData.entities || currentTableData.entities.length === 0) { showToast('Nav datu eksportēšanai', 'warning'); return; }
            const columns = currentTableData.columns;
            const rows = currentTableData.entities;
            const csvContent = [columns.join(','), ...rows.map(row => columns.map(col => { let value = row[col]; if (value === undefined || value === null) return ''; if (typeof value === 'object') value = JSON.stringify(value); value = String(value).replace(/"/g, '""'); if (value.includes(',') || value.includes('"') || value.includes('\n')) value = `"${value}"`; return value; }).join(','))].join('\n');
            const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `${document.getElementById('table-select').value}_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(url);
        }

        document.getElementById('table-select').addEventListener('change', loadTableData);
        document.getElementById('refresh-table').addEventListener('click', loadTableData);
        document.getElementById('export-csv').addEventListener('click', exportTableToCSV);
        
        // Filter listeners
        document.getElementById('table-search')?.addEventListener('input', applyFilters);
        document.getElementById('filter-status')?.addEventListener('change', applyFilters);
        document.getElementById('filter-date-from')?.addEventListener('change', applyFilters);
        document.getElementById('filter-date-to')?.addEventListener('change', applyFilters);
        
        document.getElementById('clear-filters')?.addEventListener('click', () => {
            document.getElementById('table-search').value = '';
            document.getElementById('filter-status').value = '';
            document.getElementById('filter-date-from').value = '';
            document.getElementById('filter-date-to').value = '';
            applyFilters();
        });
        
        // Batch action listeners
        document.getElementById('batch-delete')?.addEventListener('click', batchDelete);
        document.getElementById('batch-export')?.addEventListener('click', batchExport);
        document.getElementById('deselect-all')?.addEventListener('click', () => {
            selectedRows.clear();
            renderTable();
            updateBatchActionsUI();
        });
    </script>
</Layout>
