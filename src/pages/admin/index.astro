---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sofija Nutrition - Admin Panel">
    <div class="min-h-screen bg-gray-50">
        <!-- Header -->
        <header class="bg-white shadow-sm border-b">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center gap-4">
                    <h1 class="text-xl font-semibold text-gray-800">🌿 Sofija Nutrition Admin</h1>
                </div>
                <div class="flex items-center gap-4">
                    <span id="user-info" class="text-sm text-gray-600"></span>
                    <a href="/.auth/logout" class="text-sm text-red-600 hover:text-red-800">Iziet</a>
                </div>
            </div>
        </header>

        <!-- Navigation Tabs -->
        <nav class="bg-white border-b">
            <div class="max-w-7xl mx-auto px-4">
                <div class="flex gap-6">
                    <button class="tab-btn active py-4 px-2 border-b-2 border-primary text-primary font-medium" data-tab="bookings">
                        📅 Ieraksti
                    </button>
                    <button class="tab-btn py-4 px-2 border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="availability">
                        🕐 Pieejamība
                    </button>
                    <button class="tab-btn py-4 px-2 border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="settings">
                        ⚙️ Iestatījumi
                    </button>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 py-6">
            <!-- Bookings Tab -->
            <div id="tab-bookings" class="tab-content">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                    <h2 class="text-lg font-semibold">Klientu ieraksti</h2>
                    <div class="flex flex-wrap gap-2 items-center">
                        <button id="prev-month" class="px-3 py-2 bg-gray-100 rounded-lg text-sm hover:bg-gray-200">
                            ← Iepriekšējais
                        </button>
                        <span id="current-month" class="font-medium px-4 py-2 min-w-[180px] text-center"></span>
                        <button id="next-month" class="px-3 py-2 bg-gray-100 rounded-lg text-sm hover:bg-gray-200">
                            Nākamais →
                        </button>
                        <button id="today-btn" class="px-3 py-2 bg-primary text-white rounded-lg text-sm hover:bg-primary/90 ml-2">
                            Šodien
                        </button>
                        <button id="refresh-bookings" class="px-3 py-2 bg-gray-100 rounded-lg text-sm hover:bg-gray-200">
                            🔄
                        </button>
                    </div>
                </div>

                <!-- Calendar Legend -->
                <div class="flex flex-wrap gap-4 mb-4 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                        <span>Gaida apstiprinājumu</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                        <span>Apstiprināts</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-400"></span>
                        <span>Atcelts</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-blue-500"></span>
                        <span>🇱🇻 Valsts svētki</span>
                    </div>
                </div>

                <div id="bookings-loading" class="text-center py-12 text-gray-500">
                    Ielādē ierakstus...
                </div>

                <!-- Calendar Grid -->
                <div id="calendar-container" class="hidden">
                    <div class="bg-white rounded-lg shadow overflow-hidden">
                        <!-- Calendar Header - Days of week -->
                        <div class="grid grid-cols-7 bg-gray-50 border-b">
                            <div class="p-2 text-center text-sm font-medium text-gray-600">Pr</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600">Ot</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600">Tr</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600">Ce</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600">Pk</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600 text-red-500">Se</div>
                            <div class="p-2 text-center text-sm font-medium text-gray-600 text-red-500">Sv</div>
                        </div>
                        <!-- Calendar Body -->
                        <div id="calendar-grid" class="grid grid-cols-7">
                            <!-- Calendar days will be inserted here -->
                        </div>
                    </div>
                </div>

                <!-- Selected Day Details -->
                <div id="day-details" class="hidden mt-6">
                    <div class="bg-white rounded-lg shadow p-4">
                        <div class="flex justify-between items-center mb-4">
                            <h3 id="day-details-title" class="font-semibold text-lg"></h3>
                            <button id="close-day-details" class="text-gray-400 hover:text-gray-600">✕</button>
                        </div>
                        <div id="day-bookings-list" class="space-y-3">
                            <!-- Day's bookings will be listed here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Availability Tab -->
            <div id="tab-availability" class="tab-content hidden">
                <div class="mb-6">
                    <h2 class="text-lg font-semibold mb-4">Darba laiki</h2>
                    <p class="text-sm text-gray-600 mb-4">Iestatiet pieejamos laikus katrai nedēļas dienai</p>
                </div>

                <div class="bg-white rounded-lg shadow p-6">
                    <div id="availability-form" class="space-y-4">
                        <!-- Days will be generated here -->
                    </div>
                    
                    <div class="mt-6 pt-4 border-t">
                        <button id="save-availability" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/90">
                            💾 Saglabāt
                        </button>
                    </div>
                </div>

                <div class="mt-8">
                    <h2 class="text-lg font-semibold mb-4">Bloķētie datumi</h2>
                    <p class="text-sm text-gray-600 mb-4">Pievienojiet datumus, kad nepieņemat klientus (atvaļinājums, svētki u.c.)</p>
                    
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex gap-4 mb-4">
                            <input type="date" id="block-date" class="px-3 py-2 border rounded-lg">
                            <input type="text" id="block-reason" placeholder="Iemesls (piem. Atvaļinājums)" class="flex-1 px-3 py-2 border rounded-lg">
                            <button id="add-blocked-date" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200">
                                + Pievienot
                            </button>
                        </div>
                        <div id="blocked-dates-list" class="space-y-2">
                            <!-- Blocked dates will be listed here -->
                        </div>
                    </div>
                </div>

                <div class="mt-8">
                    <h2 class="text-lg font-semibold mb-4">🇱🇻 Latvijas valsts svētki</h2>
                    <p class="text-sm text-gray-600 mb-4">Šajos datumos automātiski netiek pieņemti ieraksti</p>
                    
                    <div class="bg-white rounded-lg shadow p-6">
                        <div class="flex gap-4 mb-4">
                            <select id="holiday-year" class="px-3 py-2 border rounded-lg">
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                            </select>
                            <button id="refresh-holidays" class="px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200">
                                🔄 Atjaunot
                            </button>
                        </div>
                        <div id="holidays-list" class="grid gap-2 md:grid-cols-2">
                            <!-- Holidays will be listed here -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="tab-settings" class="tab-content hidden">
                <h2 class="text-lg font-semibold mb-6">Vietnes iestatījumi</h2>

                <div class="grid gap-6 md:grid-cols-2">
                    <!-- Prices -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <h3 class="font-medium mb-4">💰 Cenas</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Pirmreizējā konsultācija (€)</label>
                                <input type="number" id="price-initial" class="w-full px-3 py-2 border rounded-lg" value="65">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Atkārtota konsultācija (€)</label>
                                <input type="number" id="price-followup" class="w-full px-3 py-2 border rounded-lg" value="45">
                            </div>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <h3 class="font-medium mb-4">📞 Kontaktinformācija</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">E-pasts</label>
                                <input type="email" id="contact-email" class="w-full px-3 py-2 border rounded-lg" value="sofija@nutrition.lv">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Telefons</label>
                                <input type="tel" id="contact-phone" class="w-full px-3 py-2 border rounded-lg" value="+371 20000000">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Adrese</label>
                                <input type="text" id="contact-address" class="w-full px-3 py-2 border rounded-lg" value="Rīga, Latvija">
                            </div>
                        </div>
                    </div>

                    <!-- Consultation Duration -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <h3 class="font-medium mb-4">⏱️ Konsultāciju ilgums</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Pirmreizējā (minūtes)</label>
                                <input type="number" id="duration-initial" class="w-full px-3 py-2 border rounded-lg" value="60">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Atkārtota (minūtes)</label>
                                <input type="number" id="duration-followup" class="w-full px-3 py-2 border rounded-lg" value="30">
                            </div>
                        </div>
                    </div>

                    <!-- Payment Info -->
                    <div class="bg-white rounded-lg shadow p-6">
                        <h3 class="font-medium mb-4">🏦 Maksājumu informācija</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">Bankas nosaukums</label>
                                <input type="text" id="bank-name" class="w-full px-3 py-2 border rounded-lg" value="Swedbank">
                            </div>
                            <div>
                                <label class="block text-sm text-gray-600 mb-1">IBAN</label>
                                <input type="text" id="bank-iban" class="w-full px-3 py-2 border rounded-lg" value="LV00HABA0000000000000">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-6">
                    <button id="save-settings" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary/90">
                        💾 Saglabāt iestatījumus
                    </button>
                </div>
            </div>
        </main>
    </div>

    <style>
        :root {
            --color-primary: #d4a574;
        }
        .bg-primary { background-color: var(--color-primary); }
        .text-primary { color: var(--color-primary); }
        .border-primary { border-color: var(--color-primary); }
        .hover\:bg-primary\/90:hover { background-color: rgba(212, 165, 116, 0.9); }
    </style>

    <script is:inline>
    (function() {
        // API base URL - use external Azure Functions App
        const API_BASE = 'https://sofija-nutrition-api.azurewebsites.net/api';
        
        // Calendar state
        let currentDate = new Date();
        let allBookings = [];
        let holidays = {};
        
        // Latvian month names
        const monthNames = [
            'Janvāris', 'Februāris', 'Marts', 'Aprīlis', 'Maijs', 'Jūnijs',
            'Jūlijs', 'Augusts', 'Septembris', 'Oktobris', 'Novembris', 'Decembris'
        ];
        
        // Get user info
        fetch('/.auth/me')
            .then(r => r.json())
            .then(data => {
                if (data.clientPrincipal) {
                    const user = data.clientPrincipal;
                    document.getElementById('user-info').textContent = 
                        `${user.userDetails || user.userId} (${user.identityProvider})`;
                }
            })
            .catch(() => {});

        // Tab switching
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabId = btn.dataset.tab;
                
                tabBtns.forEach(b => {
                    b.classList.remove('active', 'border-primary', 'text-primary');
                    b.classList.add('border-transparent', 'text-gray-500');
                });
                btn.classList.add('active', 'border-primary', 'text-primary');
                btn.classList.remove('border-transparent', 'text-gray-500');

                tabContents.forEach(content => {
                    content.classList.add('hidden');
                });
                document.getElementById('tab-' + tabId).classList.remove('hidden');

                // Load data for tab
                if (tabId === 'bookings') loadCalendar();
                if (tabId === 'availability') loadAvailability();
                if (tabId === 'settings') loadSettings();
            });
        });

        // Calendar navigation
        document.getElementById('prev-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            loadCalendar();
        });
        
        document.getElementById('next-month').addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            loadCalendar();
        });
        
        document.getElementById('today-btn').addEventListener('click', () => {
            currentDate = new Date();
            loadCalendar();
        });
        
        document.getElementById('refresh-bookings').addEventListener('click', loadCalendar);
        
        document.getElementById('close-day-details').addEventListener('click', () => {
            document.getElementById('day-details').classList.add('hidden');
        });

        // Load calendar with bookings and holidays
        async function loadCalendar() {
            const loading = document.getElementById('bookings-loading');
            const container = document.getElementById('calendar-container');
            
            loading.classList.remove('hidden');
            container.classList.add('hidden');
            document.getElementById('day-details').classList.add('hidden');
            
            // Update month display
            document.getElementById('current-month').textContent = 
                `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;

            try {
                // Fetch bookings and holidays in parallel
                const year = currentDate.getFullYear();
                const [bookingsRes, holidaysRes] = await Promise.all([
                    fetch(API_BASE + '/dashboard/bookings'),
                    fetch(API_BASE + '/holidays?year=' + year)
                ]);
                
                const bookingsData = await bookingsRes.json();
                const holidaysData = await holidaysRes.json();
                
                allBookings = bookingsData.bookings || [];
                
                // Convert holidays to a map for easy lookup
                holidays = {};
                if (holidaysData.holidays) {
                    holidaysData.holidays.forEach(h => {
                        holidays[h.date] = h.name;
                    });
                }
                
                renderCalendar();
                
                loading.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (error) {
                loading.textContent = 'Kļūda ielādējot datus: ' + error.message;
            }
        }
        
        function renderCalendar() {
            const grid = document.getElementById('calendar-grid');
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            
            // Get first day of month and number of days
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();
            
            // Get starting day (0 = Sunday, convert to Monday = 0)
            let startDay = firstDay.getDay() - 1;
            if (startDay < 0) startDay = 6;
            
            // Group bookings by date
            const bookingsByDate = {};
            allBookings.forEach(b => {
                if (!bookingsByDate[b.date]) bookingsByDate[b.date] = [];
                bookingsByDate[b.date].push(b);
            });
            
            // Today's date for highlighting
            const today = new Date();
            const todayStr = today.toISOString().split('T')[0];
            
            let html = '';
            
            // Empty cells for days before month starts
            for (let i = 0; i < startDay; i++) {
                html += '<div class="min-h-[100px] bg-gray-50 border-b border-r"></div>';
            }
            
            // Days of the month
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isToday = dateStr === todayStr;
                const isHoliday = holidays[dateStr];
                const dayBookings = bookingsByDate[dateStr] || [];
                const dayOfWeek = (startDay + day - 1) % 7;
                const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;
                
                // Count by status
                const pending = dayBookings.filter(b => b.status === 'pending').length;
                const confirmed = dayBookings.filter(b => b.status === 'confirmed').length;
                const cancelled = dayBookings.filter(b => b.status === 'cancelled').length;
                
                let bgClass = 'bg-white';
                if (isHoliday) bgClass = 'bg-blue-50';
                else if (isWeekend) bgClass = 'bg-gray-50';
                
                html += `
                    <div class="min-h-[100px] ${bgClass} border-b border-r p-1 cursor-pointer hover:bg-gray-100 transition-colors"
                         onclick="showDayDetails('${dateStr}')">
                        <div class="flex justify-between items-start">
                            <span class="text-sm font-medium ${isToday ? 'bg-primary text-white rounded-full w-6 h-6 flex items-center justify-center' : ''} ${isWeekend ? 'text-red-500' : ''}">
                                ${day}
                            </span>
                            ${isHoliday ? '<span class="text-xs">🇱🇻</span>' : ''}
                        </div>
                        ${isHoliday ? `<div class="text-xs text-blue-600 mt-1 leading-tight">${isHoliday}</div>` : ''}
                        ${dayBookings.length > 0 ? `
                            <div class="mt-1 space-y-1">
                                ${pending > 0 ? `<div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-400"></span><span class="text-xs">${pending} gaida</span></div>` : ''}
                                ${confirmed > 0 ? `<div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-500"></span><span class="text-xs">${confirmed} apst.</span></div>` : ''}
                                ${cancelled > 0 ? `<div class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400"></span><span class="text-xs">${cancelled} atc.</span></div>` : ''}
                            </div>
                        ` : ''}
                    </div>
                `;
            }
            
            // Empty cells to complete the grid
            const totalCells = startDay + daysInMonth;
            const remainingCells = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
            for (let i = 0; i < remainingCells; i++) {
                html += '<div class="min-h-[100px] bg-gray-50 border-b border-r"></div>';
            }
            
            grid.innerHTML = html;
        }
        
        window.showDayDetails = function(dateStr) {
            const details = document.getElementById('day-details');
            const title = document.getElementById('day-details-title');
            const list = document.getElementById('day-bookings-list');
            
            // Format date for display
            const date = new Date(dateStr);
            const dayNames = ['Svētdiena', 'Pirmdiena', 'Otrdiena', 'Trešdiena', 'Ceturtdiena', 'Piektdiena', 'Sestdiena'];
            title.textContent = `${dayNames[date.getDay()]}, ${dateStr}`;
            
            // Check if holiday
            const holidayName = holidays[dateStr];
            
            // Filter bookings for this day
            const dayBookings = allBookings.filter(b => b.date === dateStr);
            
            let html = '';
            
            if (holidayName) {
                html += `<div class="p-3 bg-blue-50 rounded-lg border border-blue-200 mb-3">
                    <span class="text-blue-700">🇱🇻 <strong>Valsts svētki:</strong> ${holidayName}</span>
                </div>`;
            }
            
            if (dayBookings.length === 0) {
                html += '<p class="text-gray-500 text-center py-4">Nav ierakstu šajā dienā</p>';
            } else {
                dayBookings.sort((a, b) => a.time.localeCompare(b.time));
                
                html += dayBookings.map(b => `
                    <div class="bg-gray-50 rounded-lg p-3 border-l-4 ${getStatusBorderClass(b.status)}">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <span class="font-medium">${b.name}</span>
                                <span class="text-xs px-2 py-0.5 rounded ml-2 ${getStatusClass(b.status)}">${getStatusText(b.status)}</span>
                            </div>
                            <span class="text-lg font-semibold">${b.time}</span>
                        </div>
                        <div class="text-sm text-gray-600 space-y-1">
                            <div>📋 ${b.service === 'initial' ? 'Pirmreizējā konsultācija' : 'Atkārtota konsultācija'}</div>
                            <div>${b.consultationFormat === 'online' ? '💻 Online' : '🏥 Klātienē'}</div>
                            <div>✉️ ${b.email}</div>
                            ${b.phone ? `<div>📞 ${b.phone}</div>` : ''}
                            ${b.notes ? `<div>📝 ${b.notes}</div>` : ''}
                            <div>💰 €${b.price}</div>
                        </div>
                        <div class="flex gap-2 mt-3 pt-3 border-t">
                            ${b.status === 'pending' ? `
                                <button onclick="confirmBooking('${b.id}')" class="px-3 py-1 bg-green-100 text-green-700 rounded text-sm hover:bg-green-200">
                                    ✓ Apstiprināt
                                </button>
                            ` : ''}
                            ${b.status !== 'cancelled' ? `
                                <button onclick="cancelBooking('${b.id}')" class="px-3 py-1 bg-red-100 text-red-700 rounded text-sm hover:bg-red-200">
                                    ✕ Atcelt
                                </button>
                            ` : ''}
                        </div>
                    </div>
                `).join('');
            }
            
            list.innerHTML = html;
            details.classList.remove('hidden');
            details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        function getStatusClass(status) {
            switch(status) {
                case 'confirmed': return 'bg-green-100 text-green-700';
                case 'pending': return 'bg-yellow-100 text-yellow-700';
                case 'cancelled': return 'bg-red-100 text-red-700';
                default: return 'bg-gray-100 text-gray-700';
            }
        }
        
        function getStatusBorderClass(status) {
            switch(status) {
                case 'confirmed': return 'border-green-500';
                case 'pending': return 'border-yellow-400';
                case 'cancelled': return 'border-red-400';
                default: return 'border-gray-300';
            }
        }

        function getStatusText(status) {
            switch(status) {
                case 'confirmed': return 'Apstiprināts';
                case 'pending': return 'Gaida';
                case 'cancelled': return 'Atcelts';
                default: return status;
            }
        }

        window.confirmBooking = async function(id) {
            if (!confirm('Apstiprināt šo ierakstu?')) return;
            try {
                await fetch(API_BASE + '/dashboard/bookings/' + id, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'confirmed' })
                });
                loadCalendar();
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        };

        window.cancelBooking = async function(id) {
            if (!confirm('Atcelt šo ierakstu?')) return;
            try {
                await fetch(API_BASE + '/dashboard/bookings/' + id, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: 'cancelled' })
                });
                loadCalendar();
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        };

        // Availability
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        const dayNames = {
            monday: 'Pirmdiena',
            tuesday: 'Otrdiena', 
            wednesday: 'Trešdiena',
            thursday: 'Ceturtdiena',
            friday: 'Piektdiena',
            saturday: 'Sestdiena',
            sunday: 'Svētdiena'
        };

        function loadAvailability() {
            const form = document.getElementById('availability-form');
            
            form.innerHTML = days.map(day => `
                <div class="flex items-center gap-4 py-3 border-b last:border-0">
                    <div class="w-32 font-medium">${dayNames[day]}</div>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" id="day-${day}-enabled" class="w-4 h-4" checked>
                        <span class="text-sm text-gray-600">Aktīva</span>
                    </label>
                    <div class="flex items-center gap-2">
                        <input type="time" id="day-${day}-start" value="09:00" class="px-2 py-1 border rounded">
                        <span>-</span>
                        <input type="time" id="day-${day}-end" value="17:00" class="px-2 py-1 border rounded">
                    </div>
                </div>
            `).join('');

            // Disable weekends by default
            document.getElementById('day-saturday-enabled').checked = false;
            document.getElementById('day-sunday-enabled').checked = false;

            // Try to load saved availability
            fetch(API_BASE + '/dashboard/availability')
                .then(r => r.json())
                .then(data => {
                    if (data.schedule) {
                        Object.entries(data.schedule).forEach(([day, config]) => {
                            const checkbox = document.getElementById(`day-${day}-enabled`);
                            const startInput = document.getElementById(`day-${day}-start`);
                            const endInput = document.getElementById(`day-${day}-end`);
                            if (checkbox) checkbox.checked = config.enabled;
                            if (startInput) startInput.value = config.start || '09:00';
                            if (endInput) endInput.value = config.end || '17:00';
                        });
                    }
                    if (data.blockedDates) {
                        renderBlockedDates(data.blockedDates);
                    }
                })
                .catch(() => {});
            
            // Load holidays
            loadHolidays();
        }

        function renderBlockedDates(dates) {
            const list = document.getElementById('blocked-dates-list');
            if (!dates || dates.length === 0) {
                list.innerHTML = '<p class="text-gray-500 text-sm">Nav bloķētu datumu</p>';
                return;
            }
            list.innerHTML = dates.map(d => `
                <div class="flex items-center justify-between p-2 bg-red-50 rounded">
                    <span>${d.date} ${d.reason ? '- ' + d.reason : ''}</span>
                    <button onclick="removeBlockedDate('${d.date}')" class="text-red-600 hover:text-red-800">✕</button>
                </div>
            `).join('');
        }

        document.getElementById('save-availability').addEventListener('click', async () => {
            const schedule = {};
            days.forEach(day => {
                schedule[day] = {
                    enabled: document.getElementById(`day-${day}-enabled`).checked,
                    start: document.getElementById(`day-${day}-start`).value,
                    end: document.getElementById(`day-${day}-end`).value
                };
            });

            try {
                await fetch(API_BASE + '/dashboard/availability', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ schedule })
                });
                alert('Pieejamība saglabāta!');
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        });

        document.getElementById('add-blocked-date').addEventListener('click', async () => {
            const date = document.getElementById('block-date').value;
            const reason = document.getElementById('block-reason').value;
            if (!date) return alert('Izvēlieties datumu');

            try {
                await fetch(API_BASE + '/dashboard/availability/block', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date, reason })
                });
                loadAvailability();
                document.getElementById('block-date').value = '';
                document.getElementById('block-reason').value = '';
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        });

        window.removeBlockedDate = async function(date) {
            try {
                await fetch(API_BASE + '/dashboard/availability/block', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date })
                });
                loadAvailability();
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        };

        // Settings
        function loadSettings() {
            fetch(API_BASE + '/dashboard/settings')
                .then(r => r.json())
                .then(data => {
                    if (data.prices) {
                        document.getElementById('price-initial').value = data.prices.initial || 65;
                        document.getElementById('price-followup').value = data.prices.followup || 45;
                    }
                    if (data.contact) {
                        document.getElementById('contact-email').value = data.contact.email || '';
                        document.getElementById('contact-phone').value = data.contact.phone || '';
                        document.getElementById('contact-address').value = data.contact.address || '';
                    }
                    if (data.duration) {
                        document.getElementById('duration-initial').value = data.duration.initial || 60;
                        document.getElementById('duration-followup').value = data.duration.followup || 30;
                    }
                    if (data.bank) {
                        document.getElementById('bank-name').value = data.bank.name || '';
                        document.getElementById('bank-iban').value = data.bank.iban || '';
                    }
                })
                .catch(() => {});
        }

        document.getElementById('save-settings').addEventListener('click', async () => {
            const settings = {
                prices: {
                    initial: parseInt(document.getElementById('price-initial').value),
                    followup: parseInt(document.getElementById('price-followup').value)
                },
                contact: {
                    email: document.getElementById('contact-email').value,
                    phone: document.getElementById('contact-phone').value,
                    address: document.getElementById('contact-address').value
                },
                duration: {
                    initial: parseInt(document.getElementById('duration-initial').value),
                    followup: parseInt(document.getElementById('duration-followup').value)
                },
                bank: {
                    name: document.getElementById('bank-name').value,
                    iban: document.getElementById('bank-iban').value
                }
            };

            try {
                await fetch(API_BASE + '/dashboard/settings', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(settings)
                });
                alert('Iestatījumi saglabāti!');
            } catch (e) {
                alert('Kļūda: ' + e.message);
            }
        });

        // Initial load
        loadCalendar();
        
        // Holidays
        async function loadHolidays() {
            const year = document.getElementById('holiday-year').value;
            const list = document.getElementById('holidays-list');
            
            try {
                const response = await fetch(API_BASE + '/holidays?year=' + year);
                const data = await response.json();
                
                if (data.holidays && data.holidays.length > 0) {
                    list.innerHTML = data.holidays.map(h => `
                        <div class="flex items-center justify-between p-2 bg-blue-50 rounded">
                            <span class="font-medium">${h.date}</span>
                            <span class="text-gray-600">${h.name}</span>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<p class="text-gray-500">Nav svētku šajā gadā</p>';
                }
            } catch (e) {
                list.innerHTML = '<p class="text-red-500">Kļūda ielādējot svētkus</p>';
            }
        }
        
        document.getElementById('holiday-year').addEventListener('change', loadHolidays);
        document.getElementById('refresh-holidays').addEventListener('click', loadHolidays);
    })();
    </script>
</Layout>
