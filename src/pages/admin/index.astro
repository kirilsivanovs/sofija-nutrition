      }
      .calendar-cell {
        min-height: 140px;
        padding: 14px;
      }
      .calendar-cell .day-number {
        font-size: 22px;
      }
      .calendar-grid {
        min-height: 700px;
      }
      .settings-grid {
        grid-template-columns: repeat(2, 1fr);
      }
