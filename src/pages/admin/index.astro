---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/admin/AdminHeader.astro';
import CalendarView from '../../components/admin/CalendarView.astro';
import AvailabilityTab from '../../components/admin/AvailabilityTab.astro';
import SettingsTab from '../../components/admin/SettingsTab.astro';
import PatientList from '../../components/admin/PatientList/PatientList.astro';
import MealsTab from '../../components/admin/MealsTab/MealsTab.astro';
import DataTab from '../../components/admin/DataTab/DataTab.astro';
import ScrollToTop from '../../components/common/ScrollToTop.astro';
import '../../styles/admin.css';
---

<Layout title="Sofija Nutrition - Admin Panel">
  <!-- Unauthorized Access Message (shown if not admin) -->
  <div id="unauthorized-page" class="unauthorized-wrapper" style="display: none;">
    <div class="unauthorized-container">
      <div class="unauthorized-icon">
        <svg
          width="80"
          height="80"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m15 9-6 6"></path>
          <path d="m9 9 6 6"></path>
        </svg>
      </div>
      <h1 class="unauthorized-title">Piekļuve liegta</h1>
      <p class="unauthorized-message">
        Jūsu e-pasta adrese nav autorizēta administratora piekļuvei.
      </p>
      <p class="unauthorized-email" id="unauthorized-email"></p>
      <a href="/" class="btn-home">Atgriezties uz sākumlapu</a>
    </div>
  </div>

  <div class="admin-wrapper" id="admin-content" style="display: none;">
    <AdminHeader />

    <!-- Main Content -->
    <main class="admin-main">
      <!-- Bookings Tab -->
      <div id="tab-bookings" class="admin-content">
        <CalendarView />
      </div>

      <!-- Availability Tab -->
      <div id="tab-availability" class="admin-content hidden">
        <AvailabilityTab />
      </div>

      <!-- Settings Tab -->
      <div id="tab-settings" class="admin-content hidden">
        <SettingsTab />
      </div>

      <!-- Meals Tab -->
      <div id="tab-meals" class="admin-content hidden">
        <MealsTab />
      </div>

      <!-- Data Tab -->
      <div id="tab-data" class="admin-content hidden">
        <DataTab />
      </div>
    </main>

    <!-- Date Picker Popup -->
    <div id="date-picker" class="date-picker-popup hidden">
      <div class="date-picker-header">
        <button type="button" class="date-picker-nav" id="picker-prev-month">
          <i class="ph ph-caret-left"></i>
        </button>
        <span id="picker-month-year" class="date-picker-title"></span>
        <button type="button" class="date-picker-nav" id="picker-next-month">
          <i class="ph ph-caret-right"></i>
        </button>
      </div>
      <div class="date-picker-days">
        <div class="date-picker-day-name">Pr</div>
        <div class="date-picker-day-name">Ot</div>
        <div class="date-picker-day-name">Tr</div>
        <div class="date-picker-day-name">Ce</div>
        <div class="date-picker-day-name">Pk</div>
        <div class="date-picker-day-name">Se</div>
        <div class="date-picker-day-name">Sv</div>
      </div>
      <div id="picker-dates" class="date-picker-dates"></div>
    </div>

    <!-- Meals Day Details Modal -->
    <div id="meals-day-modal" class="modal-overlay" style="display: none;">
      <div class="modal-container meals-modal">
        <div class="modal-header">
          <h3 id="meals-modal-title">Dienasrāmata</h3>
          <button onclick="closeMealsModal()" class="modal-close">
            <i class="ph ph-x"></i>
          </button>
        </div>
        <div class="modal-body meals-modal-body">
          <div id="meals-modal-summary" class="meals-day-summary-total"></div>
          <div id="meals-modal-content" class="meals-modal-content"></div>
        </div>
      </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>
  </div>

  <script>
    import {
      formatDate,
      formatDateReverse,
      formatTime,
      formatDateISO,
      initializeDateInputs,
    } from '../../utils/admin/formatters';
    import { showToast, showConfirm } from '../../utils/admin/notifications';
    import { initDatePicker } from '../../utils/admin/datePicker';
    import { PatientService } from '../../services/admin/PatientService';
    import { PatientListController } from '../../components/admin/PatientList/PatientListController';
    import { MealsTabController } from '../../components/admin/MealsTab/MealsTab';
    import { DataTabController } from '../../components/admin/DataTab/DataTab';
    import { CalendarViewController } from '../../components/admin/CalendarViewController';
    import { AvailabilityController } from '../../components/admin/AvailabilityController';
    import { SettingsController } from '../../components/admin/SettingsController';

    // Type declarations for global window functions
    declare global {
      interface Window {
        getAuthHeaders: () => Record<string, string>;
        showDayDetails: (dateStr: string) => void;
        confirmBooking: (id: string) => Promise<void>;
        cancelBooking: (id: string) => Promise<void>;
        removeVacation: (id: string) => Promise<void>;
        removeBlockedDate: (date: string) => Promise<void>;
        deleteEntity: (partitionKey: string, rowKey: string) => Promise<void>;
      }
    }

    interface VacationPeriod {
      id?: string;
      startDate: string;
      endDate: string;
    }

    interface MealItem {
      name: string;
      weight: number;
      calories?: number;
      protein?: number;
      fat?: number;
      carbs?: number;
    }

    interface Meal {
      id?: string;
      userId?: string;
      createdAt: string;
      mealType: 'breakfast' | 'lunch' | 'dinner' | 'snack';
      totalCalories: number;
      totalProtein: number;
      totalFat: number;
      totalCarbs: number;
      items?: MealItem[];
    }

    interface DayData {
      totalCalories: number;
      totalProtein: number;
      totalFat: number;
      totalCarbs: number;
      meals: Meal[];
      mealsByType: {
        breakfast: Meal[];
        lunch: Meal[];
        dinner: Meal[];
        snack: Meal[];
      };
    }

    const API_BASE =
      window.location.hostname === 'localhost' ? 'http://localhost:7071/api' : '/api';

    // E2E Test Token Support
    // Если в URL есть ?e2e_token=xxx, проверяем его и сохраняем
    const urlParams = new URLSearchParams(window.location.search);
    const e2eToken = urlParams.get('e2e_token') || sessionStorage.getItem('e2e_token');

    if (e2eToken) {
      sessionStorage.setItem('e2e_token', e2eToken);
      // Убираем токен из URL для безопасности
      if (urlParams.has('e2e_token')) {
        urlParams.delete('e2e_token');
        const newUrl =
          window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
        window.history.replaceState({}, '', newUrl);
      }
    }

    // Функция для добавления токена к API запросам
    window.getAuthHeaders = function (): Record<string, string> {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      const token = sessionStorage.getItem('e2e_token');
      if (token) {
        headers['X-E2E-Token'] = token;
      }
      return headers;
    };

    // Initialize date inputs and date picker on page load
    initializeDateInputs();
    initDatePicker();

    // Проверяем авторизацию - Microsoft OAuth или E2E Token
    const e2eTokenStored = sessionStorage.getItem('e2e_token');
    if (e2eTokenStored) {
      // E2E режим - проверяем токен через API
      fetch(API_BASE + '/test/auth', {
        headers: { 'X-E2E-Token': e2eTokenStored },
      })
        .then((r) => r.json())
        .then((data) => {
          if (data.clientPrincipal) {
            const userInfo = document.getElementById('user-info');
            if (userInfo) userInfo.textContent = data.clientPrincipal.userDetails + ' (E2E)';
          }
        })
        .catch(() => {
          // Токен невалиден - очищаем
          sessionStorage.removeItem('e2e_token');
        });
    } else {
      // Стандартная Microsoft авторизация
      fetch('/.auth/me')
        .then((r) => r.json())
        .then((data) => {
          if (data.clientPrincipal) {
            const userInfo = document.getElementById('user-info');
            if (userInfo)
              userInfo.textContent =
                data.clientPrincipal.userDetails || data.clientPrincipal.userId;
          }
        })
        .catch(() => {});
    }

    const tabBtns = document.querySelectorAll('.admin-tab');
    const mobileSelect = document.getElementById('mobile-tab-selector') as HTMLSelectElement | null;

    // Data loading triggered by AdminHeader's tabChanged event
    function loadTabData(tabId: string) {
      if (tabId === 'bookings') calendarController.loadCalendar();
      if (tabId === 'availability') availabilityController.loadAvailability();
      if (tabId === 'settings') settingsController.loadSettings();
      if (tabId === 'meals') patientController.loadPatients();
      if (tabId === 'data') dataTabController.loadTableData();
    }

    document.addEventListener('tabChanged', (e: Event) => {
      const tabId = (e as CustomEvent).detail?.tabId;
      if (tabId) loadTabData(tabId);
    });

    if (mobileSelect) {
      mobileSelect.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        loadTabData(target.value);
      });
    }

    // Initialize Patient Service and Controller
    const patientService = new PatientService(API_BASE);
    const patientController = new PatientListController(patientService);

    // Initialize MealsTab Controller
    const mealsTabController = new MealsTabController(
      {
        patientController,
        onShowToast: showToast,
      },
      API_BASE
    );

    // Initialize Patient List Controller
    patientController.init({
      searchInput: document.getElementById('patients-search-input') as HTMLInputElement | null,
      addInput: document.getElementById('patients-add-input') as HTMLInputElement | null,
      addButton: document.getElementById('patients-add-btn') as HTMLButtonElement | null,
      listContainer: document.getElementById('patients-list'),
      emptyContainer: document.getElementById('patients-empty'),
      onPatientSelect: (patient) => {
        const displayName = patientService.getDisplayName(patient);
        mealsTabController.setSelectedPatientName(displayName);
        mealsTabController.loadMealsForMonth();
      },
      onAccessUpdate: () => {
        // Access updated successfully
      },
      onShowToast: showToast,
      onShowConfirm: showConfirm,
    });

    // Initialize MealsTab after Patient Controller
    mealsTabController.init();

    // Initialize DataTab Controller
    const dataTabController = new DataTabController(
      {
        onShowToast: showToast,
        onShowConfirm: showConfirm,
      },
      API_BASE
    );
    dataTabController.init();

    // Initialize Calendar View Controller
    const calendarController = new CalendarViewController(API_BASE, showToast, showConfirm);
    calendarController.init();

    // Initialize Availability Controller
    const availabilityController = new AvailabilityController(API_BASE);
    availabilityController.init();

    // Initialize Settings Controller
    const settingsController = new SettingsController(API_BASE, showToast);
    settingsController.init();
  </script>

  <!-- Admin Access Check -->
  <script>
    // Check if user is authorized admin via backend API
    async function checkAdminAccess() {
      try {
        // First check if user is authenticated at all
        const authResponse = await fetch('/.auth/me');
        const authData = await authResponse.json();

        if (!authData.clientPrincipal) {
          // Not authenticated - redirect to login
          window.location.href = '/.auth/login/aad?post_login_redirect_uri=/admin';
          return;
        }

        const userEmail = authData.clientPrincipal.userDetails;

        // Verify admin access via backend (uses ADMIN_EMAILS env var)
        const adminCheck = await fetch('/api/dashboard/me');

        if (adminCheck.ok) {
          // Show admin content
          const adminContent = document.getElementById('admin-content');
          if (adminContent) adminContent.style.display = 'block';
        } else {
          // Show unauthorized page
          const unauthorizedPage = document.getElementById('unauthorized-page');
          const emailDisplay = document.getElementById('unauthorized-email');
          if (unauthorizedPage) unauthorizedPage.style.display = 'flex';
          if (emailDisplay) emailDisplay.textContent = userEmail;
        }
      } catch (error) {
        console.error('Admin access check failed:', error);
        // On error, show unauthorized page
        const unauthorizedPage = document.getElementById('unauthorized-page');
        if (unauthorizedPage) unauthorizedPage.style.display = 'flex';
      }
    }

    // Run check when page loads
    checkAdminAccess();
  </script>

  <!-- Scroll to Top Button -->
  <ScrollToTop />
</Layout>
