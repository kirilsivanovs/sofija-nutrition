      border-top: 1px solid rgba(255, 255, 255, 0.3);
    }

    .meals-summary-label {
      font-size: 14px;
      opacity: 0.9;
    }

    .meals-summary-value {
      font-size: 20px;
      font-weight: 700;
    }

    .meals-modal-content {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .meal-type-section {
      background: var(--color-white);
      border: 2px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .meal-type-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .meal-type-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
      font-weight: 700;
      color: var(--color-primary);
    }

    .meal-type-summary {
      font-size: 14px;
      color: var(--color-muted);
    }

    .meal-entry {
      background: var(--color-cream);
      padding: 12px;
      border-radius: var(--radius-sm);
      margin-bottom: 8px;
    }

    .meal-entry:last-child {
      margin-bottom: 0;
    }

    .meal-entry-time {
      font-size: 12px;
      color: var(--color-muted);
      margin-bottom: 6px;
    }

    .meal-entry-items {
      font-size: 14px;
      color: var(--color-text);
      margin-bottom: 8px;
    }

    .meal-entry-macros {
      display: flex;
      gap: 12px;
      font-size: 12px;
      color: var(--color-text-light);
    }

    @media (max-width: 768px) {
      .modal-container {
        max-width: 100%;
        margin: 0;
        border-radius: 16px 16px 0 0;
