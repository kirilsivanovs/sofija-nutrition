---
import Layout from '../../layouts/Layout.astro';
import AdminHeader from '../../components/admin/AdminHeader.astro';
import CalendarView from '../../components/admin/CalendarView.astro';
import AvailabilityTab from '../../components/admin/AvailabilityTab.astro';
import SettingsTab from '../../components/admin/SettingsTab.astro';
---

<Layout title="Sofija Nutrition - Admin Panel">
    <div class="admin-wrapper">
        <AdminHeader />

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Bookings Tab -->
            <div id="tab-bookings" class="admin-content">
                <CalendarView />
            </div>

            <!-- Availability Tab -->
            <div id="tab-availability" class="admin-content hidden">
                <AvailabilityTab />
            </div>

            <!-- Settings Tab -->
            <div id="tab-settings" class="admin-content hidden">
                <SettingsTab />
            </div>

            <!-- Data Tab -->
            <div id="tab-data" class="admin-content hidden">
                <div class="content-header">
                    <h2 class="content-title">Azure Table Storage</h2>
                    <div class="data-controls">
                        <select id="table-select" class="input-field">
                            <option value="bookings">bookings (ieraksti)</option>
                        </select>
                        <button id="refresh-table" class="btn-secondary">
                            <i class="ph ph-arrows-clockwise"></i>
                        </button>
                        <button id="export-csv" class="btn-info">
                            <i class="ph ph-download-simple"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>

                <!-- Filters and Batch Actions -->
                <div id="table-filters" class="card hidden" style="margin-bottom: 20px; padding: 20px;">
                    <div style="display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-end;">
                        <div style="flex: 1; min-width: 200px;">
                            <label class="input-label">Meklēt</label>
                            <input type="text" id="table-search" class="input-field" placeholder="Meklēt visos laukos...">
                        </div>
                        <div style="min-width: 150px;">
                            <label class="input-label">Statuss</label>
                            <select id="filter-status" class="input-field">
                                <option value="">Visi</option>
                                <option value="confirmed">Apstiprināts</option>
                                <option value="pending">Gaida</option>
                                <option value="cancelled">Atcelts</option>
                            </select>
                        </div>
                        <div style="min-width: 150px;">
                            <label class="input-label">Sākuma datums</label>
                            <input type="text" id="filter-date-from" class="input-field date-input" placeholder="dd/mm/yyyy">
                        </div>
                        <div style="min-width: 150px;">
                            <label class="input-label">Beigu datums</label>
                            <input type="text" id="filter-date-to" class="input-field date-input" placeholder="dd/mm/yyyy">
                        </div>
                        <button id="clear-filters" class="btn-secondary">
                            <i class="ph ph-x"></i>
                            <span>Notīrīt</span>
                        </button>
                    </div>
                    
                    <div id="batch-actions" class="hidden" style="margin-top: 20px; padding-top: 20px; border-top: 2px solid #e5e7eb;">
                        <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                            <span style="font-weight: 600; color: var(--color-primary);">
                                <span id="selected-count">0</span> izvēlēti
                            </span>
                            <button id="batch-delete" class="btn-danger btn-sm">
                                <i class="ph ph-trash"></i>
                                <span>Dzēst izvēlētos</span>
                            </button>
                            <button id="batch-export" class="btn-info btn-sm">
                                <i class="ph ph-download-simple"></i>
                                <span>Eksportēt izvēlētos</span>
                            </button>
                            <button id="deselect-all" class="btn-secondary btn-sm">
                                <i class="ph ph-x"></i>
                                <span>Atcelt izvēli</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div id="table-loading" class="loading-state">
                    <div class="loading-spinner"></div>
                    <span>Ielādē datus...</span>
                </div>

                <div id="table-container" class="hidden">
                    <div class="card table-card">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead id="table-header"></thead>
                                <tbody id="table-body"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="table-footer">
                        <span id="table-count">0</span> ieraksti
                        <span id="filtered-count" class="hidden" style="color: var(--color-primary); margin-left: 10px;"></span>
                    </div>
                </div>

                <div id="table-empty" class="hidden empty-state">
                    <i class="ph ph-tray empty-icon"></i>
                    <span>Tabula ir tukša</span>
                </div>
            </div>
        </main>

        <!-- Date Picker Popup -->
        <div id="date-picker" class="date-picker-popup hidden">
            <div class="date-picker-header">
                <button type="button" class="date-picker-nav" id="picker-prev-month">
                    <i class="ph ph-caret-left"></i>
                </button>
                <span id="picker-month-year" class="date-picker-title"></span>
                <button type="button" class="date-picker-nav" id="picker-next-month">
                    <i class="ph ph-caret-right"></i>
                </button>
            </div>
            <div class="date-picker-days">
                <div class="date-picker-day-name">Pr</div>
                <div class="date-picker-day-name">Ot</div>
                <div class="date-picker-day-name">Tr</div>
                <div class="date-picker-day-name">Ce</div>
                <div class="date-picker-day-name">Pk</div>
                <div class="date-picker-day-name">Se</div>
                <div class="date-picker-day-name">Sv</div>
            </div>
            <div id="picker-dates" class="date-picker-dates"></div>
        </div>

        <!-- Toast Notifications Container -->
        <div id="toast-container" class="toast-container"></div>
    </div>

    <style is:global>
        :root {
            --color-primary: #1B4332;
            --color-secondary: #C9A36A;
            --color-accent: #295D45;
            --color-text: #1f2937;
            --color-text-light: #64748b;
            --color-muted: #94a3b8;
            --color-bg: #FBF8F2;
            --color-white: #FFFFFF;
            --color-cream: #F6F1E8;
            --color-border: #E6E0D6;
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
            --shadow-sm: 0 1px 2px 0 rgba(17,24,39,0.06);
            --shadow-md: 0 6px 12px -4px rgba(17,24,39,0.12);
            --shadow-lg: 0 16px 30px -12px rgba(17,24,39,0.18);
            --radius: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        .admin-wrapper {
            min-height: 100vh;
            background: var(--color-bg);
            font-family: var(--font-sans);
            color: var(--color-text);
            font-size: 18px;
            line-height: 1.6;
        }

        /* Header */
        .admin-header {
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
            padding: 18px 24px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .admin-header-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .admin-logo-img { height: 36px; width: auto; }

        .admin-logo-text { display: flex; flex-direction: column; }

        .admin-logo-name {
            font-family: var(--font-serif);
            font-size: 21px;
            font-weight: 600;
            color: var(--color-primary);
            line-height: 1.2;
        }

        .admin-logo-sub {
            font-size: 12px;
            color: var(--color-text-light);
            text-transform: uppercase;
            letter-spacing: 1.6px;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .admin-user-name {
            font-size: 15px;
            color: var(--color-text-light);
            display: none;
        }

        .admin-logout {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 15px;
            color: var(--color-text-light);
            text-decoration: none;
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            transition: all 0.2s;
        }

        .admin-logout:hover {
            background: #fef2f2;
            color: #dc2626;
        }

        /* Mobile Tab Select */
        .mobile-tab-select {
            display: block;
            padding: 18px 24px;
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
        }

        .mobile-tab-dropdown {
            width: 100%;
            padding: 14px 18px;
            font-size: 16px;
            font-family: var(--font-sans);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-white);
            color: var(--color-text);
            cursor: pointer;
        }

        .mobile-tab-dropdown:focus {
            outline: none;
            border-color: var(--color-primary);
        }

        /* Desktop Navigation */
        .admin-nav {
            display: none;
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
        }

        .admin-nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            gap: 4px;
            padding: 0 20px;
            overflow-x: auto;
        }

        .admin-tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 14px 18px;
            border: none;
            background: none;
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            color: var(--color-text-light);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
            white-space: nowrap;
        }

        .admin-tab i { font-size: 20px; }

        .admin-tab:hover {
            color: var(--color-primary);
            background: var(--color-cream);
        }

        .admin-tab.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-secondary);
        }

        /* Main Content */
        .admin-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        .admin-content { animation: fadeIn 0.2s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hidden { display: none !important; }

        /* Content Header */
        .content-header {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 24px;
        }

        .content-title {
            font-family: var(--font-serif);
            font-size: 30px;
            font-weight: 600;
            color: var(--color-primary);
        }

        .content-subtitle {
            font-size: 16px;
            color: var(--color-text-light);
            margin: 0 0 24px 0;
        }

        /* Calendar Controls */
        .calendar-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .calendar-month {
            font-family: var(--font-serif);
            font-weight: 600;
            font-size: 21px;
            min-width: 160px;
            text-align: center;
            color: var(--color-primary);
        }

        .cal-nav-btn {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-white);
            cursor: pointer;
            transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
            color: var(--color-text);
        }

        .cal-nav-btn:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .cal-nav-btn i { font-size: 18px; }

        /* Buttons */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            min-height: 44px;
            background: var(--color-primary);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-primary:hover {
            background: var(--color-accent);
            box-shadow: var(--shadow-md);
        }

        .btn-primary.btn-sm {
            padding: 10px 18px;
            font-size: 15px;
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            min-height: 44px;
            background: var(--color-white);
            color: var(--color-text);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-secondary:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
        }

        .btn-danger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            min-height: 44px;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-danger:hover { background: #fee2e2; }

        .btn-info {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-info:hover { background: #dbeafe; }

        .btn-close {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: var(--color-cream);
            border-radius: 50%;
            cursor: pointer;
            color: var(--color-text-light);
            transition: all 0.2s;
        }

        .btn-close:hover {
            background: #fee2e2;
            color: #dc2626;
        }

        .btn-close i { font-size: 18px; }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }

        .toast {
            pointer-events: auto;
            min-width: 300px;
            max-width: 400px;
            background: var(--color-white);
            border-radius: var(--radius-sm);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            padding: 16px 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideIn 0.3s ease-out;
            border-left: 4px solid var(--color-primary);
        }

        .toast.success { border-left-color: #22c55e; }
        .toast.error { border-left-color: #ef4444; }
        .toast.warning { border-left-color: #f59e0b; }
        .toast.info { border-left-color: #3b82f6; }

        .toast-icon {
            font-size: 24px;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .toast.success .toast-icon { color: #22c55e; }
        .toast.error .toast-icon { color: #ef4444; }
        .toast.warning .toast-icon { color: #f59e0b; }
        .toast.info .toast-icon { color: #3b82f6; }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-weight: 600;
            font-size: 15px;
            color: var(--color-primary);
            margin-bottom: 4px;
        }

        .toast-message {
            font-size: 14px;
            color: var(--color-text-light);
        }

        .toast-close {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: transparent;
            border-radius: 50%;
            cursor: pointer;
            color: var(--color-text-light);
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .toast-close:hover {
            background: var(--color-cream);
            color: var(--color-text);
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }
            to {
                opacity: 0;
                transform: translateX(100px);
            }
        }

        .toast.removing {
            animation: slideOut 0.3s ease-out forwards;
        }

        /* Confirm Dialog */
        .confirm-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            opacity: 0;
            transition: opacity 0.2s ease-out;
            backdrop-filter: blur(4px);
        }

        .confirm-overlay.show {
            opacity: 1;
        }

        .confirm-dialog {
            background: var(--color-white);
            border-radius: var(--radius);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 440px;
            width: 90%;
            transform: scale(0.9) translateY(-20px);
            transition: transform 0.2s ease-out;
        }

        .confirm-overlay.show .confirm-dialog {
            transform: scale(1) translateY(0);
        }

        .confirm-header {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 24px 24px 16px;
            border-bottom: 1px solid var(--color-border);
        }

        .confirm-icon {
            font-size: 32px;
            color: var(--color-secondary);
            flex-shrink: 0;
        }

        .confirm-header h3 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
            color: var(--color-text);
        }

        .confirm-body {
            padding: 24px;
        }

        .confirm-body p {
            margin: 0;
            color: var(--color-text);
            line-height: 1.6;
            font-size: 15px;
        }

        .confirm-actions {
            display: flex;
            gap: 12px;
            padding: 16px 24px 24px;
            justify-content: flex-end;
        }

        .confirm-cancel, .confirm-ok {
            padding: 10px 24px;
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }

        .confirm-cancel {
            background: var(--color-white);
            color: var(--color-text);
            border: 1px solid var(--color-border);
        }

        .confirm-cancel:hover {
            background: var(--color-background);
        }

        .confirm-ok {
            background: var(--color-primary);
            color: var(--color-white);
        }

        .confirm-ok:hover {
            background: var(--color-secondary);
        }

        /* Date Picker */
        .date-picker-popup {
            position: absolute;
            background: var(--color-white);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            padding: 16px;
            z-index: 9999;
            min-width: 300px;
        }

        .date-picker-popup.hidden {
            display: none;
        }

        .date-picker-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .date-picker-title {
            font-family: var(--font-serif);
            font-size: 18px;
            font-weight: 600;
            color: var(--color-primary);
        }

        .date-picker-nav {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.2s;
            color: var(--color-text);
        }

        .date-picker-nav:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
        }

        .date-picker-days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            margin-bottom: 8px;
        }

        .date-picker-day-name {
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            color: var(--color-text-light);
            padding: 8px 0;
        }

        .date-picker-dates {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
        }

        .date-picker-date {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
            color: var(--color-text);
            border: 1px solid transparent;
        }

        .date-picker-date:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
        }

        .date-picker-date.other-month {
            color: var(--color-muted);
        }

        .date-picker-date.today {
            border-color: var(--color-accent);
            font-weight: 600;
        }

        .date-picker-date.selected {
            background: var(--color-primary);
            color: var(--color-white);
            font-weight: 600;
        }

        .date-picker-date.selected:hover {
            background: var(--color-accent);
        }

        /* Cards */
        .card {
            background: var(--color-white);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--color-border);
            padding: 28px;
            margin-bottom: 24px;
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 600;
            color: var(--color-primary);
            margin: 0 0 24px 0;
        }

        .card-title i {
            font-size: 20px;
            color: var(--color-secondary);
        }

        .card-footer {
            margin-top: 28px;
            padding-top: 24px;
            border-top: 1px solid var(--color-border);
        }

        /* Form Elements */
        .input-field {
            padding: 12px 18px;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 16px;
            color: var(--color-text);
