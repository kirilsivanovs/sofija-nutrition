      }
      .admin-user-name {
        display: block;
      }
      .mobile-tab-select {
        display: none;
      }
      .admin-nav {
        display: block;
      }
      .admin-main {
        padding: 32px;
      }
      .content-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
      .content-title {
