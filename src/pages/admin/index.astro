    @media (min-width: 1024px) {
      .calendar-cell {
        min-height: 160px;
        padding: 16px;
      }
      .calendar-grid {
        min-height: 800px;
      }
    }

    @media (min-width: 1280px) {
      .calendar-cell {
        min-height: 180px;
      }
    }
  </style>

  <script>
    import {
      formatDate,
      formatDateReverse,
      formatTime,
      formatDateISO,
      initializeDateInputs,
    } from '../../utils/admin/formatters';
    import { showToast, showConfirm } from '../../utils/admin/notifications';
    import {
      DAY_NAMES_FOR_SCHEDULE,
      MONTH_NAMES,
      SERVICE_NAMES,
    } from '../../utils/admin/constants';
    import {
      renderCalendar,
      showDayDetails,
      navigateMonth,
      goToToday,
      setCalendarData,
      getCurrentDate,
      setCurrentDate,
      getSelectedDate,
      setSelectedDate,
      getServiceName,
      getStatusText,
    } from '../../utils/admin/calendar';
    import {
      loadAvailabilityForm,
      saveAvailability,
      addVacation,
      removeVacation as removeVacationUtil,
      addBlockedDate,
      removeBlockedDate as removeBlockedDateUtil,
      setupVacationDateValidation,
    } from '../../utils/admin/availability';
    import { initDatePicker } from '../../utils/admin/datePicker';
    import { loadHolidays, setupHolidaysListeners } from '../../utils/admin/holidays';
    import {
      loadCalendarData,
      confirmBooking as confirmBookingApi,
      cancelBooking as cancelBookingApi,
      findFirstUpcomingBooking,
    } from '../../utils/adminApiAdapter';
    import { PatientService } from '../../services/admin/PatientService';
    import { PatientListController } from '../../components/admin/PatientList/PatientListController';
    import { MealsTabController } from '../../components/admin/MealsTab/MealsTab';
    import { DataTabController } from '../../components/admin/DataTab/DataTab';

    // Type declarations for global window functions
    declare global {
      interface Window {
        getAuthHeaders: () => Record<string, string>;
        showDayDetails: (dateStr: string) => void;
        confirmBooking: (id: string) => Promise<void>;
        cancelBooking: (id: string) => Promise<void>;
        removeVacation: (id: string) => Promise<void>;
        removeBlockedDate: (date: string) => Promise<void>;
        deleteEntity: (partitionKey: string, rowKey: string) => Promise<void>;
      }
    }

    interface VacationPeriod {
      id?: string;
      startDate: string;
      endDate: string;
    }

    interface MealItem {
      name: string;
      weight: number;
      calories?: number;
      protein?: number;
      fat?: number;
      carbs?: number;
    }

    interface Meal {
      id?: string;
      userId?: string;
      createdAt: string;
      mealType: 'breakfast' | 'lunch' | 'dinner' | 'snack';
      totalCalories: number;
      totalProtein: number;
      totalFat: number;
      totalCarbs: number;
      items?: MealItem[];
    }

    interface DayData {
      totalCalories: number;
      totalProtein: number;
      totalFat: number;
      totalCarbs: number;
      meals: Meal[];
      mealsByType: {
        breakfast: Meal[];
        lunch: Meal[];
        dinner: Meal[];
        snack: Meal[];
      };
    }

    const API_BASE =
      window.location.hostname === 'localhost' ? 'http://localhost:7071/api' : '/api';

    // E2E Test Token Support
    // Если в URL есть ?e2e_token=xxx, проверяем его и сохраняем
    const urlParams = new URLSearchParams(window.location.search);
    const e2eToken = urlParams.get('e2e_token') || sessionStorage.getItem('e2e_token');

    if (e2eToken) {
      sessionStorage.setItem('e2e_token', e2eToken);
      // Убираем токен из URL для безопасности
      if (urlParams.has('e2e_token')) {
        urlParams.delete('e2e_token');
        const newUrl =
          window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
        window.history.replaceState({}, '', newUrl);
      }
    }

    // Функция для добавления токена к API запросам
    window.getAuthHeaders = function (): Record<string, string> {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      const token = sessionStorage.getItem('e2e_token');
      if (token) {
        headers['X-E2E-Token'] = token;
      }
      return headers;
    };

    // Calendar state managed by calendar.js
    let allBookings: any[] = [];
    let holidays: Record<string, string> = {};
    let schedule: Record<string, any> = {};
    let blockedDates = new Set<string>();
    let vacationPeriods: VacationPeriod[] = [];
    const dayNamesForSchedule = DAY_NAMES_FOR_SCHEDULE;
    const monthNames = MONTH_NAMES;

    // Initialize date inputs and date picker on page load
    initializeDateInputs();
    initDatePicker();

    // Проверяем авторизацию - Microsoft OAuth или E2E Token
    const e2eTokenStored = sessionStorage.getItem('e2e_token');
    if (e2eTokenStored) {
      // E2E режим - проверяем токен через API
      fetch(API_BASE + '/test/auth', {
        headers: { 'X-E2E-Token': e2eTokenStored },
      })
        .then((r) => r.json())
        .then((data) => {
          if (data.clientPrincipal) {
            const userInfo = document.getElementById('user-info');
            if (userInfo) userInfo.textContent = data.clientPrincipal.userDetails + ' (E2E)';
          }
        })
        .catch(() => {
          // Токен невалиден - очищаем
          sessionStorage.removeItem('e2e_token');
        });
    } else {
      // Стандартная Microsoft авторизация
      fetch('/.auth/me')
        .then((r) => r.json())
        .then((data) => {
          if (data.clientPrincipal) {
            const userInfo = document.getElementById('user-info');
            if (userInfo)
              userInfo.textContent =
                data.clientPrincipal.userDetails || data.clientPrincipal.userId;
          }
        })
        .catch(() => {});
    }

    const tabBtns = document.querySelectorAll('.admin-tab');
    const tabContents = document.querySelectorAll('.admin-content');
    const mobileSelect = document.getElementById('mobile-tab-selector') as HTMLSelectElement | null;

    function switchTab(tabId: string) {
      tabBtns.forEach((b) => b.classList.remove('active'));
      const activeBtn = document.querySelector(`.admin-tab[data-tab="${tabId}"]`);
      if (activeBtn) activeBtn.classList.add('active');
      tabContents.forEach((c) => c.classList.add('hidden'));
      const tabEl = document.getElementById('tab-' + tabId);
      if (tabEl) tabEl.classList.remove('hidden');
      if (mobileSelect) mobileSelect.value = tabId;
      if (tabId === 'bookings') loadCalendar();
      if (tabId === 'availability') loadAvailability();
      if (tabId === 'settings') loadSettings();
      if (tabId === 'meals') patientController.loadPatients();
      if (tabId === 'data') dataTabController.loadTableData();
    }

    tabBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const tab = (btn as HTMLElement).dataset.tab;
        if (tab) switchTab(tab);
      })
    );
    if (mobileSelect) {
      mobileSelect.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        switchTab(target.value);
      });
    }

    // Initialize Patient Service and Controller
    const patientService = new PatientService(API_BASE);
    const patientController = new PatientListController(patientService);

    // Initialize MealsTab Controller
    const mealsTabController = new MealsTabController(
      {
        patientController,
        onShowToast: showToast,
      },
      API_BASE
    );

    // Initialize Patient List Controller
    patientController.init({
      searchInput: document.getElementById('patients-search-input') as HTMLInputElement | null,
      addInput: document.getElementById('patients-add-input') as HTMLInputElement | null,
      addButton: document.getElementById('patients-add-btn') as HTMLButtonElement | null,
      listContainer: document.getElementById('patients-list'),
      emptyContainer: document.getElementById('patients-empty'),
      onPatientSelect: (patient) => {
        const displayName = patientService.getDisplayName(patient);
        mealsTabController.setSelectedPatientName(displayName);
        mealsTabController.loadMealsForMonth();
      },
      onAccessUpdate: () => {
        // Access updated successfully
      },
      onShowToast: showToast,
      onShowConfirm: showConfirm,
    });

    // Initialize MealsTab after Patient Controller
    mealsTabController.init();

    // Initialize DataTab Controller
    const dataTabController = new DataTabController(
      {
        onShowToast: showToast,
        onShowConfirm: showConfirm,
      },
      API_BASE
    );
    dataTabController.init();

    // Utility functions still used elsewhere
    function formatPatientDate(value?: string): string {
      if (!value) return '—';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '—';
      return date.toLocaleDateString('lv-LV');
    }

    const prevMonthBtn = document.getElementById('prev-month');
    const nextMonthBtn = document.getElementById('next-month');
    const todayBtn = document.getElementById('today-btn');
    const refreshBookingsBtn = document.getElementById('refresh-bookings');
    const closeDayDetailsBtn = document.getElementById('close-day-details');

    if (prevMonthBtn) {
      prevMonthBtn.addEventListener('click', () => {
        const currentDate = getCurrentDate();
        currentDate.setDate(1);
        currentDate.setMonth(currentDate.getMonth() - 1);
        setCurrentDate(currentDate);
        loadCalendar();
      });
    }

    if (nextMonthBtn) {
      nextMonthBtn.addEventListener('click', () => {
        const currentDate = getCurrentDate();
        currentDate.setDate(1);
        currentDate.setMonth(currentDate.getMonth() + 1);
        setCurrentDate(currentDate);
        loadCalendar();
      });
    }

    if (todayBtn) {
      todayBtn.addEventListener('click', () => {
        setCurrentDate(new Date());
        loadCalendar();
      });
    }

    if (refreshBookingsBtn) {
      refreshBookingsBtn.addEventListener('click', loadCalendar);
    }

    if (closeDayDetailsBtn) {
      closeDayDetailsBtn.addEventListener('click', () => {
        const dayDetails = document.getElementById('day-details');
        if (dayDetails) dayDetails.classList.add('hidden');
      });
    }

    async function loadCalendar() {
      const loading = document.getElementById('bookings-loading');
      const container = document.getElementById('calendar-container');
      const dayDetails = document.getElementById('day-details');
      const currentMonthEl = document.getElementById('current-month');

      if (loading) loading.classList.remove('hidden');
      if (container) container.classList.add('hidden');
      if (dayDetails) dayDetails.classList.add('hidden');

      const currentDate = getCurrentDate();
      if (currentMonthEl) {
        currentMonthEl.textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;
      }

      try {
        const year = currentDate.getFullYear();

        // Use centralized API client
        const data = await loadCalendarData(year);

        allBookings = data.bookings;
        holidays = data.holidays;
        schedule = data.schedule;
        blockedDates = data.blockedDates as Set<string>;
        vacationPeriods = data.vacations.map((v: { start: string; end: string }) => ({
          startDate: v.start,
          endDate: v.end,
        }));

        // Update calendar data in calendar module
        setCalendarData({
          bookings: allBookings,
          schedule,
          holidays,
          blockedDates,
          vacationPeriods,
        });

        console.log('📅 Loaded vacation periods:', vacationPeriods);
        renderCalendar();
        if (loading) loading.classList.add('hidden');
        if (container) container.classList.remove('hidden');
      } catch (error: unknown) {
        if (loading)
          loading.innerHTML =
            '<span style="color:#dc2626;">Kļūda: ' + (error as Error).message + '</span>';
      }
    }

    // Находит ближайшую будущую запись и переключает календарь на этот месяц
    async function navigateToFirstUpcomingBooking() {
      try {
        const firstBooking = await findFirstUpcomingBooking();

        if (firstBooking) {
          const today = new Date();
          const bookingDate = new Date(firstBooking.date);

          // Если запись в другом месяце - переключаемся
          if (
            bookingDate.getMonth() !== today.getMonth() ||
            bookingDate.getFullYear() !== today.getFullYear()
          ) {
            setCurrentDate(new Date(bookingDate.getFullYear(), bookingDate.getMonth(), 1));
            console.log(`📅 Переключено на месяц с ближайшей записью: ${firstBooking.date}`);
          }
        }
      } catch (error) {
        console.error('Ошибка при поиске ближайших записей:', error);
      }
    }

    // Expose showDayDetails to window for calendar cells onclick
    window.showDayDetails = showDayDetails;

    // Helper function to check if date is in vacation period (for non-calendar use)
    function isDateInVacation(dateStr: string): boolean {
      return vacationPeriods.some((v) => dateStr >= v.startDate && dateStr <= v.endDate);
    }

    window.confirmBooking = async function (id: string): Promise<void> {
      const confirmed = await showConfirm(
        'Vai tiešām vēlaties apstiprināt šo ierakstu?',
        'Apstiprināt ierakstu'
      );
      if (!confirmed) return;
      try {
        await confirmBookingApi(id);
        await loadCalendar();
        // Refresh day details if a date is selected
        const selectedDate = getSelectedDate();
        if (selectedDate) {
          showDayDetails(selectedDate);
        }
        showToast('Ieraksts veiksmīgi apstiprināts', 'success');
      } catch (e: unknown) {
        showToast((e as Error).message, 'error');
      }
    };

    window.cancelBooking = async function (id: string): Promise<void> {
      const confirmed = await showConfirm(
        'Vai tiešām vēlaties atcelt šo ierakstu?',
        'Atcelt ierakstu'
      );
      if (!confirmed) return;
      try {
        await cancelBookingApi(id);
        await loadCalendar();
        // Refresh day details if a date is selected
        const selectedDate = getSelectedDate();
        if (selectedDate) {
          showDayDetails(selectedDate);
        }
        showToast('Ieraksts veiksmīgi atcelts', 'success');
      } catch (e: unknown) {
        showToast((e as Error).message, 'error');
      }
    };

    // Availability functions using utilities
    function loadAvailability() {
      loadAvailabilityForm(API_BASE, () => loadHolidays(API_BASE));
      setupVacationDateValidation();
    }

    // Setup holidays listeners
    setupHolidaysListeners(API_BASE);

    const saveAvailabilityBtn = document.getElementById('save-availability');
    if (saveAvailabilityBtn) {
      saveAvailabilityBtn.addEventListener('click', () => saveAvailability(API_BASE));
    }

    const addVacationBtn = document.getElementById('add-vacation');
    if (addVacationBtn) {
      addVacationBtn.addEventListener('click', () => {
        addVacation(API_BASE, () => {
          loadAvailability();
          loadCalendar();
        });
      });
    }

    window.removeVacation = async function (id: string): Promise<void> {
      await removeVacationUtil(API_BASE, id, () => {
        loadAvailability();
        loadCalendar();
      });
    };

    const addBlockedDateBtn = document.getElementById('add-blocked-date');
    if (addBlockedDateBtn) {
      addBlockedDateBtn.addEventListener('click', () => {
        addBlockedDate(API_BASE, loadAvailability);
      });
    }

    window.removeBlockedDate = async function (date: string): Promise<void> {
      await removeBlockedDateUtil(API_BASE, date, loadAvailability);
    };

    function loadSettings() {
      fetch(API_BASE + '/dashboard/settings')
        .then((r) => r.json())
        .then((data) => {
          const priceInitial = document.getElementById('price-initial') as HTMLInputElement | null;
          const priceFollowup = document.getElementById(
            'price-followup'
          ) as HTMLInputElement | null;
          const contactEmail = document.getElementById('contact-email') as HTMLInputElement | null;
          const contactPhone = document.getElementById('contact-phone') as HTMLInputElement | null;
          const contactAddress = document.getElementById(
            'contact-address'
          ) as HTMLInputElement | null;
          const durationInitial = document.getElementById(
            'duration-initial'
          ) as HTMLInputElement | null;
          const durationFollowup = document.getElementById(
            'duration-followup'
          ) as HTMLInputElement | null;
          const bankName = document.getElementById('bank-name') as HTMLInputElement | null;
          const bankIban = document.getElementById('bank-iban') as HTMLInputElement | null;

          if (data.prices) {
            if (priceInitial) priceInitial.value = data.prices.initial || 65;
            if (priceFollowup) priceFollowup.value = data.prices.followup || 45;
          }
          if (data.contact) {
            if (contactEmail) contactEmail.value = data.contact.email || '';
            if (contactPhone) contactPhone.value = data.contact.phone || '';
            if (contactAddress) contactAddress.value = data.contact.address || '';
          }
          if (data.duration) {
            if (durationInitial) durationInitial.value = data.duration.initial || 60;
            if (durationFollowup) durationFollowup.value = data.duration.followup || 30;
          }
          if (data.bank) {
            if (bankName) bankName.value = data.bank.name || '';
            if (bankIban) bankIban.value = data.bank.iban || '';
          }
        })
        .catch(() => {});
    }

    const saveSettingsBtn = document.getElementById('save-settings');
    if (saveSettingsBtn) {
      saveSettingsBtn.addEventListener('click', async () => {
        const priceInitial = (document.getElementById('price-initial') as HTMLInputElement)?.value;
        const priceFollowup = (document.getElementById('price-followup') as HTMLInputElement)
          ?.value;
        const contactEmail = (document.getElementById('contact-email') as HTMLInputElement)?.value;
        const contactPhone = (document.getElementById('contact-phone') as HTMLInputElement)?.value;
        const contactAddress = (document.getElementById('contact-address') as HTMLInputElement)
          ?.value;
        const durationInitial = (document.getElementById('duration-initial') as HTMLInputElement)
          ?.value;
        const durationFollowup = (document.getElementById('duration-followup') as HTMLInputElement)
          ?.value;
        const bankName = (document.getElementById('bank-name') as HTMLInputElement)?.value;
        const bankIban = (document.getElementById('bank-iban') as HTMLInputElement)?.value;

        const settings = {
          prices: {
            initial: parseInt(priceInitial || '65'),
            followup: parseInt(priceFollowup || '45'),
          },
          contact: {
            email: contactEmail || '',
            phone: contactPhone || '',
            address: contactAddress || '',
          },
          duration: {
            initial: parseInt(durationInitial || '60'),
            followup: parseInt(durationFollowup || '30'),
          },
          bank: { name: bankName || '', iban: bankIban || '' },
        };
        try {
          await fetch(API_BASE + '/dashboard/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(settings),
          });
          showToast('Iestatījumi saglabāti!', 'success');
        } catch (e: unknown) {
          showToast((e as Error).message, 'error');
        }
      });
    }

    // При первой загрузке - переходим к месяцу с ближайшими записями
    navigateToFirstUpcomingBooking().then(() => loadCalendar());
  </script>

  <!-- Admin Access Check -->
  <script>
    // Check if user is authorized admin before showing admin panel
    async function checkAdminAccess() {
      try {
        // Get user info from Azure Static Web Apps
        const authResponse = await fetch('/.auth/me');
        const authData = await authResponse.json();

        if (!authData.clientPrincipal) {
          // Not authenticated - redirect to login
          window.location.href = '/.auth/login/aad?post_login_redirect_uri=/admin';
          return;
        }

        const userEmail = authData.clientPrincipal.userDetails;

        // Admin email whitelist (synchronized with backend ADMIN_EMAILS env var)
        const ADMIN_EMAILS = ['ivanovs.kirils95@gmail.com'];

        const isAdmin = ADMIN_EMAILS.some(
          (email) => email.toLowerCase() === userEmail.toLowerCase()
        );

        if (isAdmin) {
          // Show admin content
          const adminContent = document.getElementById('admin-content');
          if (adminContent) adminContent.style.display = 'block';
        } else {
          // Show unauthorized page
          const unauthorizedPage = document.getElementById('unauthorized-page');
          const emailDisplay = document.getElementById('unauthorized-email');
          if (unauthorizedPage) unauthorizedPage.style.display = 'flex';
          if (emailDisplay) emailDisplay.textContent = userEmail;
        }
      } catch (error) {
        console.error('Admin access check failed:', error);
        // On error, show unauthorized page
        const unauthorizedPage = document.getElementById('unauthorized-page');
        if (unauthorizedPage) unauthorizedPage.style.display = 'flex';
      }
    }

    // Run check when page loads
    checkAdminAccess();
  </script>
</Layout>
