    </style>

    <script is:inline>
    (function() {
        const API_BASE = 'https://sofija-nutrition-api.azurewebsites.net/api';
        let currentDate = new Date();
        let allBookings = [];
        let holidays = {};
        let schedule = {};
        let blockedDates = new Set();
        const dayNamesForSchedule = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
        const monthNames = ['Janvāris', 'Februāris', 'Marts', 'Aprīlis', 'Maijs', 'Jūnijs', 'Jūlijs', 'Augusts', 'Septembris', 'Oktobris', 'Novembris', 'Decembris'];

        fetch('/.auth/me').then(r => r.json()).then(data => {
            if (data.clientPrincipal) {
                document.getElementById('user-info').textContent = data.clientPrincipal.userDetails || data.clientPrincipal.userId;
            }
        }).catch(() => {});

        const tabBtns = document.querySelectorAll('.admin-tab');
        const tabContents = document.querySelectorAll('.admin-content');
        const mobileSelect = document.getElementById('mobile-tab-selector');

        function switchTab(tabId) {
            tabBtns.forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`.admin-tab[data-tab="${tabId}"]`);
            if (activeBtn) activeBtn.classList.add('active');
            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            mobileSelect.value = tabId;
            if (tabId === 'bookings') loadCalendar();
            if (tabId === 'availability') loadAvailability();
            if (tabId === 'settings') loadSettings();
            if (tabId === 'data') loadTableData();
            if (tabId === 'monitoring') loadMonitoring();
        }

        tabBtns.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
        mobileSelect.addEventListener('change', e => switchTab(e.target.value));

        document.getElementById('prev-month').addEventListener('click', () => { currentDate.setMonth(currentDate.getMonth() - 1); loadCalendar(); });
        document.getElementById('next-month').addEventListener('click', () => { currentDate.setMonth(currentDate.getMonth() + 1); loadCalendar(); });
        document.getElementById('today-btn').addEventListener('click', () => { currentDate = new Date(); loadCalendar(); });
        document.getElementById('refresh-bookings').addEventListener('click', loadCalendar);
        document.getElementById('close-day-details').addEventListener('click', () => document.getElementById('day-details').classList.add('hidden'));

        async function loadCalendar() {
            const loading = document.getElementById('bookings-loading');
            const container = document.getElementById('calendar-container');
            loading.classList.remove('hidden');
            container.classList.add('hidden');
            document.getElementById('day-details').classList.add('hidden');
            document.getElementById('current-month').textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;

            try {
                const year = currentDate.getFullYear();
                const [bookingsRes, holidaysRes, availabilityRes] = await Promise.all([
                    fetch(API_BASE + '/dashboard/bookings'),
                    fetch(API_BASE + '/holidays?year=' + year),
                    fetch(API_BASE + '/dashboard/availability')
                ]);
                const bookingsData = await bookingsRes.json();
                const holidaysData = await holidaysRes.json();
                const availabilityData = await availabilityRes.json();
                allBookings = bookingsData.bookings || [];
                holidays = {};
                if (holidaysData.holidays) holidaysData.holidays.forEach(h => { holidays[h.date] = h.name; });
                schedule = availabilityData.schedule || {};
                blockedDates = new Set((availabilityData.blockedDates || []).map(d => d.date));
                renderCalendar();
                loading.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (error) {
                loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>';
            }
        }

        function renderCalendar() {
            const grid = document.getElementById('calendar-grid');
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();
            let startDay = firstDay.getDay() - 1;
            if (startDay < 0) startDay = 6;
            const bookingsByDate = {};
            allBookings.forEach(b => { if (!bookingsByDate[b.date]) bookingsByDate[b.date] = []; bookingsByDate[b.date].push(b); });
            const today = new Date();
            const todayStr = today.toISOString().split('T')[0];
            let html = '';
            for (let i = 0; i < startDay; i++) html += '<div class="calendar-cell empty"></div>';
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isToday = dateStr === todayStr;
                const isHoliday = holidays[dateStr];
                const dayBookings = bookingsByDate[dateStr] || [];
                const dayOfWeek = (startDay + day - 1) % 7;
                const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;
                const isBlocked = blockedDates.has(dateStr);
                const checkDate = new Date(year, month, day);
                const scheduleDayName = dayNamesForSchedule[checkDate.getDay()];
                const daySchedule = schedule[scheduleDayName];
                const isWorkingDay = daySchedule && daySchedule.enabled;
                const pending = dayBookings.filter(b => b.status === 'pending').length;
                const confirmed = dayBookings.filter(b => b.status === 'confirmed').length;
                let cellClass = 'calendar-cell';
                if (isHoliday || isBlocked) cellClass += ' holiday';
                else if (isWeekend || !isWorkingDay) cellClass += ' weekend';
                else if (confirmed > 0 || pending > 0) cellClass += ' booked';
                else cellClass += ' available';
                html += `<div class="${cellClass}" onclick="showDayDetails('${dateStr}')">
                    <div class="day-number ${isToday ? 'today' : ''}">${day}</div>
                    ${isHoliday ? `<div class="holiday-name">${isHoliday}</div>` : ''}
                    ${isBlocked && !isHoliday ? '<div class="holiday-name">Bloķēts</div>' : ''}
                    ${!isHoliday && !isBlocked && isWorkingDay && !isWeekend && daySchedule ? `<div class="day-time">${daySchedule.start}–${daySchedule.end}</div>` : ''}
                    ${dayBookings.length > 0 ? `<div class="booking-dots">${pending > 0 ? `<div class="booking-dot pending"><span></span>${pending}</div>` : ''}${confirmed > 0 ? `<div class="booking-dot confirmed"><span></span>${confirmed}</div>` : ''}</div>` : ''}
                </div>`;
            }
            const totalCells = startDay + daysInMonth;
            const remainingCells = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
            for (let i = 0; i < remainingCells; i++) html += '<div class="calendar-cell empty"></div>';
            grid.innerHTML = html;
        }

        window.showDayDetails = function(dateStr) {
            const details = document.getElementById('day-details');
            const title = document.getElementById('day-details-title');
            const list = document.getElementById('day-bookings-list');
            const date = new Date(dateStr);
            const dayNames = ['Svētdiena', 'Pirmdiena', 'Otrdiena', 'Trešdiena', 'Ceturtdiena', 'Piektdiena', 'Sestdiena'];
            title.textContent = `${dayNames[date.getDay()]}, ${dateStr}`;
            const holidayName = holidays[dateStr];
            const dayBookings = allBookings.filter(b => b.date === dateStr);
            let html = '';
            if (holidayName) html += `<div class="booking-card" style="border-left-color:#3b82f6;background:#eff6ff;"><div class="booking-details"><div><i class="ph ph-flag"></i><strong>Valsts svētki:</strong> ${holidayName}</div></div></div>`;
            if (dayBookings.length === 0 && !holidayName) html += '<div class="loading-state" style="padding:40px;"><i class="ph ph-calendar-x" style="font-size:32px;color:var(--color-muted);"></i><span>Nav ierakstu šajā dienā</span></div>';
            else {
                dayBookings.sort((a, b) => a.time.localeCompare(b.time));
                html += dayBookings.map(b => `<div class="booking-card ${b.status}">
                    <div class="booking-header"><div><span class="booking-name">${b.name}</span><span class="booking-status ${b.status}">${getStatusText(b.status)}</span></div><span class="booking-time">${b.time}</span></div>
                    <div class="booking-details">
                        <div><i class="ph ph-clipboard-text"></i>${b.service === 'initial' ? 'Pirmreizējā konsultācija' : 'Atkārtota konsultācija'}</div>
                        <div><i class="ph ${b.consultationFormat === 'online' ? 'ph-video-camera' : 'ph-map-pin'}"></i>${b.consultationFormat === 'online' ? 'Online' : 'Klātienē'}</div>
                        <div><i class="ph ph-envelope"></i>${b.email}</div>
                        ${b.phone ? `<div><i class="ph ph-phone"></i>${b.phone}</div>` : ''}
                        ${b.notes ? `<div><i class="ph ph-note"></i>${b.notes}</div>` : ''}
                        <div><i class="ph ph-currency-eur"></i>€${b.price}</div>
                    </div>
                    <div class="booking-actions">${b.status === 'pending' ? `<button onclick="confirmBooking('${b.id}')" class="btn-primary btn-sm"><i class="ph ph-check"></i> Apstiprināt</button>` : ''}${b.status !== 'cancelled' ? `<button onclick="cancelBooking('${b.id}')" class="btn-danger"><i class="ph ph-x"></i> Atcelt</button>` : ''}</div>
                </div>`).join('');
            }
            list.innerHTML = html;
            details.classList.remove('hidden');
            details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        function getStatusText(status) {
            switch(status) { case 'confirmed': return 'Apstiprināts'; case 'pending': return 'Gaida'; case 'cancelled': return 'Atcelts'; default: return status; }
        }

        window.confirmBooking = async function(id) {
            if (!confirm('Apstiprināt šo ierakstu?')) return;
            try { await fetch(API_BASE + '/dashboard/bookings/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'confirmed' }) }); loadCalendar(); } catch (e) { alert('Kļūda: ' + e.message); }
        };

        window.cancelBooking = async function(id) {
            if (!confirm('Atcelt šo ierakstu?')) return;
            try { await fetch(API_BASE + '/dashboard/bookings/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'cancelled' }) }); loadCalendar(); } catch (e) { alert('Kļūda: ' + e.message); }
        };

        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        const dayNames = { monday: 'Pirmdiena', tuesday: 'Otrdiena', wednesday: 'Trešdiena', thursday: 'Ceturtdiena', friday: 'Piektdiena', saturday: 'Sestdiena', sunday: 'Svētdiena' };

        function loadAvailability() {
            const form = document.getElementById('availability-form');
            form.innerHTML = days.map(day => `<div class="availability-day"><div class="availability-day-header"><span class="availability-day-name">${dayNames[day]}</span><label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox" id="day-${day}-enabled" checked style="width:18px;height:18px;accent-color:var(--color-primary);"><span style="font-size:14px;color:var(--color-text-light);">Aktīva</span></label></div><div class="availability-day-times"><input type="time" id="day-${day}-start" value="09:00" class="input-field"><span style="color:var(--color-muted);">—</span><input type="time" id="day-${day}-end" value="17:00" class="input-field"></div></div>`).join('');
            document.getElementById('day-saturday-enabled').checked = false;
            document.getElementById('day-sunday-enabled').checked = false;
            fetch(API_BASE + '/dashboard/availability').then(r => r.json()).then(data => {
                if (data.schedule) Object.entries(data.schedule).forEach(([day, config]) => {
                    const checkbox = document.getElementById(`day-${day}-enabled`);
                    const startInput = document.getElementById(`day-${day}-start`);
                    const endInput = document.getElementById(`day-${day}-end`);
                    if (checkbox) checkbox.checked = config.enabled;
                    if (startInput) startInput.value = config.start || '09:00';
                    if (endInput) endInput.value = config.end || '17:00';
                });
                if (data.blockedDates) renderBlockedDates(data.blockedDates);
            }).catch(() => {});
            loadHolidays();
        }

        function renderBlockedDates(dates) {
            const list = document.getElementById('blocked-dates-list');
            if (!dates || dates.length === 0) { list.innerHTML = '<p style="color:var(--color-text-light);font-size:14px;">Nav bloķētu datumu</p>'; return; }
            list.innerHTML = dates.map(d => `<div class="blocked-item"><span>${d.date} ${d.reason ? '— ' + d.reason : ''}</span><button onclick="removeBlockedDate('${d.date}')" class="btn-close" style="width:28px;height:28px;"><i class="ph ph-x"></i></button></div>`).join('');
        }

        document.getElementById('save-availability').addEventListener('click', async () => {
            const scheduleData = {};
            days.forEach(day => { scheduleData[day] = { enabled: document.getElementById(`day-${day}-enabled`).checked, start: document.getElementById(`day-${day}-start`).value, end: document.getElementById(`day-${day}-end`).value }; });
            try { await fetch(API_BASE + '/dashboard/availability', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ schedule: scheduleData }) }); alert('Pieejamība saglabāta!'); } catch (e) { alert('Kļūda: ' + e.message); }
        });

        document.getElementById('add-blocked-date').addEventListener('click', async () => {
            const date = document.getElementById('block-date').value;
            const reason = document.getElementById('block-reason').value;
            if (!date) return alert('Izvēlieties datumu');
            try { await fetch(API_BASE + '/dashboard/availability/block', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ date, reason }) }); loadAvailability(); document.getElementById('block-date').value = ''; document.getElementById('block-reason').value = ''; } catch (e) { alert('Kļūda: ' + e.message); }
        });

        window.removeBlockedDate = async function(date) {
            try { await fetch(API_BASE + '/dashboard/availability/block', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ date }) }); loadAvailability(); } catch (e) { alert('Kļūda: ' + e.message); }
        };

        function loadSettings() {
            fetch(API_BASE + '/dashboard/settings').then(r => r.json()).then(data => {
                if (data.prices) { document.getElementById('price-initial').value = data.prices.initial || 65; document.getElementById('price-followup').value = data.prices.followup || 45; }
                if (data.contact) { document.getElementById('contact-email').value = data.contact.email || ''; document.getElementById('contact-phone').value = data.contact.phone || ''; document.getElementById('contact-address').value = data.contact.address || ''; }
                if (data.duration) { document.getElementById('duration-initial').value = data.duration.initial || 60; document.getElementById('duration-followup').value = data.duration.followup || 30; }
                if (data.bank) { document.getElementById('bank-name').value = data.bank.name || ''; document.getElementById('bank-iban').value = data.bank.iban || ''; }
            }).catch(() => {});
        }

        document.getElementById('save-settings').addEventListener('click', async () => {
            const settings = { prices: { initial: parseInt(document.getElementById('price-initial').value), followup: parseInt(document.getElementById('price-followup').value) }, contact: { email: document.getElementById('contact-email').value, phone: document.getElementById('contact-phone').value, address: document.getElementById('contact-address').value }, duration: { initial: parseInt(document.getElementById('duration-initial').value), followup: parseInt(document.getElementById('duration-followup').value) }, bank: { name: document.getElementById('bank-name').value, iban: document.getElementById('bank-iban').value } };
            try { await fetch(API_BASE + '/dashboard/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(settings) }); alert('Iestatījumi saglabāti!'); } catch (e) { alert('Kļūda: ' + e.message); }
        });

        loadCalendar();

        async function loadHolidays() {
            const year = document.getElementById('holiday-year').value;
            const list = document.getElementById('holidays-list');
            try { const response = await fetch(API_BASE + '/holidays?year=' + year); const data = await response.json(); if (data.holidays && data.holidays.length > 0) list.innerHTML = data.holidays.map(h => `<div class="holiday-item"><span class="holiday-date">${h.date}</span><span>${h.name}</span></div>`).join(''); else list.innerHTML = '<p style="color:var(--color-text-light);">Nav svētku šajā gadā</p>'; } catch (e) { list.innerHTML = '<p style="color:#dc2626;">Kļūda ielādējot svētkus</p>'; }
        }

        document.getElementById('holiday-year').addEventListener('change', loadHolidays);
        document.getElementById('refresh-holidays').addEventListener('click', loadHolidays);

        let currentTableData = { entities: [], columns: [] };

        async function loadTableData() {
            const tableName = document.getElementById('table-select').value;
            const loading = document.getElementById('table-loading');
            const container = document.getElementById('table-container');
            const empty = document.getElementById('table-empty');
            loading.classList.remove('hidden'); container.classList.add('hidden'); empty.classList.add('hidden');
            try { const response = await fetch(API_BASE + '/dashboard/tables/' + tableName); const data = await response.json(); currentTableData = data; loading.classList.add('hidden'); if (!data.entities || data.entities.length === 0) { empty.classList.remove('hidden'); document.getElementById('table-count').textContent = '0'; return; } renderTable(data); container.classList.remove('hidden'); document.getElementById('table-count').textContent = data.count || data.entities.length; } catch (error) { loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>'; }
        }

        function renderTable(data) {
            const header = document.getElementById('table-header');
            const body = document.getElementById('table-body');
            const columns = data.columns || [];
            header.innerHTML = `<tr>${columns.map(col => `<th>${col}</th>`).join('')}<th>Darbības</th></tr>`;
            body.innerHTML = data.entities.map(entity => {
                const pk = encodeURIComponent(entity.partitionKey || '');
                const rk = encodeURIComponent(entity.rowKey || '');
                return `<tr>${columns.map(col => { let value = entity[col]; if (value === undefined || value === null) value = ''; if (typeof value === 'object') value = JSON.stringify(value); const displayValue = String(value).length > 40 ? String(value).substring(0, 40) + '...' : value; let style = ''; if (col === 'status') { if (value === 'confirmed') style = 'color:#16a34a;font-weight:600;'; else if (value === 'pending') style = 'color:#ca8a04;font-weight:600;'; else if (value === 'cancelled') style = 'color:#dc2626;font-weight:600;'; } return `<td style="${style}" title="${String(value).replace(/"/g, '&quot;')}">${displayValue}</td>`; }).join('')}<td><button onclick="deleteEntity('${pk}', '${rk}')" class="btn-close" title="Dzēst"><i class="ph ph-trash"></i></button></td></tr>`;
            }).join('');
        }

        window.deleteEntity = async function(partitionKey, rowKey) {
            if (!confirm('Vai tiešām dzēst šo ierakstu?')) return;
            const tableName = document.getElementById('table-select').value;
            try { const response = await fetch(`${API_BASE}/dashboard/tables/${tableName}/${partitionKey}/${rowKey}`, { method: 'DELETE' }); if (response.ok) loadTableData(); else { const error = await response.json(); alert('Kļūda: ' + (error.details || error.error)); } } catch (e) { alert('Kļūda: ' + e.message); }
        };

        function exportTableToCSV() {
            if (!currentTableData.entities || currentTableData.entities.length === 0) { alert('Nav datu eksportēšanai'); return; }
            const columns = currentTableData.columns;
            const rows = currentTableData.entities;
            const csvContent = [columns.join(','), ...rows.map(row => columns.map(col => { let value = row[col]; if (value === undefined || value === null) return ''; if (typeof value === 'object') value = JSON.stringify(value); value = String(value).replace(/"/g, '""'); if (value.includes(',') || value.includes('"') || value.includes('\n')) value = `"${value}"`; return value; }).join(','))].join('\n');
            const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `${document.getElementById('table-select').value}_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(url);
        }

        document.getElementById('table-select').addEventListener('change', loadTableData);
        document.getElementById('refresh-table').addEventListener('click', loadTableData);
        document.getElementById('export-csv').addEventListener('click', exportTableToCSV);

        async function loadMonitoring() {
            const loading = document.getElementById('monitoring-loading');
            const container = document.getElementById('endpoints-container');
            const statusIndicator = document.getElementById('status-indicator');
            statusIndicator.innerHTML = '<i class="ph ph-circle-notch spinning"></i>';
            statusIndicator.className = 'status-badge';
            loading.classList.remove('hidden'); container.classList.add('hidden');
            try {
                const response = await fetch(API_BASE + '/dashboard/monitoring');
                const data = await response.json();
                const statusText = document.getElementById('status-text');
                const statusConfig = { healthy: { text: 'Viss darbojas', icon: 'ph-check-circle', cssClass: 'healthy' }, degraded: { text: 'Daļēji degradēts', icon: 'ph-warning', cssClass: 'degraded' }, unhealthy: { text: 'Problēmas!', icon: 'ph-x-circle', cssClass: 'unhealthy' } };
                const config = statusConfig[data.overallStatus] || statusConfig.unhealthy;
                statusText.textContent = config.text;
                statusIndicator.innerHTML = `<i class="ph ${config.icon}"></i>`;
                statusIndicator.className = 'status-badge ' + config.cssClass;
                document.getElementById('stat-total').textContent = data.summary.total;
                document.getElementById('stat-healthy').textContent = data.summary.healthy;
                document.getElementById('stat-degraded').textContent = data.summary.degraded;
                document.getElementById('stat-unhealthy').textContent = data.summary.unhealthy;
                document.getElementById('last-check').textContent = `${new Date(data.checkedAt).toLocaleTimeString('lv-LV')} (${data.totalCheckTime}ms)`;
                const endpointsList = document.getElementById('endpoints-list');
                const statusIcons = { healthy: 'ph-check-circle', degraded: 'ph-warning', unhealthy: 'ph-x-circle' };
                endpointsList.innerHTML = data.endpoints.map(ep => `<div class="endpoint-card ${ep.status === 'unhealthy' ? 'unhealthy' : ''}"><div class="endpoint-info"><i class="ph ${statusIcons[ep.status]} endpoint-icon ${ep.status}"></i><div><div class="endpoint-name">${ep.name}</div><div class="endpoint-path"><code>${ep.method}</code> <code>${ep.path}</code>${ep.critical ? '<span class="endpoint-critical"> • Kritisks</span>' : ''}</div></div></div><div class="endpoint-status"><span class="endpoint-code ${ep.status}">${ep.httpStatus > 0 ? ep.httpStatus : 'Kļūda'}</span><div class="endpoint-time">${ep.responseTime}ms</div></div></div>`).join('');
                document.getElementById('environment-info').innerHTML = `<div><strong>Function App:</strong> ${data.environment.functionApp}</div><div><strong>Node.js:</strong> ${data.environment.nodeVersion}</div><div><strong>Vidējais atbildes laiks:</strong> ${data.avgResponseTime}ms</div>`;
                loading.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (error) {
                loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>';
                document.getElementById('status-text').textContent = 'Kļūda!';
                statusIndicator.innerHTML = '<i class="ph ph-x-circle"></i>';
                statusIndicator.className = 'status-badge unhealthy';
            }
        }

        document.getElementById('refresh-monitoring').addEventListener('click', loadMonitoring);
    })();
    </script>
</Layout>
