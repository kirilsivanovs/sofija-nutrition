---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sofija Nutrition - Admin Panel">
    <div class="admin-wrapper">
        <!-- Header -->
        <header class="admin-header">
            <div class="admin-header-inner">
                <a href="/" class="admin-logo">
                    <img src="/assets/img/logo.svg" alt="SI Logo" class="admin-logo-img">
                    <div class="admin-logo-text">
                        <span class="admin-logo-name">Sofija Nutrition</span>
                        <span class="admin-logo-sub">Administrācija</span>
                    </div>
                </a>
                <div class="admin-user">
                    <span id="user-info" class="admin-user-name"></span>
                    <a href="/.auth/logout" class="admin-logout">
                        <i class="ph ph-sign-out"></i>
                        <span>Iziet</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Mobile Tab Selector -->
        <div class="mobile-tab-select">
            <select id="mobile-tab-selector" class="mobile-tab-dropdown">
                <option value="bookings">Ieraksti</option>
                <option value="availability">Pieejamība</option>
                <option value="settings">Iestatījumi</option>
                <option value="data">Dati</option>
            </select>
        </div>

        <!-- Desktop Navigation Tabs -->
        <nav class="admin-nav">
            <div class="admin-nav-inner">
                <button class="admin-tab active" data-tab="bookings">
                    <i class="ph ph-calendar-check"></i>
                    <span>Ieraksti</span>
                </button>
                <button class="admin-tab" data-tab="availability">
                    <i class="ph ph-clock"></i>
                    <span>Pieejamība</span>
                </button>
                <button class="admin-tab" data-tab="settings">
                    <i class="ph ph-gear"></i>
                    <span>Iestatījumi</span>
                </button>
                <button class="admin-tab" data-tab="data">
                    <i class="ph ph-database"></i>
                    <span>Dati</span>
                </button>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Bookings Tab -->
            <div id="tab-bookings" class="admin-content">
                <div class="content-header">
                    <h2 class="content-title">Klientu ieraksti</h2>
                    <div class="calendar-controls">
                        <button id="prev-month" class="cal-nav-btn" title="Iepriekšējais mēnesis">
                            <i class="ph ph-caret-left"></i>
                        </button>
                        <span id="current-month" class="calendar-month"></span>
                        <button id="next-month" class="cal-nav-btn" title="Nākamais mēnesis">
                            <i class="ph ph-caret-right"></i>
                        </button>
                        <button id="today-btn" class="btn-primary btn-sm">Šodien</button>
                        <button id="refresh-bookings" class="cal-nav-btn" title="Atjaunot">
                            <i class="ph ph-arrows-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- Calendar Legend -->
                <div class="calendar-legend">
                    <div class="legend-item"><span class="legend-box legend-available"></span><span>Pieejama</span></div>
                    <div class="legend-item"><span class="legend-box legend-booked"></span><span>Ieraksti</span></div>
                    <div class="legend-item"><span class="legend-box legend-weekend"></span><span>Brīvdiena</span></div>
                    <div class="legend-item"><span class="legend-box legend-holiday"></span><span>Svētki</span></div>
                    <div class="legend-item"><span class="legend-dot legend-confirmed"></span><span>Apstiprināts</span></div>
                    <div class="legend-item"><span class="legend-dot legend-pending"></span><span>Gaida</span></div>
                    <div class="legend-item"><span class="legend-dot legend-cancelled"></span><span>Atcelts</span></div>
                </div>

                <div id="bookings-loading" class="loading-state">
                    <div class="loading-spinner"></div>
                    <span>Ielādē ierakstus...</span>
                </div>

                <div id="calendar-container" class="calendar-wrapper hidden">
                    <div class="calendar-card">
                        <div class="calendar-header-row">
                            <div class="calendar-day-name">Pr</div>
                            <div class="calendar-day-name">Ot</div>
                            <div class="calendar-day-name">Tr</div>
                            <div class="calendar-day-name">Ce</div>
                            <div class="calendar-day-name">Pk</div>
                            <div class="calendar-day-name weekend">Se</div>
                            <div class="calendar-day-name weekend">Sv</div>
                        </div>
                        <div id="calendar-grid" class="calendar-grid"></div>
                    </div>
                </div>

                <div id="day-details" class="day-details-panel hidden">
                    <div class="day-details-card">
                        <div class="day-details-header">
                            <h3 id="day-details-title"></h3>
                            <button id="close-day-details" class="btn-close">
                                <i class="ph ph-x"></i>
                            </button>
                        </div>
                        <div id="day-bookings-list" class="bookings-list"></div>
                    </div>
                </div>
            </div>

            <!-- Availability Tab -->
            <div id="tab-availability" class="admin-content hidden">
                <div class="content-header"><h2 class="content-title">Darba laiki</h2></div>
                <p class="content-subtitle">Iestatiet pieejamos laikus katrai nedēļas dienai</p>

                <div class="card">
                    <div id="availability-form" class="availability-form"></div>
                    <div class="card-footer">
                        <button id="save-availability" class="btn-primary">
                            <i class="ph ph-floppy-disk"></i>
                            <span>Saglabāt</span>
                        </button>
                    </div>
                </div>

                <div class="section-divider"></div>
                <div class="content-header"><h2 class="content-title">Atvaļinājuma periodi</h2></div>
                <p class="content-subtitle">Iestatiet periodus, kad esat atvaļinājumā</p>
                
                <div class="card">
                    <div class="vacation-form">
                        <input type="date" id="vacation-start" class="input-field" placeholder="Sākuma datums">
                        <input type="date" id="vacation-end" class="input-field" placeholder="Beigu datums">
                        <input type="text" id="vacation-reason" placeholder="Piezīmes (neobligāti)" class="input-field input-flex">
                        <button id="add-vacation" class="btn-primary">
                            <i class="ph ph-calendar-x"></i>
                            <span>Pievienot atvaļinājumu</span>
                        </button>
                    </div>
                    <div id="vacation-list" class="blocked-list"></div>
                </div>

                <div class="section-divider"></div>
                <div class="content-header"><h2 class="content-title">Bloķētie datumi</h2></div>
                <p class="content-subtitle">Pievienojiet atsevišķus datumus, kad nepieņemat klientus</p>
                
                <div class="card">
                    <div class="blocked-date-form">
                        <input type="date" id="block-date" class="input-field">
                        <input type="text" id="block-reason" placeholder="Iemesls" class="input-field input-flex">
                        <button id="add-blocked-date" class="btn-danger">
                            <i class="ph ph-plus"></i>
                            <span>Pievienot</span>
                        </button>
                    </div>
                    <div id="blocked-dates-list" class="blocked-list"></div>
                </div>

                <div class="section-divider"></div>
                <div class="content-header"><h2 class="content-title">Latvijas valsts svētki</h2></div>
                <p class="content-subtitle">Šajos datumos automātiski netiek pieņemti ieraksti</p>
                
                <div class="card">
                    <div class="holidays-controls">
                        <select id="holiday-year" class="input-field">
                            <option value="2026">2026</option>
                            <option value="2027">2027</option>
                        </select>
                        <button id="refresh-holidays" class="btn-secondary">
                            <i class="ph ph-arrows-clockwise"></i>
                            <span>Atjaunot</span>
                        </button>
                    </div>
                    <div id="holidays-list" class="holidays-grid"></div>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="tab-settings" class="admin-content hidden">
                <div class="content-header"><h2 class="content-title">Vietnes iestatījumi</h2></div>

                <div class="settings-grid">
                    <div class="card">
                        <h3 class="card-title"><i class="ph ph-currency-eur"></i> Cenas</h3>
                        <div class="form-group">
                            <label class="form-label">Pirmreizējā konsultācija (€)</label>
                            <input type="number" id="price-initial" class="input-field" value="65">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Atkārtota konsultācija (€)</label>
                            <input type="number" id="price-followup" class="input-field" value="45">
                        </div>
                    </div>

                    <div class="card">
                        <h3 class="card-title"><i class="ph ph-phone"></i> Kontaktinformācija</h3>
                        <div class="form-group">
                            <label class="form-label">E-pasts</label>
                            <input type="email" id="contact-email" class="input-field" value="sofija@nutrition.lv">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Telefons</label>
                            <input type="tel" id="contact-phone" class="input-field" value="+371 20000000">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Adrese</label>
                            <input type="text" id="contact-address" class="input-field" value="Rīga, Latvija">
                        </div>
                    </div>

                    <div class="card">
                        <h3 class="card-title"><i class="ph ph-timer"></i> Konsultāciju ilgums</h3>
                        <div class="form-group">
                            <label class="form-label">Pirmreizējā (minūtes)</label>
                            <input type="number" id="duration-initial" class="input-field" value="60">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Atkārtota (minūtes)</label>
                            <input type="number" id="duration-followup" class="input-field" value="30">
                        </div>
                    </div>

                    <div class="card">
                        <h3 class="card-title"><i class="ph ph-bank"></i> Maksājumu informācija</h3>
                        <div class="form-group">
                            <label class="form-label">Bankas nosaukums</label>
                            <input type="text" id="bank-name" class="input-field" value="Swedbank">
                        </div>
                        <div class="form-group">
                            <label class="form-label">IBAN</label>
                            <input type="text" id="bank-iban" class="input-field" value="LV00HABA0000000000000">
                        </div>
                    </div>
                </div>

                <div class="settings-actions">
                    <button id="save-settings" class="btn-primary">
                        <i class="ph ph-floppy-disk"></i>
                        <span>Saglabāt iestatījumus</span>
                    </button>
                </div>
            </div>

            <!-- Data Tab -->
            <div id="tab-data" class="admin-content hidden">
                <div class="content-header">
                    <h2 class="content-title">Azure Table Storage</h2>
                    <div class="data-controls">
                        <select id="table-select" class="input-field">
                            <option value="bookings">bookings</option>
                            <option value="adminSettings">adminSettings</option>
                        </select>
                        <button id="refresh-table" class="btn-secondary">
                            <i class="ph ph-arrows-clockwise"></i>
                        </button>
                        <button id="export-csv" class="btn-info">
                            <i class="ph ph-download-simple"></i>
                            <span>CSV</span>
                        </button>
                    </div>
                </div>

                <div id="table-loading" class="loading-state">
                    <div class="loading-spinner"></div>
                    <span>Ielādē datus...</span>
                </div>

                <div id="table-container" class="hidden">
                    <div class="card table-card">
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead id="table-header"></thead>
                                <tbody id="table-body"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="table-footer"><span id="table-count">0</span> ieraksti</div>
                </div>

                <div id="table-empty" class="hidden empty-state">
                    <i class="ph ph-tray empty-icon"></i>
                    <span>Tabula ir tukša</span>
                </div>
            </div>
        </main>

        <!-- Toast Notifications Container -->
        <div id="toast-container" class="toast-container"></div>
    </div>

    <style is:global>
        :root {
            --color-primary: #1B4332;
            --color-secondary: #D4A574;
            --color-accent: #2D6A4F;
            --color-text: #374151;
            --color-text-light: #6b7280;
            --color-muted: #9ca3af;
            --color-bg: #FDFBF7;
            --color-white: #FFFFFF;
            --color-cream: #F8F6F1;
            --color-border: #e5e7eb;
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
            --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
            --radius: 16px;
            --radius-md: 12px;
            --radius-sm: 8px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        .admin-wrapper {
            min-height: 100vh;
            background: var(--color-bg);
            font-family: var(--font-sans);
            color: var(--color-text);
            font-size: 16px;
        }

        /* Header */
        .admin-header {
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
            padding: 16px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .admin-header-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .admin-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .admin-logo-img { height: 36px; width: auto; }

        .admin-logo-text { display: flex; flex-direction: column; }

        .admin-logo-name {
            font-family: var(--font-serif);
            font-size: 20px;
            font-weight: 600;
            color: var(--color-primary);
            line-height: 1.2;
        }

        .admin-logo-sub {
            font-size: 11px;
            color: var(--color-text-light);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .admin-user-name {
            font-size: 14px;
            color: var(--color-text-light);
            display: none;
        }

        .admin-logout {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: var(--color-text-light);
            text-decoration: none;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            transition: all 0.2s;
        }

        .admin-logout:hover {
            background: #fef2f2;
            color: #dc2626;
        }

        /* Mobile Tab Select */
        .mobile-tab-select {
            display: block;
            padding: 16px 20px;
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
        }

        .mobile-tab-dropdown {
            width: 100%;
            padding: 14px 16px;
            font-size: 16px;
            font-family: var(--font-sans);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-white);
            color: var(--color-text);
            cursor: pointer;
        }

        .mobile-tab-dropdown:focus {
            outline: none;
            border-color: var(--color-primary);
        }

        /* Desktop Navigation */
        .admin-nav {
            display: none;
            background: var(--color-white);
            border-bottom: 1px solid var(--color-border);
        }

        .admin-nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            gap: 4px;
            padding: 0 20px;
            overflow-x: auto;
        }

        .admin-tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 16px 20px;
            border: none;
            background: none;
            font-family: var(--font-sans);
            font-size: 14px;
            font-weight: 500;
            color: var(--color-text-light);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .admin-tab i { font-size: 18px; }

        .admin-tab:hover {
            color: var(--color-primary);
            background: var(--color-cream);
        }

        .admin-tab.active {
            color: var(--color-primary);
            border-bottom-color: var(--color-secondary);
        }

        /* Main Content */
        .admin-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .admin-content { animation: fadeIn 0.2s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hidden { display: none !important; }

        /* Content Header */
        .content-header {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 20px;
        }

        .content-title {
            font-family: var(--font-serif);
            font-size: 28px;
            font-weight: 600;
            color: var(--color-primary);
        }

        .content-subtitle {
            font-size: 15px;
            color: var(--color-text-light);
            margin: 0 0 20px 0;
        }

        /* Calendar Controls */
        .calendar-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        .calendar-month {
            font-family: var(--font-serif);
            font-weight: 600;
            font-size: 18px;
            min-width: 160px;
            text-align: center;
            color: var(--color-primary);
        }

        .cal-nav-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            background: var(--color-white);
            cursor: pointer;
            transition: all 0.2s;
            color: var(--color-text);
        }

        .cal-nav-btn:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .cal-nav-btn i { font-size: 18px; }

        /* Buttons */
        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: var(--color-primary);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary:hover {
            background: var(--color-accent);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .btn-primary.btn-sm {
            padding: 10px 16px;
            font-size: 14px;
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: var(--color-white);
            color: var(--color-text);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-secondary:hover {
            background: var(--color-cream);
            border-color: var(--color-primary);
        }

        .btn-danger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-danger:hover { background: #fee2e2; }

        .btn-info {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
            border-radius: var(--radius-sm);
            font-family: var(--font-sans);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-info:hover { background: #dbeafe; }

        .btn-close {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: var(--color-cream);
            border-radius: 50%;
            cursor: pointer;
            color: var(--color-text-light);
            transition: all 0.2s;
        }

        .btn-close:hover {
            background: #fee2e2;
            color: #dc2626;
        }

        .btn-close i { font-size: 18px; }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 12px;
            pointer-events: none;
        }

        .toast {
            pointer-events: auto;
            min-width: 300px;
            max-width: 400px;
            background: var(--color-white);
            border-radius: var(--radius-sm);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            padding: 16px 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideIn 0.3s ease-out;
            border-left: 4px solid var(--color-primary);
        }

        .toast.success { border-left-color: #22c55e; }
        .toast.error { border-left-color: #ef4444; }
        .toast.warning { border-left-color: #f59e0b; }
        .toast.info { border-left-color: #3b82f6; }

        .toast-icon {
            font-size: 24px;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .toast.success .toast-icon { color: #22c55e; }
        .toast.error .toast-icon { color: #ef4444; }
        .toast.warning .toast-icon { color: #f59e0b; }
        .toast.info .toast-icon { color: #3b82f6; }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-weight: 600;
            font-size: 15px;
            color: var(--color-primary);
            margin-bottom: 4px;
        }

        .toast-message {
            font-size: 14px;
            color: var(--color-text-light);
        }

        .toast-close {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: transparent;
            border-radius: 50%;
            cursor: pointer;
            color: var(--color-text-light);
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .toast-close:hover {
            background: var(--color-cream);
            color: var(--color-text);
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(100px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes slideOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }
            to {
                opacity: 0;
                transform: translateX(100px);
            }
        }

        .toast.removing {
            animation: slideOut 0.3s ease-out forwards;
        }

        /* Cards */
