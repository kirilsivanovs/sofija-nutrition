    <script is:inline>
    (function() {
        const API_BASE = window.location.hostname === 'localhost' 
            ? 'http://localhost:7071/api' 
            : 'https://sofija-nutrition-api.azurewebsites.net/api';
        
        // E2E Test Token Support
        // Если в URL есть ?e2e_token=xxx, проверяем его и сохраняем
        const urlParams = new URLSearchParams(window.location.search);
        const e2eToken = urlParams.get('e2e_token') || sessionStorage.getItem('e2e_token');
        
        if (e2eToken) {
            sessionStorage.setItem('e2e_token', e2eToken);
            // Убираем токен из URL для безопасности
            if (urlParams.has('e2e_token')) {
                urlParams.delete('e2e_token');
                const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
                window.history.replaceState({}, '', newUrl);
            }
        }
        
        // Функция для добавления токена к API запросам
        window.getAuthHeaders = function() {
            const headers = { 'Content-Type': 'application/json' };
            const token = sessionStorage.getItem('e2e_token');
            if (token) {
                headers['X-E2E-Token'] = token;
            }
            return headers;
        };
        
        let currentDate = new Date();
        let allBookings = [];
        let holidays = {};
        let schedule = {};
        let blockedDates = new Set();
        let vacationPeriods = [];
        const dayNamesForSchedule = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
        const monthNames = ['Janvāris', 'Februāris', 'Marts', 'Aprīlis', 'Maijs', 'Jūnijs', 'Jūlijs', 'Augusts', 'Septembris', 'Oktobris', 'Novembris', 'Decembris'];

        // Toast notification system
        function showToast(message, type = 'info', title = null) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icons = {
                success: 'ph-check-circle',
                error: 'ph-warning-circle',
                warning: 'ph-warning',
                info: 'ph-info'
            };
            
            const titles = {
                success: title || 'Veiksmīgi',
                error: title || 'Kļūda',
                warning: title || 'Brīdinājums',
                info: title || 'Informācija'
            };
            
            toast.innerHTML = `
                <i class="ph ${icons[type]} toast-icon"></i>
                <div class="toast-content">
                    <div class="toast-title">${titles[type]}</div>
                    <div class="toast-message">${message}</div>
                </div>
                <button class="toast-close"><i class="ph ph-x"></i></button>
            `;
            
            container.appendChild(toast);
            
            // Close button
            toast.querySelector('.toast-close').addEventListener('click', () => {
                removeToast(toast);
            });
            
            // Auto remove after 4 seconds
            setTimeout(() => {
                removeToast(toast);
            }, 4000);
        }
        
        function removeToast(toast) {
            toast.classList.add('removing');
            setTimeout(() => {
                toast.remove();
            }, 300);
        }

        // Date formatting functions
        function formatDate(dateStr) {
            // Convert yyyy-mm-dd to dd/mm/yyyy
            if (!dateStr) return '';
            const [year, month, day] = dateStr.split('-');
            return `${day}/${month}/${year}`;
        }

        function formatDateReverse(dateStr) {
            // Convert dd/mm/yyyy to yyyy-mm-dd
            if (!dateStr) return '';
            const [day, month, year] = dateStr.split('/');
            return `${year}-${month}-${day}`;
        }

        function formatTime(timeStr) {
            // Ensure time is in 24-hour format HH:MM
            if (!timeStr) return '';
            // If already in correct format, return as is
            if (timeStr.match(/^\d{2}:\d{2}$/)) return timeStr;
            // Otherwise parse and format
            const [hours, minutes] = timeStr.split(':');
            return `${hours.padStart(2, '0')}:${minutes.padStart(2, '0')}`;
        }


        function isDateInVacation(dateStr) {
            return vacationPeriods.some(v => dateStr >= v.startDate && dateStr <= v.endDate);
        }

        // Проверяем авторизацию - Microsoft OAuth или E2E Token
        const e2eTokenStored = sessionStorage.getItem('e2e_token');
        if (e2eTokenStored) {
            // E2E режим - проверяем токен через API
            fetch(API_BASE + '/test/auth', {
                headers: { 'X-E2E-Token': e2eTokenStored }
            }).then(r => r.json()).then(data => {
                if (data.clientPrincipal) {
                    document.getElementById('user-info').textContent = data.clientPrincipal.userDetails + ' (E2E)';
                }
            }).catch(() => {
                // Токен невалиден - очищаем
                sessionStorage.removeItem('e2e_token');
            });
        } else {
            // Стандартная Microsoft авторизация
            fetch('/.auth/me').then(r => r.json()).then(data => {
                if (data.clientPrincipal) {
                    document.getElementById('user-info').textContent = data.clientPrincipal.userDetails || data.clientPrincipal.userId;
                }
            }).catch(() => {});
        }

        const tabBtns = document.querySelectorAll('.admin-tab');
        const tabContents = document.querySelectorAll('.admin-content');
        const mobileSelect = document.getElementById('mobile-tab-selector');

        function switchTab(tabId) {
            tabBtns.forEach(b => b.classList.remove('active'));
            const activeBtn = document.querySelector(`.admin-tab[data-tab="${tabId}"]`);
            if (activeBtn) activeBtn.classList.add('active');
            tabContents.forEach(c => c.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            mobileSelect.value = tabId;
            if (tabId === 'bookings') loadCalendar();
            if (tabId === 'availability') loadAvailability();
            if (tabId === 'settings') loadSettings();
            if (tabId === 'data') loadTableData();
        }

        tabBtns.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
        mobileSelect.addEventListener('change', e => switchTab(e.target.value));

        document.getElementById('prev-month').addEventListener('click', () => { currentDate.setDate(1); currentDate.setMonth(currentDate.getMonth() - 1); loadCalendar(); });
        document.getElementById('next-month').addEventListener('click', () => { currentDate.setDate(1); currentDate.setMonth(currentDate.getMonth() + 1); loadCalendar(); });
        document.getElementById('today-btn').addEventListener('click', () => { currentDate = new Date(); loadCalendar(); });
        document.getElementById('refresh-bookings').addEventListener('click', loadCalendar);
        document.getElementById('close-day-details').addEventListener('click', () => document.getElementById('day-details').classList.add('hidden'));

        async function loadCalendar() {
            const loading = document.getElementById('bookings-loading');
            const container = document.getElementById('calendar-container');
            loading.classList.remove('hidden');
            container.classList.add('hidden');
            document.getElementById('day-details').classList.add('hidden');
            document.getElementById('current-month').textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;

            try {
                const year = currentDate.getFullYear();
                const [bookingsRes, holidaysRes, availabilityRes] = await Promise.all([
                    fetch(API_BASE + '/dashboard/bookings'),
                    fetch(API_BASE + '/holidays?year=' + year),
                    fetch(API_BASE + '/dashboard/availability')
                ]);
                const bookingsData = await bookingsRes.json();
                const holidaysData = await holidaysRes.json();
                const availabilityData = await availabilityRes.json();
                allBookings = bookingsData.bookings || [];
                holidays = {};
                if (holidaysData.holidays) holidaysData.holidays.forEach(h => { holidays[h.date] = h.name; });
                schedule = availabilityData.schedule || {};
                blockedDates = new Set((availabilityData.blockedDates || []).map(d => d.date));
                vacationPeriods = availabilityData.vacationPeriods || [];
                console.log('📅 Loaded vacation periods:', vacationPeriods);
                renderCalendar();
                loading.classList.add('hidden');
                container.classList.remove('hidden');
            } catch (error) {
                loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>';
            }
        }

        // Находит ближайшую будущую запись и переключает календарь на этот месяц
        async function navigateToFirstUpcomingBooking() {
            try {
                const response = await fetch(API_BASE + '/dashboard/bookings');
                const data = await response.json();
                const bookings = data.bookings || [];
                
                const today = new Date();
                const todayStr = today.toISOString().split('T')[0];
                
                // Находим ближайшую будущую запись (не отменённую)
                const upcomingBookings = bookings
                    .filter(b => b.date >= todayStr && b.status !== 'cancelled')
                    .sort((a, b) => a.date.localeCompare(b.date));
                
                if (upcomingBookings.length > 0) {
                    const firstBooking = upcomingBookings[0];
                    const bookingDate = new Date(firstBooking.date);
                    
                    // Если запись в другом месяце - переключаемся
                    if (bookingDate.getMonth() !== today.getMonth() || bookingDate.getFullYear() !== today.getFullYear()) {
                        currentDate = new Date(bookingDate.getFullYear(), bookingDate.getMonth(), 1);
                        console.log(`📅 Переключено на месяц с ближайшей записью: ${firstBooking.date}`);
                    }
                }
            } catch (error) {
                console.error('Ошибка при поиске ближайших записей:', error);
            }
        }

        function renderCalendar() {
            const grid = document.getElementById('calendar-grid');
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();
            let startDay = firstDay.getDay() - 1;
            if (startDay < 0) startDay = 6;
            const bookingsByDate = {};
            allBookings.forEach(b => { if (!bookingsByDate[b.date]) bookingsByDate[b.date] = []; bookingsByDate[b.date].push(b); });
            const today = new Date();
            const todayStr = today.toISOString().split('T')[0];
            
            console.log('📅 Rendering calendar:', { year, month: month + 1, totalBookings: allBookings.length, scheduleLoaded: !!schedule });
            console.log('📋 Schedule object:', schedule);
            console.log('🎉 Holidays:', Object.keys(holidays).length, holidays);
            console.log('🚫 Blocked dates:', blockedDates.size);
            
            let html = '';
            for (let i = 0; i < startDay; i++) html += '<div class="calendar-cell empty"></div>';
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isToday = dateStr === todayStr;
                const isHoliday = holidays[dateStr];
                const dayBookings = bookingsByDate[dateStr] || [];
                const dayOfWeek = (startDay + day - 1) % 7;
                const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;
                const isBlocked = blockedDates.has(dateStr);
                const isVacation = isDateInVacation(dateStr);
                const checkDate = new Date(year, month, day);
                const scheduleDayName = dayNamesForSchedule[checkDate.getDay()];
                const daySchedule = schedule[scheduleDayName];
                const isWorkingDay = daySchedule && daySchedule.enabled;
                const pending = dayBookings.filter(b => !b.paymentConfirmed && b.status !== 'cancelled').length;
                const confirmed = dayBookings.filter(b => b.paymentConfirmed && b.status !== 'cancelled').length;
                const cancelled = dayBookings.filter(b => b.status === 'cancelled').length;
                const totalCount = dayBookings.length;
                
                let cellClass = 'calendar-cell';
                if (isHoliday || isBlocked || isVacation) cellClass += ' holiday';
                else if (isWeekend || !isWorkingDay) cellClass += ' weekend';
                else if (confirmed > 0 || pending > 0) cellClass += ' booked';
                else cellClass += ' available';
                
                html += `<div class="${cellClass}" onclick="showDayDetails('${dateStr}')" title="${formatDate(dateStr)}">
                    <div class="day-number ${isToday ? 'today' : ''}">${day}</div>
                    ${isHoliday ? `<div class="holiday-name">${isHoliday}</div>` : ''}
                    ${isVacation && !isHoliday ? '<div class="holiday-name">Atvaļinājums</div>' : ''}
                    ${isBlocked && !isHoliday && !isVacation ? '<div class="holiday-name">Bloķēts</div>' : ''}
                    ${!isHoliday && !isBlocked && !isVacation && isWorkingDay && !isWeekend && daySchedule ? `<div class="day-time"><i class="ph ph-clock"></i>${formatTime(daySchedule.start)}–${formatTime(daySchedule.end)}</div>` : ''}
                    ${totalCount > 0 ? `<div class="booking-count">${totalCount}</div>` : ''}
                    ${(pending > 0 || confirmed > 0 || cancelled > 0) ? `<div class="booking-dots">
                        ${confirmed > 0 ? `<div class="booking-dot confirmed"><span></span>${confirmed}</div>` : ''}
                        ${pending > 0 ? `<div class="booking-dot pending"><span></span>${pending}</div>` : ''}
                        ${cancelled > 0 ? `<div class="booking-dot cancelled"><span></span>${cancelled}</div>` : ''}
                    </div>` : ''}
                </div>`;
            }
            const totalCells = startDay + daysInMonth;
            const remainingCells = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
            for (let i = 0; i < remainingCells; i++) html += '<div class="calendar-cell empty"></div>';
            grid.innerHTML = html;
        }

        window.showDayDetails = function(dateStr) {
            const details = document.getElementById('day-details');
            const title = document.getElementById('day-details-title');
            const list = document.getElementById('day-bookings-list');
            const date = new Date(dateStr);
            const dayNames = ['Svētdiena', 'Pirmdiena', 'Otrdiena', 'Trešdiena', 'Ceturtdiena', 'Piektdiena', 'Sestdiena'];
            title.textContent = `${dayNames[date.getDay()]}, ${formatDate(dateStr)}`;
            const holidayName = holidays[dateStr];
            const dayBookings = allBookings.filter(b => b.date === dateStr);
            
            let html = '';
            if (holidayName) {
                html += `<div class="booking-card" style="border-left-color:#3b82f6;background:#eff6ff;">
                    <div class="booking-details">
                        <div><i class="ph ph-flag"></i><strong>Valsts svētki:</strong> ${holidayName}</div>
                    </div>
                </div>`;
            }
            
            if (dayBookings.length === 0 && !holidayName) {
                html += '<div class="loading-state" style="padding:40px;"><i class="ph ph-calendar-x" style="font-size:32px;color:var(--color-muted);"></i><span>Nav ierakstu šajā dienā</span></div>';
            } else {
                // Группируем записи по статусу
                const confirmedBookings = dayBookings.filter(b => b.paymentConfirmed && b.status !== 'cancelled');
                const pendingBookings = dayBookings.filter(b => !b.paymentConfirmed && b.status !== 'cancelled');
                const cancelledBookings = dayBookings.filter(b => b.status === 'cancelled');
                
                // Функция для рендеринга группы
                const renderGroup = (bookings, title, icon, color) => {
                    if (bookings.length === 0) return '';
                    bookings.sort((a, b) => a.time.localeCompare(b.time));
                    return `
                        <div class="bookings-group">
                            <h4 class="group-title" style="color:${color};">
                                <i class="ph ${icon}"></i>
                                ${title} (${bookings.length})
                            </h4>
                            ${bookings.map(b => `
                                <div class="booking-card ${b.status || (b.paymentConfirmed ? 'confirmed' : 'pending')}">
                                    <div class="booking-header">
                                        <div class="booking-info">
                                            <div class="booking-name">${b.name}</div>
                                            <span class="booking-status ${b.status || (b.paymentConfirmed ? 'confirmed' : 'pending')}">
                                                ${b.status === 'cancelled' ? 'Atcelts' : b.paymentConfirmed ? 'Apstiprināts' : 'Gaida'}
                                            </span>
                                        </div>
                                        <span class="booking-time">${formatTime(b.time)}</span>
                                    </div>
                                    <div class="booking-details">
                                        <div><i class="ph ph-clipboard-text"></i>${getServiceName(b.service)}</div>
                                        <div><i class="ph ${b.consultationFormat === 'online' ? 'ph-video-camera' : 'ph-map-pin'}"></i>${b.consultationFormat === 'online' ? 'Online' : 'Klātienē'}</div>
                                        <div><i class="ph ph-envelope"></i>${b.email}</div>
                                        ${b.phone ? `<div><i class="ph ph-phone"></i>${b.phone}</div>` : ''}
                                        ${b.message ? `<div><i class="ph ph-note"></i>${b.message}</div>` : ''}
                                        <div><i class="ph ph-currency-eur"></i>€${b.price || 0}</div>
                                    </div>
                                    <div class="booking-actions">
                                        ${!b.paymentConfirmed && b.status !== 'cancelled' ? `<button onclick="confirmBooking('${b.id}')" class="btn-primary btn-sm"><i class="ph ph-check"></i> Apstiprināt</button>` : ''}
                                        ${b.status !== 'cancelled' ? `<button onclick="cancelBooking('${b.id}')" class="btn-danger btn-sm"><i class="ph ph-x"></i> Atcelt</button>` : ''}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    `;
                };
                
                html += renderGroup(confirmedBookings, 'Apstiprinātie', 'ph-check-circle', '#22c55e');
                html += renderGroup(pendingBookings, 'Gaida apstiprinājumu', 'ph-clock', '#facc15');
                html += renderGroup(cancelledBookings, 'Atcelti', 'ph-x-circle', '#ef4444');
            }
            list.innerHTML = html;
            details.classList.remove('hidden');
            details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        function getStatusText(status) {
            switch(status) { 
                case 'confirmed': return 'Apstiprināts'; 
                case 'pending': return 'Gaida'; 
                case 'cancelled': return 'Atcelts'; 
                default: return status; 
            }
        }

        function getServiceName(service) {
            const services = {
                'cgm-diagnostic': 'CGM diagnostika',
                'consultation': 'Uztura konsultācija',
                'initial': 'Pirmreizējā konsultācija',
                'followup': 'Atkārtota konsultācija',
                'package3': '3 konsultāciju pakete',
                'package5': '5 konsultāciju pakete'
            };
            return services[service] || service;
        }

        window.confirmBooking = async function(id) {
            if (!confirm('Apstiprināt šo ierakstu?')) return;
            try { await fetch(API_BASE + '/dashboard/bookings/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'confirmed' }) }); loadCalendar(); showToast('Ieraksts apstiprināts', 'success'); } catch (e) { showToast(e.message, 'error'); }
        };

        window.cancelBooking = async function(id) {
            if (!confirm('Atcelt šo ierakstu?')) return;
            try { await fetch(API_BASE + '/dashboard/bookings/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'cancelled' }) }); loadCalendar(); showToast('Ieraksts atcelts', 'success'); } catch (e) { showToast(e.message, 'error'); }
        };

        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
        const dayNames = { monday: 'Pirmdiena', tuesday: 'Otrdiena', wednesday: 'Trešdiena', thursday: 'Ceturtdiena', friday: 'Piektdiena', saturday: 'Sestdiena', sunday: 'Svētdiena' };

        function loadAvailability() {
            const form = document.getElementById('availability-form');
            form.innerHTML = days.map(day => `<div class="availability-day"><div class="availability-day-header"><span class="availability-day-name">${dayNames[day]}</span><label style="display:flex;align-items:center;gap:8px;cursor:pointer;"><input type="checkbox" id="day-${day}-enabled" checked style="width:18px;height:18px;accent-color:var(--color-primary);"><span style="font-size:14px;color:var(--color-text-light);">Aktīva</span></label></div><div class="availability-day-times"><input type="time" id="day-${day}-start" value="09:00" step="60" class="input-field"><span style="color:var(--color-muted);">—</span><input type="time" id="day-${day}-end" value="17:00" step="60" class="input-field"></div></div>`).join('');
            document.getElementById('day-saturday-enabled').checked = false;
            document.getElementById('day-sunday-enabled').checked = false;
            fetch(API_BASE + '/dashboard/availability').then(r => r.json()).then(data => {
                if (data.schedule) Object.entries(data.schedule).forEach(([day, config]) => {
                    const checkbox = document.getElementById(`day-${day}-enabled`);
                    const startInput = document.getElementById(`day-${day}-start`);
                    const endInput = document.getElementById(`day-${day}-end`);
                    if (checkbox) checkbox.checked = config.enabled;
                    if (startInput) startInput.value = config.start || '09:00';
                    if (endInput) endInput.value = config.end || '17:00';
                });
                if (data.blockedDates) renderBlockedDates(data.blockedDates);
                if (data.vacationPeriods) renderVacationPeriods(data.vacationPeriods);
            }).catch(() => {});
            loadHolidays();
        }

        function renderVacationPeriods(periods) {
            const list = document.getElementById('vacation-list');
            if (!periods || periods.length === 0) { 
                list.innerHTML = '<p style="color:var(--color-text-light);font-size:14px;">Nav atvaļinājuma periodu</p>'; 
                return; 
            }
            list.innerHTML = periods.map(v => `
                <div class="blocked-item" style="background:#eff6ff;">
                    <span>
                        <strong>${formatDate(v.startDate)}</strong> — <strong>${formatDate(v.endDate)}</strong>
                        ${v.reason ? '<span style="color:var(--color-text-light);margin-left:12px;">' + v.reason + '</span>' : ''}
                    </span>
                    <button onclick="removeVacation('${v.id}')" class="btn-close" style="width:28px;height:28px;">
                        <i class="ph ph-x"></i>
                    </button>
                </div>
            `).join('');
        }

        function renderBlockedDates(dates) {
            const list = document.getElementById('blocked-dates-list');
            if (!dates || dates.length === 0) { list.innerHTML = '<p style="color:var(--color-text-light);font-size:14px;">Nav bloķētu datumu</p>'; return; }
            list.innerHTML = dates.map(d => `<div class="blocked-item"><span>${formatDate(d.date)} ${d.reason ? '— ' + d.reason : ''}</span><button onclick="removeBlockedDate('${d.date}')" class="btn-close" style="width:28px;height:28px;"><i class="ph ph-x"></i></button></div>`).join('');
        }

        document.getElementById('save-availability').addEventListener('click', async () => {
            const scheduleData = {};
            days.forEach(day => { scheduleData[day] = { enabled: document.getElementById(`day-${day}-enabled`).checked, start: document.getElementById(`day-${day}-start`).value, end: document.getElementById(`day-${day}-end`).value }; });
            try { await fetch(API_BASE + '/dashboard/availability', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ schedule: scheduleData }) }); showToast('Pieejamība saglabāta!', 'success'); } catch (e) { showToast(e.message, 'error'); }
        });

        document.getElementById('add-vacation').addEventListener('click', async () => {
            const startDate = document.getElementById('vacation-start').value;
            const endDate = document.getElementById('vacation-end').value;
            const reason = document.getElementById('vacation-reason').value;
            if (!startDate || !endDate) return showToast('Izvēlieties sākuma un beigu datumus', 'warning');
            if (new Date(startDate) > new Date(endDate)) return showToast('Sākuma datums nevar būt vēlāks par beigu datumu', 'warning');
            try { 
                console.log('💼 Adding vacation:', { startDate, endDate, reason });
                const response = await fetch(API_BASE + '/dashboard/availability/vacation', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ startDate, endDate, reason }) 
                });
                const result = await response.json();
                console.log('✅ Vacation added:', result);
                loadAvailability(); 
                loadCalendar();
                document.getElementById('vacation-start').value = ''; 
                document.getElementById('vacation-end').value = ''; 
                document.getElementById('vacation-reason').value = ''; 
                showToast('Atvaļinājums pievienots!', 'success');
            } catch (e) { 
                console.error('❌ Error adding vacation:', e);
                showToast(e.message, 'error'); 
            }
        });

        window.removeVacation = async function(id) {
            if (!confirm('Dzēst šo atvaļinājuma periodu?')) return;
            try { 
                await fetch(API_BASE + '/dashboard/availability/vacation', { 
                    method: 'DELETE', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ id }) 
                }); 
                loadAvailability(); 
                loadCalendar();
                showToast('Atvaļinājums dzēsts', 'success');
            } catch (e) { showToast(e.message, 'error'); }
        };

        // Auto-set vacation end date min when start date is selected
        document.getElementById('vacation-start').addEventListener('change', function() {
            const startDate = this.value;
            const endDateInput = document.getElementById('vacation-end');
            if (startDate) {
                // Set minimum date for end date to be same as start date
                endDateInput.min = startDate;
                // If end date is not set or is before start date, set it to start date
                if (!endDateInput.value || endDateInput.value < startDate) {
                    endDateInput.value = startDate;
                }
            }
        });

        document.getElementById('add-blocked-date').addEventListener('click', async () => {
            const date = document.getElementById('block-date').value;
            const reason = document.getElementById('block-reason').value;
            if (!date) return showToast('Izvēlieties datumu', 'warning');
            try { await fetch(API_BASE + '/dashboard/availability/block', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ date, reason }) }); loadAvailability(); document.getElementById('block-date').value = ''; document.getElementById('block-reason').value = ''; showToast('Datums bloķēts', 'success'); } catch (e) { showToast(e.message, 'error'); }
        });

        window.removeBlockedDate = async function(date) {
            try { await fetch(API_BASE + '/dashboard/availability/block', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ date }) }); loadAvailability(); showToast('Bloķēšana noņemta', 'success'); } catch (e) { showToast(e.message, 'error'); }
        };

        function loadSettings() {
            fetch(API_BASE + '/dashboard/settings').then(r => r.json()).then(data => {
                if (data.prices) { document.getElementById('price-initial').value = data.prices.initial || 65; document.getElementById('price-followup').value = data.prices.followup || 45; }
                if (data.contact) { document.getElementById('contact-email').value = data.contact.email || ''; document.getElementById('contact-phone').value = data.contact.phone || ''; document.getElementById('contact-address').value = data.contact.address || ''; }
                if (data.duration) { document.getElementById('duration-initial').value = data.duration.initial || 60; document.getElementById('duration-followup').value = data.duration.followup || 30; }
                if (data.bank) { document.getElementById('bank-name').value = data.bank.name || ''; document.getElementById('bank-iban').value = data.bank.iban || ''; }
            }).catch(() => {});
        }

        document.getElementById('save-settings').addEventListener('click', async () => {
            const settings = { prices: { initial: parseInt(document.getElementById('price-initial').value), followup: parseInt(document.getElementById('price-followup').value) }, contact: { email: document.getElementById('contact-email').value, phone: document.getElementById('contact-phone').value, address: document.getElementById('contact-address').value }, duration: { initial: parseInt(document.getElementById('duration-initial').value), followup: parseInt(document.getElementById('duration-followup').value) }, bank: { name: document.getElementById('bank-name').value, iban: document.getElementById('bank-iban').value } };
            try { await fetch(API_BASE + '/dashboard/settings', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(settings) }); showToast('Iestatījumi saglabāti!', 'success'); } catch (e) { showToast(e.message, 'error'); }
        });

        // При первой загрузке - переходим к месяцу с ближайшими записями
        navigateToFirstUpcomingBooking().then(() => loadCalendar());

        async function loadHolidays() {
            const year = document.getElementById('holiday-year').value;
            const list = document.getElementById('holidays-list');
            try { const response = await fetch(API_BASE + '/holidays?year=' + year); const data = await response.json(); if (data.holidays && data.holidays.length > 0) list.innerHTML = data.holidays.map(h => `<div class="holiday-item"><span class="holiday-date">${formatDate(h.date)}</span><span>${h.name}</span></div>`).join(''); else list.innerHTML = '<p style="color:var(--color-text-light);">Nav svētku šajā gadā</p>'; } catch (e) { list.innerHTML = '<p style="color:#dc2626;">Kļūda ielādējot svētkus</p>'; }
        }

        document.getElementById('holiday-year').addEventListener('change', loadHolidays);
        document.getElementById('refresh-holidays').addEventListener('click', loadHolidays);

        let currentTableData = { entities: [], columns: [] };

        async function loadTableData() {
            const tableName = document.getElementById('table-select').value;
            const loading = document.getElementById('table-loading');
            const container = document.getElementById('table-container');
            const empty = document.getElementById('table-empty');
            loading.classList.remove('hidden'); container.classList.add('hidden'); empty.classList.add('hidden');
            try { const response = await fetch(API_BASE + '/dashboard/tables/' + tableName); const data = await response.json(); currentTableData = data; loading.classList.add('hidden'); if (!data.entities || data.entities.length === 0) { empty.classList.remove('hidden'); document.getElementById('table-count').textContent = '0'; return; } renderTable(data); container.classList.remove('hidden'); document.getElementById('table-count').textContent = data.count || data.entities.length; } catch (error) { loading.innerHTML = '<span style="color:#dc2626;">Kļūda: ' + error.message + '</span>'; }
        }

        function renderTable(data) {
            const header = document.getElementById('table-header');
            const body = document.getElementById('table-body');
            const columns = data.columns || [];
            header.innerHTML = `<tr>${columns.map(col => `<th>${col}</th>`).join('')}<th>Darbības</th></tr>`;
            body.innerHTML = data.entities.map(entity => {
                const pk = encodeURIComponent(entity.partitionKey || '');
                const rk = encodeURIComponent(entity.rowKey || '');
                return `<tr>${columns.map(col => { let value = entity[col]; if (value === undefined || value === null) value = ''; if (typeof value === 'object') value = JSON.stringify(value); const displayValue = String(value).length > 40 ? String(value).substring(0, 40) + '...' : value; let style = ''; if (col === 'status') { if (value === 'confirmed') style = 'color:#16a34a;font-weight:600;'; else if (value === 'pending') style = 'color:#ca8a04;font-weight:600;'; else if (value === 'cancelled') style = 'color:#dc2626;font-weight:600;'; } return `<td style="${style}" title="${String(value).replace(/"/g, '&quot;')}">${displayValue}</td>`; }).join('')}<td><button onclick="deleteEntity('${pk}', '${rk}')" class="btn-close" title="Dzēst"><i class="ph ph-trash"></i></button></td></tr>`;
            }).join('');
        }

        window.deleteEntity = async function(partitionKey, rowKey) {
            if (!confirm('Vai tiešām dzēst šo ierakstu?')) return;
            const tableName = document.getElementById('table-select').value;
            try { const response = await fetch(`${API_BASE}/dashboard/tables/${tableName}/${partitionKey}/${rowKey}`, { method: 'DELETE' }); if (response.ok) { loadTableData(); showToast('Ieraksts dzēsts', 'success'); } else { const error = await response.json(); showToast(error.details || error.error, 'error'); } } catch (e) { showToast(e.message, 'error'); }
        };

        function exportTableToCSV() {
            if (!currentTableData.entities || currentTableData.entities.length === 0) { showToast('Nav datu eksportēšanai', 'warning'); return; }
            const columns = currentTableData.columns;
            const rows = currentTableData.entities;
            const csvContent = [columns.join(','), ...rows.map(row => columns.map(col => { let value = row[col]; if (value === undefined || value === null) return ''; if (typeof value === 'object') value = JSON.stringify(value); value = String(value).replace(/"/g, '""'); if (value.includes(',') || value.includes('"') || value.includes('\n')) value = `"${value}"`; return value; }).join(','))].join('\n');
            const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `${document.getElementById('table-select').value}_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(url);
        }

        document.getElementById('table-select').addEventListener('change', loadTableData);
        document.getElementById('refresh-table').addEventListener('click', loadTableData);
        document.getElementById('export-csv').addEventListener('click', exportTableToCSV);
    })();
    </script>
</Layout>
