            color: var(--diary-text-dim);
            font-size: 16px;
            transition: background 0.15s;
        }
        .sheet-close:hover { background: var(--diary-border); }

        /* Sheet body scrollable */
        .sheet-body {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 8px;
        }

        /* Sheet tabs */
        .sheet-tabs {
            display: flex;
            gap: 4px;
            background: var(--diary-warm);
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 16px;
            flex-shrink: 0;
        }
        .sheet-tab {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 10px 8px;
            font-size: 13px;
            font-weight: 500;
            color: var(--diary-text-dim);
            border-radius: 10px;
            transition: all 0.2s;
        }
        .sheet-tab.active {
            background: #fff;
            color: var(--diary-green);
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }
        .sheet-tab i { font-size: 16px; }

        /* Form styles in sheet */
        .add-food-form { display: flex; flex-direction: column; gap: 12px; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-group label {
            font-size: 12px;
            font-weight: 500;
            color: var(--diary-text-dim);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .form-group input[type="text"],
        .form-group input[type="number"] {
            padding: 10px 12px;
            border: 1.5px solid var(--diary-border);
            border-radius: 10px;
            font-size: 14px;
            color: var(--diary-text);
            background: #fff;
            transition: border-color 0.2s;
            font-family: var(--font-sans, 'Inter', sans-serif);
            width: 100%;
        }
        .form-group input:focus {
            outline: none;
            border-color: var(--diary-green);
        }
        .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }

        /* Photo */
        .photo-label {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 10px 14px;
            border: 1.5px dashed var(--diary-border);
            border-radius: 12px;
            color: var(--diary-text-dim);
            cursor: pointer;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .photo-label:hover { border-color: var(--diary-green); }
        .photo-input { display: none; }
        .photo-preview {
            margin-top: 8px;
            border-radius: 12px;
            overflow: hidden;
            max-height: 180px;
        }
        .photo-preview img { width: 100%; display: block; object-fit: cover; max-height: 180px; }

        /* Form actions — fixed at bottom of modal */
        .form-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 12px 0 16px;
            background: #fff;
            flex-shrink: 0;
            border-top: 1px solid var(--diary-border);
        }
        .btn-primary-sm {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 14px 20px;
            background: linear-gradient(135deg, var(--diary-green), var(--diary-green-light));
            color: #fff !important;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            transition: opacity 0.2s;
        }
        .btn-primary-sm:hover { opacity: 0.9; }
        .btn-primary-sm:disabled { opacity: 0.5; cursor: not-allowed; }
        .btn-save-fav {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 14px 16px;
            border: 1.5px solid var(--diary-border);
            border-radius: 12px;
            background: #fff;
            color: var(--diary-text-dim) !important;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-save-fav:hover { border-color: var(--diary-gold); color: var(--diary-gold) !important; }
        .btn-text {
            color: var(--diary-text-dim) !important;
            font-size: 13px;
            padding: 8px;
        }
        .btn-text:hover { color: #ef4444 !important; }

        /* Food chip list (favorites/recent panels) */
        .food-chip-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-height: 50vh;
            overflow-y: auto;
        }
        .food-chip {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border: 1px solid var(--diary-border);
            border-radius: 12px;
            background: #fff;
            cursor: pointer;
            transition: all 0.15s;
        }
        .food-chip:hover { background: var(--diary-warm); border-color: var(--diary-gold); }
        .food-chip-body { flex: 1; min-width: 0; }
        .food-chip-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--diary-text);
        }
        .food-chip-detail {
            font-size: 12px;
            color: var(--diary-text-dim);
            margin-top: 2px;
        }
        .food-chip-kcal {
            font-size: 14px;
            font-weight: 600;
            color: var(--diary-text);
            flex-shrink: 0;
        }
        .food-chip-del {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            flex: 0 0 26px;
            border-radius: 6px;
            color: #d1d5db;
            font-size: 14px;
        }
        .food-chip-del:hover { color: #ef4444; }

        .fav-footer {
            display: flex;
            justify-content: center;
            margin-top: 12px;
        }

        .sheet-empty {
            text-align: center;
            padding: 32px 16px;
            color: var(--diary-text-dim);
        }
        .sheet-empty i { font-size: 32px; display: block; margin-bottom: 8px; color: var(--diary-border); }
        .sheet-empty p { margin: 0; font-size: 14px; }

        .sheet-status {
            text-align: center;
            font-size: 13px;
            color: var(--diary-green);
            padding: 8px 0 0;
            min-height: 24px;
        }

        /* ---- FAB ---- */
        .fab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--diary-green), var(--diary-green-light));
            color: #fff !important;
            box-shadow: 0 4px 20px rgba(27, 67, 50, 0.35);
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 90;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .fab:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(27, 67, 50, 0.4); }
        @media (min-width: 520px) {
            .fab { right: calc(50% - var(--diary-max-w)/2 + 20px); right: max(24px, calc(50% - 220px)); }
        }

        /* ---- Utility ---- */
        .hidden { display: none !important; }

        /* ---- Responsive ---- */
        @media (max-width: 500px) {
            .summary-card { flex-direction: column; gap: 16px; padding: 20px 16px; }
            .summary-ring-wrap { width: 100px; height: 100px; align-self: center; }
            .ring-eaten { font-size: 22px; }
            .macro-bars { width: 100%; }
            .form-row-3 { grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
        }

        /* Animation */
        @keyframes sheetSlideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .meal-item-row {
            animation: fadeIn 0.25s ease;
        }

        /* ---- Overflows indicator ---- */
        .macro-fill.over {
            background: linear-gradient(90deg, #ef4444, #f87171) !important;
        }

        /* ---- Kcal emphasis in meal rows ---- */
        .meal-item-row:last-child { border-bottom: none; }
        .meal-section-items:not(:empty) { padding-bottom: 4px; }
    </style>

    <!-- ============ SCRIPT ============ -->
    <script>
        // ---- Globals ----
        let userId = '';
        let currentDate = new Date();
        let allMeals = [];
        let activeSheetMealType = 'snack';
        const FAVORITES_KEY = 'diary_favorites_v2';
        const TARGETS_KEY = 'diary_targets';

        // Default targets (can be overridden by specialist)
        let targets = { calories: 2000, protein: 120, fat: 65, carbs: 250 };

        // ---- DOM refs ----
        const $ = (sel) => document.querySelector(sel);
        const $$ = (sel) => document.querySelectorAll(sel);

        // ---- Helpers ----
        function escapeHtml(val) {
            return String(val).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function formatDate(d) {
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        }

        function isSameDay(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() && d1.getMonth() === d2.getMonth() && d1.getDate() === d2.getDate();
        }

        function isToday(d) { return isSameDay(d, new Date()); }
        function isYesterday(d) {
            const y = new Date();
            y.setDate(y.getDate() - 1);
            return isSameDay(d, y);
        }

        function dayLabel(d) {
            if (isToday(d)) return 'Šodien';
            if (isYesterday(d)) return 'Vakar';
            const weekdays = ['Svētdiena','Pirmdiena','Otrdiena','Trešdiena','Ceturtdiena','Piektdiena','Sestdiena'];
            return weekdays[d.getDay()];
        }

        function daySubLabel(d) {
            const months = ['janv.','febr.','marts','apr.','maijs','jūn.','jūl.','aug.','sept.','okt.','nov.','dec.'];
            return `${d.getDate()}. ${months[d.getMonth()]} ${d.getFullYear()}`;
        }

        // ---- Auth ----
        function setAuthLinks() {
            const o = window.location.origin;
            const loginAad = $('#login-aad');
            const logoutLink = $('#logout-link');
            if (loginAad) loginAad.setAttribute('href', `${o}/.auth/login/aad?post_login_redirect_uri=/cabinet`);
            if (logoutLink) logoutLink.setAttribute('href', `${o}/.auth/logout?post_logout_redirect_uri=/cabinet`);
        }

        async function loadAuth() {
            try {
                const res = await fetch('/.auth/me');
                const data = await res.json();
                const p = data?.clientPrincipal;
                if (!p) {
                    showScreen('login');
                    return;
                }
                userId = p.userId;
                $('#user-name').textContent = p.userDetails || p.userId;
                $('#auth-actions').classList.add('hidden');
                $('#auth-user').classList.remove('hidden');
                await loadAccess();
            } catch {
                showScreen('login');
            }
        }

        async function loadAccess() {
            try {
                const res = await fetch('/api/food/access');
                if (!res.ok) { showScreen('no-access'); return; }
                const data = await res.json();
                if (!data?.enabled) { showScreen('no-access'); return; }
                showScreen('diary');
                loadTargets();
                await loadMeals();
            } catch {
                showScreen('no-access');
            }
        }

        function showScreen(screen) {
            $('#login-hint').classList.toggle('hidden', screen !== 'login');
            $('#no-access').classList.toggle('hidden', screen !== 'no-access');
            $('#diary').classList.toggle('hidden', screen !== 'diary');
            $('#fab-add').classList.toggle('hidden', screen !== 'diary');
        }

        // ---- Targets ----
        function loadTargets() {
            try {
                const saved = localStorage.getItem(TARGETS_KEY);
                if (saved) Object.assign(targets, JSON.parse(saved));
            } catch {}
            $('#ring-target').textContent = targets.calories;
            $('#macro-protein-target').textContent = targets.protein;
            $('#macro-fat-target').textContent = targets.fat;
            $('#macro-carbs-target').textContent = targets.carbs;
        }

        // ---- Day navigation ----
        function updateDayUI() {
            $('#day-label').textContent = dayLabel(currentDate);
            $('#day-date-sub').textContent = daySubLabel(currentDate);
            $('#diary-date').value = formatDate(currentDate);
        }

        function goDay(offset) {
            currentDate.setDate(currentDate.getDate() + offset);
            updateDayUI();
            loadMeals();
        }

        $('#day-prev')?.addEventListener('click', () => goDay(-1));
        $('#day-next')?.addEventListener('click', () => goDay(1));
        $('#day-today')?.addEventListener('click', () => {
            const picker = $('#diary-date');
            // Try native date picker, fallback to today
            if (picker && typeof picker.showPicker === 'function') {
                picker.showPicker();
            } else {
                currentDate = new Date();
                updateDayUI();
                loadMeals();
            }
        });
        $('#diary-date')?.addEventListener('change', (e) => {
            const val = e.target.value;
            if (val) {
                currentDate = new Date(val + 'T12:00:00');
                updateDayUI();
                loadMeals();
            }
        });

        // ---- Meals CRUD ----
        async function loadMeals() {
            if (!userId) return;
            const date = formatDate(currentDate);
            try {
                const res = await fetch(`/api/meals?userId=${encodeURIComponent(userId)}&date=${encodeURIComponent(date)}`);
                const meals = res.ok ? await res.json() : [];
                allMeals = Array.isArray(meals) ? meals : [];
            } catch {
                allMeals = [];
            }
            renderAllMeals();
        }

        function renderAllMeals() {
            const types = ['breakfast', 'lunch', 'dinner', 'snack'];
            let grandCal = 0, grandP = 0, grandF = 0, grandC = 0;
            let totalItems = 0;

            types.forEach(type => {
                const container = $(`[data-meal-items="${type}"]`);
                const kcalLabel = $(`.meal-section[data-meal-type="${type}"] [data-section-kcal]`);
                if (!container) return;

                const meals = allMeals.filter(m => m.mealType === type);
                let sectionCal = 0;
                let html = '';

                meals.forEach(meal => {
                    (meal.items || []).forEach(item => {
                        const cal = Number(item.calories || 0);
                        const p = Number(item.protein || 0);
                        const f = Number(item.fat || 0);
                        const c = Number(item.carbs || 0);
                        sectionCal += cal;
                        grandCal += cal;
                        grandP += p;
                        grandF += f;
                        grandC += c;
                        totalItems++;

                        html += `
                            <div class="meal-item-row" data-meal-id="${escapeHtml(meal.RowKey)}" data-meal-date="${escapeHtml(formatDate(new Date(meal.createdAt)))}" >
                                <div class="meal-item-body">
                                    <div class="meal-item-name-row">
                                        <span class="meal-item-name">${escapeHtml(item.name)}</span>
                                        <span class="meal-item-kcal">${Math.round(cal)} kcal</span>
                                    </div>
                                    <div class="meal-item-detail">
                                        ${item.weight}g · O ${Math.round(p*10)/10}g · T ${Math.round(f*10)/10}g · Og ${Math.round(c*10)/10}g
                                    </div>
                                </div>
                                <button class="meal-item-delete" data-delete-meal="${escapeHtml(meal.RowKey)}" data-delete-date="${escapeHtml(formatDate(new Date(meal.createdAt)))}" aria-label="Dzēst">
                                    <i class="ph ph-trash"></i>
                                </button>
                            </div>`;
                    });
                });

                container.innerHTML = html;
                if (kcalLabel) kcalLabel.textContent = sectionCal > 0 ? `${Math.round(sectionCal)} kcal` : '';
                if (kcalLabel) kcalLabel.style.display = sectionCal > 0 ? '' : 'none';
            });

            // Update summary ring
            updateSummary(grandCal, grandP, grandF, grandC);

            // Show/hide empty state
            const dayEmpty = $('#day-empty');
            if (dayEmpty) dayEmpty.classList.toggle('hidden', totalItems > 0);
        }

        function updateSummary(cal, p, f, c) {
            const ratio = Math.min(cal / targets.calories, 1);
            const circumference = 2 * Math.PI * 52; // ~326.73
            const ring = $('#cal-ring');
            if (ring) ring.style.strokeDashoffset = String(circumference * (1 - ratio));
            if (cal > targets.calories && ring) ring.style.stroke = '#ef4444';
            else if (ring) ring.style.stroke = 'var(--diary-green)';

            const ringEaten = $('#ring-eaten');
            if (ringEaten) {
                ringEaten.textContent = Math.round(cal);
                ringEaten.style.color = cal > targets.calories ? '#ef4444' : '';
            }

            $('#macro-protein').textContent = Math.round(p);
            $('#macro-fat').textContent = Math.round(f);
            $('#macro-carbs').textContent = Math.round(c);

            setBarWidth('bar-protein', p, targets.protein);
            setBarWidth('bar-fat', f, targets.fat);
            setBarWidth('bar-carbs', c, targets.carbs);
        }

        function setBarWidth(id, value, target) {
            const bar = $(`#${id}`);
            if (!bar) return;
            const pct = Math.min(value / target * 100, 100);
            bar.style.width = `${pct}%`;
            bar.classList.toggle('over', value > target);
        }

        // Delete meal
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-delete-meal]');
            if (!btn) return;
            const mealId = btn.dataset.deleteMeal;
            const date = btn.dataset.deleteDate;
            if (!confirm('Dzēst šo ierakstu?')) return;
            try {
                const res = await fetch(`/api/meals/${encodeURIComponent(mealId)}?userId=${encodeURIComponent(userId)}&date=${encodeURIComponent(date)}`, { method: 'DELETE' });
                if (res.ok || res.status === 204) {
                    btn.closest('.meal-item-row')?.remove();
                    allMeals = allMeals.filter(m => m.RowKey !== mealId);
                    renderAllMeals();
                }
            } catch {}
        });

        // ---- Water Tracker (removed) ----

        // ---- Bottom Sheet ----
        function openSheet(mealType) {
            activeSheetMealType = mealType;
            const labels = { breakfast: 'Brokastis', lunch: 'Pusdienas', dinner: 'Vakariņas', snack: 'Uzkoda' };
            $('#sheet-title').textContent = labels[mealType] || 'Pievienot ēdienu';
            resetAddForm();
            switchSheetTab('manual');
            showSheet(true);
        }

        function showSheet(show) {
            const overlay = $('#sheet-overlay');
            const sheet = $('#add-sheet');
            if (show) {
                overlay.classList.remove('hidden');
                sheet.classList.remove('hidden');
                requestAnimationFrame(() => {
                    overlay.classList.add('visible');
                    sheet.classList.add('visible');
                });
                document.body.style.overflow = 'hidden';
            } else {
                overlay.classList.remove('visible');
                sheet.classList.remove('visible');
                setTimeout(() => {
                    overlay.classList.add('hidden');
                    sheet.classList.add('hidden');
                    document.body.style.overflow = '';
                }, 300);
            }
        }

        function closeSheet() { showSheet(false); }

        $('#sheet-overlay')?.addEventListener('click', closeSheet);
        $('#sheet-close')?.addEventListener('click', closeSheet);

        // Sheet tabs
        function switchSheetTab(tab) {
            $$('.sheet-tab').forEach(t => t.classList.toggle('active', t.dataset.sheetTab === tab));
            $$('.sheet-panel').forEach(p => p.classList.toggle('hidden', p.dataset.sheetPanel !== tab));
            if (tab === 'favorites') renderFavoritesList();
            if (tab === 'recent') renderRecentList();
        }

        document.addEventListener('click', (e) => {
            const tab = e.target.closest('.sheet-tab');
            if (tab) switchSheetTab(tab.dataset.sheetTab);
        });

        // Add meal buttons (section + buttons)
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-add-meal]');
            if (btn) openSheet(btn.dataset.addMeal);
        });

        // FAB
        $('#fab-add')?.addEventListener('click', () => {
            // Smart default: pick meal type based on time of day
            const h = new Date().getHours();
            let type = 'snack';
            if (h >= 5 && h < 11) type = 'breakfast';
            else if (h >= 11 && h < 15) type = 'lunch';
            else if (h >= 17 && h < 21) type = 'dinner';
            openSheet(type);
        });

        // Empty state button
        $('#empty-add-btn')?.addEventListener('click', () => {
            const h = new Date().getHours();
            let type = 'snack';
            if (h >= 5 && h < 11) type = 'breakfast';
            else if (h >= 11 && h < 15) type = 'lunch';
            else if (h >= 17 && h < 21) type = 'dinner';
            openSheet(type);
        });

        // ---- Add Food Form ----
        function resetAddForm() {
            const form = $('#add-food-form');
            if (form) form.reset();
            $('#food-weight').value = '100';
            $('#food-calories').value = '';
            $('#food-protein').value = '';
            $('#food-fat').value = '';
            $('#food-carbs').value = '';
            const preview = $('#photo-preview');
            if (preview) { preview.classList.add('hidden'); preview.innerHTML = ''; }
            $('#sheet-status').textContent = '';
        }

        // Photo preview
        $('#food-photo')?.addEventListener('change', (e) => {
            const file = e.target.files?.[0];
            const preview = $('#photo-preview');
            if (!file || !preview) { preview?.classList.add('hidden'); return; }
            const reader = new FileReader();
            reader.onload = () => {
                preview.innerHTML = `<img src="${reader.result}" alt="Preview">`;
                preview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        });

        async function readPhotoAsDataUrl() {
            const input = $('#food-photo');
            const file = input?.files?.[0];
            if (!file) return undefined;
            return new Promise(resolve => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result?.toString());
                reader.readAsDataURL(file);
            });
        }

        // Submit add food (button is outside the form now)
        $('#submit-food-btn')?.addEventListener('click', async () => {
            const form = $('#add-food-form');
            if (form && !form.checkValidity()) {
                form.reportValidity();
                return;
            }
            await addFoodItem(false);
        });

        // Save + add to favorites
        $('#save-and-fav')?.addEventListener('click', async () => {
            await addFoodItem(true);
        });

        async function addFoodItem(alsoFavorite) {
            const name = $('#food-name')?.value?.trim();
            const weight = Number($('#food-weight')?.value || 100);
            const calories = Number($('#food-calories')?.value || 0);
            const protein = Number($('#food-protein')?.value || 0);
            const fat = Number($('#food-fat')?.value || 0);
            const carbs = Number($('#food-carbs')?.value || 0);

            if (!name || !weight) {
                $('#sheet-status').textContent = 'Ievadiet nosaukumu un svaru.';
                return;
            }

            const item = { name, nameEn: name, weight, calories, protein, fat, carbs, confidence: 1, userAdjusted: true };

            if (alsoFavorite) {
                saveFavorite(item);
            }

            $('#sheet-status').textContent = 'Saglabā…';
            const submitBtn = $('#submit-food-btn');
            if (submitBtn) submitBtn.disabled = true;

            const photoUrl = await readPhotoAsDataUrl();

            const payload = {
                userId,
                mealType: activeSheetMealType,
                createdAt: new Date(formatDate(currentDate) + 'T' + String(new Date().getHours()).padStart(2,'0') + ':' + String(new Date().getMinutes()).padStart(2,'0') + ':00').toISOString(),
                items: [item],
                totalCalories: calories,
                totalProtein: protein,
                totalFat: fat,
                totalCarbs: carbs,
                confirmed: true,
                photoUrl: photoUrl && photoUrl.length <= 50000 ? photoUrl : undefined
            };

            try {
                const res = await fetch('/api/meals', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => null);
                    $('#sheet-status').textContent = err?.error || 'Kļūda saglabājot.';
                    if (submitBtn) submitBtn.disabled = false;
                    return;
                }

                $('#sheet-status').textContent = 'Pievienots!';
                setTimeout(() => {
                    closeSheet();
                    if (submitBtn) submitBtn.disabled = false;
                }, 400);
                await loadMeals();
            } catch (err) {
                $('#sheet-status').textContent = 'Kļūda: ' + (err.message || 'neizdevās saglabāt');
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        // ---- Favorites ----
        function loadFavorites() {
            try { return JSON.parse(localStorage.getItem(FAVORITES_KEY) || '[]'); } catch { return []; }
        }

        function saveFavorite(item) {
            const favs = loadFavorites();
            const exists = favs.some(f => f.name.toLowerCase() === item.name.toLowerCase());
            if (!exists) {
                favs.unshift({ name: item.name, weight: item.weight, calories: item.calories, protein: item.protein, fat: item.fat, carbs: item.carbs });
                localStorage.setItem(FAVORITES_KEY, JSON.stringify(favs.slice(0, 30)));
            }
        }

        function removeFavorite(name) {
            const favs = loadFavorites().filter(f => f.name.toLowerCase() !== name.toLowerCase());
            localStorage.setItem(FAVORITES_KEY, JSON.stringify(favs));
            renderFavoritesList();
        }

        function renderFavoritesList() {
            const container = $('#fav-list');
            const empty = $('#fav-empty');
            if (!container) return;
            const favs = loadFavorites();
            if (!favs.length) {
                container.innerHTML = '';
                empty?.classList.remove('hidden');
                return;
            }
            empty?.classList.add('hidden');
            container.innerHTML = favs.map(f => `
                <div class="food-chip" data-fav-apply='${escapeHtml(JSON.stringify(f))}'>
                    <div class="food-chip-body">
                        <div class="food-chip-name">${escapeHtml(f.name)}</div>
                        <div class="food-chip-detail">${f.weight}g · O ${f.protein}g · T ${f.fat}g · Og ${f.carbs}g</div>
                    </div>
                    <span class="food-chip-kcal">${f.calories} kcal</span>
                    <button class="food-chip-del" data-fav-del="${escapeHtml(f.name)}" aria-label="Noņemt"><i class="ph ph-x"></i></button>
                </div>
            `).join('');
        }

        // Click favorite to apply
        document.addEventListener('click', (e) => {
            const del = e.target.closest('[data-fav-del]');
            if (del) { e.stopPropagation(); removeFavorite(del.dataset.favDel); return; }
            const chip = e.target.closest('[data-fav-apply]');
            if (chip) {
                try {
                    const item = JSON.parse(chip.dataset.favApply);
                    fillFormFromItem(item);
                    switchSheetTab('manual');
                } catch {}
            }
        });

        // Clear all favorites
        $('#clear-all-fav')?.addEventListener('click', () => {
            localStorage.setItem(FAVORITES_KEY, '[]');
            renderFavoritesList();
        });

        // ---- Recent items ----
        function renderRecentList() {
            const container = $('#recent-list');
            const empty = $('#recent-empty');
            if (!container) return;

            const items = [];
            const seen = new Set();
            // Collect from all meals, newest first
            const sorted = [...allMeals].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            sorted.forEach(meal => {
                (meal.items || []).forEach(item => {
                    const key = item.name?.toLowerCase();
                    if (!key || seen.has(key)) return;
                    seen.add(key);
                    items.push(item);
                });
            });

            if (!items.length) {
                container.innerHTML = '';
                empty?.classList.remove('hidden');
                return;
            }
            empty?.classList.add('hidden');

            container.innerHTML = items.slice(0, 20).map(item => `
                <div class="food-chip" data-recent-apply='${escapeHtml(JSON.stringify({ name: item.name, weight: item.weight, calories: item.calories, protein: item.protein, fat: item.fat, carbs: item.carbs }))}'>
                    <div class="food-chip-body">
                        <div class="food-chip-name">${escapeHtml(item.name)}</div>
                        <div class="food-chip-detail">${item.weight}g · O ${Math.round((item.protein||0)*10)/10}g · T ${Math.round((item.fat||0)*10)/10}g · Og ${Math.round((item.carbs||0)*10)/10}g</div>
                    </div>
                    <span class="food-chip-kcal">${Math.round(item.calories||0)} kcal</span>
                </div>
            `).join('');
        }

        document.addEventListener('click', (e) => {
            const chip = e.target.closest('[data-recent-apply]');
            if (chip) {
                try {
                    const item = JSON.parse(chip.dataset.recentApply);
                    fillFormFromItem(item);
                    switchSheetTab('manual');
                } catch {}
            }
        });

        function fillFormFromItem(item) {
            $('#food-name').value = item.name || '';
            $('#food-weight').value = item.weight || 100;
            $('#food-calories').value = item.calories || 0;
            $('#food-protein').value = item.protein || 0;
            $('#food-fat').value = item.fat || 0;
            $('#food-carbs').value = item.carbs || 0;
        }

        // ---- Keyboard shortcut: Escape to close sheet ----
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeSheet();
        });

        // ---- Init ----
        setAuthLinks();
        updateDayUI();
        loadAuth();
    </script>
</Layout>
