---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
---

<Layout
  title="Dietoloģe Rīgā — Sofija Ivanova | Personalizētas Uztura Konsultācijas"
  description="Sertificēta dietoloģe Rīgā (Nr. 75650061277). Individuālas uztura konsultācijas klātienē un tiešsaistē. Diabēta profilakse, personalizēts uztura plāns, metabolā veselība. MSc uzturzinātnē, doktorante LU."
  canonicalPath="/"
>
  <SiteHeader />
</Layout>

<main id="main-content">
  <!-- HERO -->
  <header class="fc-hero" aria-labelledby="hero-title">
    <div class="fc-wrap fc-hero-grid">
      <div class="fc-hero-copy">
        <span class="fc-pill"><i class="ph ph-seal-check" aria-hidden="true"></i> <span data-i18n="hero_eyebrow">Sertificēta dietoloģe · Rīga</span></span>
        <h1 id="hero-title" data-i18n="hero_title">Uzturs, kas strādā tieši Jums</h1>
        <p class="fc-lead" data-i18n="hero_subtitle">
          Nepalīdz diētas? Trūkst enerģijas? Vēlaties sakārtot svaru vai cukura līmeni? Palīdzēšu ar
          individuālu, zinātniski pamatotu pieeju — bez gatavām shēmām.
        </p>
        <div class="fc-actions">
          <a href="#contact" class="fc-btn fc-btn--solid" data-i18n="hero_cta_primary">Rezervēt konsultāciju</a>
          <a href="#services" class="fc-btn fc-btn--ghost" data-i18n="hero_cta_secondary">Pakalpojumi</a>
        </div>
      </div>

      <div class="fc-visual">
        <div class="fc-photo">
          <picture>
            <source
              type="image/webp"
              srcset="/assets/img/hero-nutritionist-480w.webp 480w, /assets/img/hero-nutritionist-768w.webp 768w, /assets/img/hero-nutritionist-1024w.webp 1024w, /assets/img/hero-nutritionist-1440w.webp 1440w"
              sizes="(max-width: 980px) 440px, 540px"
            />
            <img
              src="/assets/img/hero-nutritionist-1024w.png"
              alt="Uztura speciāliste Sofija Ivanova — individuālas konsultācijas Rīgā un tiešsaistē"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="1024"
              height="1126"
            />
          </picture>
        </div>
        <div class="fc-floatcard fc-fc-a">
          <i class="ph ph-shield-check" aria-hidden="true"></i>
          <div>
            <b data-i18n="trust_reg">Reģistrēta speciāliste</b>
            <span data-i18n="trust_reg_sub">ārstniecības personu reģistrs</span>
          </div>
        </div>
        <div class="fc-floatcard fc-fc-b">
          <i class="ph ph-video-camera" aria-hidden="true"></i>
          <div>
            <b data-i18n="hero_credential_degree">Klātienē un tiešsaistē</b>
            <span data-i18n="hero_credential_label">Rīga</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- TRUST -->
  <div class="fc-trust">
    <div class="fc-wrap fc-trust-inner">
      <div class="fc-trust-item">
        <i class="ph ph-graduation-cap" aria-hidden="true"></i>
        <div><b data-i18n="trust_msc">MSc Dietoloģijā</b><span data-i18n="trust_msc_sub">Rīgas Stradiņa universitāte (RSU)</span></div>
      </div>
      <div class="fc-trust-div" aria-hidden="true"></div>
      <div class="fc-trust-item">
        <i class="ph ph-book-open-text" aria-hidden="true"></i>
        <div><b data-i18n="trust_phd">Doktorante</b><span data-i18n="trust_phd_sub">Latvijas Universitāte (LU)</span></div>
      </div>
      <div class="fc-trust-div" aria-hidden="true"></div>
      <div class="fc-trust-item">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        <div><b data-i18n="trust_reg">Reģistrēta speciāliste</b><span data-i18n="trust_reg_sub">ārstniecības personu reģistrs</span></div>
      </div>
    </div>
  </div>

  <!-- WHOM -->
  <section class="fc-block">
    <div class="fc-wrap">
      <div class="fc-head center fc-reveal">
        <span class="fc-eyebrow center" data-i18n="why_tag">Kam tas der</span>
        <h2 data-i18n="whom_title">Konsultācija ir piemērota, ja Jūs</h2>
      </div>
      <div class="fc-whom-grid">
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_1">Esat izmēģinājuši vairākas diētas, bet nekas nav palīdzējis ilgtermiņā</p></div>
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_2">Vēlaties kontrolēt svaru bez striktu ierobežojumu</p></div>
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_3">Jūtat hronisko nogurumu un enerģijas trūkumu</p></div>
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_4">Jums ir prediabēts, insulīna rezistence vai paaugstināts cukurs</p></div>
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_5">Vēlaties uzlabot gremošanu un zarnu veselību</p></div>
        <div class="fc-whom fc-reveal"><span class="ck"><i class="ph ph-check"></i></span><p data-i18n="whom_6">Meklējat speciālistu, kas balstās uz zinātni, nevis modes tendencēm</p></div>
      </div>
      <div class="fc-center-cta">
        <a href="#contact" class="fc-btn fc-btn--solid" data-i18n="whom_cta">Pieteikties konsultācijai</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="fc-block fc-bg-tint">
    <div class="fc-wrap">
      <div class="fc-head center fc-reveal">
        <span class="fc-eyebrow center" data-i18n="services_tag">Pakalpojumi</span>
        <h2 data-i18n="services_title">Kā es varu Jums palīdzēt</h2>
        <p data-i18n="services_desc">Katrs cilvēks ir unikāls — tāpēc mans darbs sākas ar Jūsu stāstu, nevis gatavu shēmu.</p>
      </div>
      <div class="fc-svc-grid">
        <div class="fc-svc fc-reveal"><div class="fc-svc-ic"><i class="ph ph-chats-circle"></i></div><h3 data-i18n="srv_1_title">Individuāla konsultācija</h3><p data-i18n="srv_1_desc">Sapratīsiet, kas tieši Jūsu uzturā nestrādā un ko mainīt. Klātienē vai tiešsaistē, 60 min.</p></div>
        <div class="fc-svc fc-reveal"><div class="fc-svc-ic"><i class="ph ph-notebook"></i></div><h3 data-i18n="srv_2_title">Personalizēts uztura plāns</h3><p data-i18n="srv_2_desc">Konkrēta ēdienkarte, kas garšo un ir reāli iekļaujama Jūsu ikdienā. Nevis diēta — jauns ēšanas veids.</p></div>
        <div class="fc-svc fc-reveal"><div class="fc-svc-ic"><i class="ph ph-heartbeat"></i></div><h3 data-i18n="srv_3_title">Metabolā veselība</h3><p data-i18n="srv_3_desc">Stabilizēsiet cukura līmeni, uzlabosiet enerģiju un kontrolēsiet svaru. Īpaši aktuāli ar prediabētu.</p></div>
        <div class="fc-svc fc-reveal"><div class="fc-svc-ic"><i class="ph ph-leaf"></i></div><h3 data-i18n="srv_5_title">Zarnu veselība</h3><p data-i18n="srv_5_desc">Atvadīsieties no vēdera uzpūšanās un nestabilas gremošanas. Stratēģija, kas atjauno līdzsvaru.</p></div>
        <div class="fc-svc fc-reveal"><div class="fc-svc-ic"><i class="ph ph-hand-heart"></i></div><h3 data-i18n="srv_6_title">Ilgtermiņa atbalsts</h3><p data-i18n="srv_6_desc">Follow-up vizītes, plāna korekcijas un atbalsts, kamēr jaunie paradumi kļūst par normu.</p></div>
        <div class="fc-svc feat fc-reveal">
          <div class="fc-svc-ic"><i class="ph ph-calendar-check"></i></div>
          <span class="price-lbl" data-i18n="price_consult">Konsultācija (60 min)</span>
          <div class="price" data-i18n="price_consult_val">no 65 €</div>
          <p>Iekļauj pilnu uztura analīzi, personalizētu plānu un rekomendācijas.</p>
          <a href="#contact" class="fc-svc-more" data-i18n="hero_cta_primary">Rezervēt konsultāciju →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OUTCOMES -->
  <section class="fc-block">
    <div class="fc-wrap">
      <div class="fc-head center fc-reveal">
        <span class="fc-eyebrow center" data-i18n="outcomes_tag">Rezultāts</span>
        <h2 data-i18n="outcomes_title">Ko Jūs iegūsiet</h2>
      </div>
      <div class="fc-out-grid">
        <div class="fc-out fc-reveal"><div class="fc-out-ic"><i class="ph ph-clipboard-text"></i></div><h3 data-i18n="out_1_title">Individuāls uztura plāns</h3><p data-i18n="out_1_desc">Personalizēts plāns, kas ņem vērā Jūsu veselību, garšas preferences un dzīvesveidu.</p></div>
        <div class="fc-out fc-reveal"><div class="fc-out-ic"><i class="ph ph-lightning"></i></div><h3 data-i18n="out_2_title">Vairāk enerģijas un skaidrība</h3><p data-i18n="out_2_desc">Pirmās izmaiņas jau 2–3 nedēļās: labāks miegs, stabilāka enerģija, skaidrāka domāšana.</p></div>
        <div class="fc-out fc-reveal"><div class="fc-out-ic"><i class="ph ph-trend-up"></i></div><h3 data-i18n="out_3_title">Ilgtspējīgi rezultāti</h3><p data-i18n="out_3_desc">Bez jojo efekta. Iemācīsieties ēst pareizi sev — lai rezultāti saglabājas gadiem.</p></div>
      </div>
      <div class="fc-price fc-reveal">
        <div class="fc-price-box">
          <span class="l" data-i18n="price_consult">Konsultācija (60 min)</span>
          <span class="v" data-i18n="price_consult_val">no 65 €</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="fc-block fc-bg-tint">
    <div class="fc-wrap fc-about-grid">
      <div class="fc-about-photo fc-reveal">
        <picture>
          <source
            type="image/webp"
            srcset="/assets/img/aboutme-480w.webp 480w, /assets/img/aboutme-768w.webp 768w, /assets/img/aboutme-1024w.webp 1024w"
            sizes="(max-width: 980px) 100vw, 460px"
          />
          <img
            src="/assets/img/aboutme-fallback.png"
            alt="Uztura speciāliste Sofija Ivanova — personalizēta uztura konsultācija Rīgā"
            loading="lazy"
            decoding="async"
            width="1024"
            height="768"
          />
        </picture>
      </div>
      <div class="fc-reveal">
        <span class="fc-eyebrow" data-i18n="about_tag">Par mani</span>
        <div class="fc-head"><h2>Sofija Ivanova</h2></div>
        <p class="fc-about-text" data-i18n="about_lead">
          Esmu sertificēta dietoloģe un doktorante Latvijas Universitātes Klīniskās un personalizētās
          medicīnas katedrā. Pētījumu fokuss — uztura loma diabēta ārstēšanā un profilaksē.
        </p>
        <p class="fc-about-text" data-i18n="about_text">
          Palīdzu cilvēkiem veikt ilgtspējīgas dzīvesveida izmaiņas, samazināt hronisko slimību risku
          un uzlabot ilgtermiņa veselības rezultātus.
        </p>
        <div class="fc-creds">
          <div class="fc-cred"><i class="ph ph-graduation-cap"></i><div><b data-i18n="trust_msc">MSc Dietoloģijā</b><span data-i18n="trust_msc_sub">Rīgas Stradiņa universitāte (RSU)</span></div></div>
          <div class="fc-cred"><i class="ph ph-book-open-text"></i><div><b data-i18n="cred_2_title">Doktorantūra</b><span data-i18n="cred_2_loc">Latvijas Universitāte</span></div></div>
          <div class="fc-cred"><i class="ph ph-shield-check"></i><div><b data-i18n="cred_3_title">Reģistrēta ārstniecības persona</b><span data-i18n="cred_3_loc">Nr. 75650061277</span></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="fc-block">
    <div class="fc-wrap">
      <div class="fc-head center fc-reveal">
        <span class="fc-eyebrow center" data-i18n="faq_tag">Biežāk uzdotie jautājumi</span>
        <h2 data-i18n="faq_title">Kas jāzina pirms pieteikšanās</h2>
      </div>
      <div class="fc-faq-wrap" id="faqList">
        <details class="fc-faq fc-reveal" open><summary><span data-i18n="faq_q1">Kam ir domātas konsultācijas?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a1">Visiem, kas vēlas sakārtot uzturu zinātniski pamatotā veidā — neatkarīgi no vecuma vai mērķa.</p></div></details>
        <details class="fc-faq fc-reveal"><summary><span data-i18n="faq_q2">Kāda ir atšķirība no parasta dietologa?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a2">Mana pieeja balstās pētniecībā un individuālos datos. Katrs ieteikums ir pielāgots tieši Jūsu situācijai.</p></div></details>
        <details class="fc-faq fc-reveal"><summary><span data-i18n="faq_q3">Vai konsultācijas ir pieejamas tiešsaistē?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a3">Jā, strādāju gan klātienē Rīgā, gan tiešsaistē. Video konsultācijas ir tikpat efektīvas.</p></div></details>
        <details class="fc-faq fc-reveal"><summary><span data-i18n="faq_q4">Cik ātri var sagaidīt rezultātus?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a4">Pirmās pozitīvās izmaiņas parasti jūtamas jau 2–3 nedēļu laikā, ilgtspējīgi rezultāti — 2–4 mēnešos.</p></div></details>
        <details class="fc-faq fc-reveal"><summary><span data-i18n="faq_q5">Cik maksā konsultācija?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a5">Individuālā konsultācija (60 min) — no 65 €. Cena ietver pilnu uztura analīzi un personalizētu plānu.</p></div></details>
        <details class="fc-faq fc-reveal"><summary><span data-i18n="faq_q6">Kā sagatavoties pirmajai konsultācijai?</span><span class="ic"><i class="ph ph-plus"></i></span></summary><div class="ans"><p data-i18n="faq_a6">Īpaša sagatavošanās nav nepieciešama. Ja ir nesenas analīzes — paņemiet līdzi, pārējo izplānosim kopā.</p></div></details>
      </div>
    </div>
  </section>

  <!-- Exclusive-open FAQ -->
  <script is:inline>
    (function () {
      var list = document.getElementById('faqList');
      if (!list) return;
      list.addEventListener('toggle', function (e) {
        if (!e.target.open) return;
        var items = list.querySelectorAll('details');
        for (var i = 0; i < items.length; i++) if (items[i] !== e.target) items[i].removeAttribute('open');
      }, true);
    })();
  </script>

  <!-- BOOKING -->
  <section id="contact" class="fc-block fc-bg-tint">
    <div class="fc-wrap fc-book-grid">
      <div class="fc-reveal">
        <span class="fc-eyebrow" data-i18n="booking_eyebrow">Individuāla konsultācija</span>
        <div class="fc-head"><h2 data-i18n="booking_title">Rezervējiet konsultāciju</h2><p data-i18n="booking_subtitle">Izvēlieties sev ērtu datumu un laiku. Pieejamība tiek atjaunināta reāllaikā.</p></div>
        <div class="fc-creds" style="margin-top:26px;">
          <div class="fc-cred"><i class="ph ph-shield-check"></i><div><b data-i18n="booking_trust_compact_1">Konfidenciāli</b></div></div>
          <div class="fc-cred"><i class="ph ph-video-camera"></i><div><b data-i18n="booking_trust_compact_2">Klātienē vai online</b></div></div>
          <div class="fc-cred"><i class="ph ph-clock"></i><div><b data-i18n="booking_trust_compact_3">Atbilde 24h</b></div></div>
        </div>
      </div>
      <div class="fc-book-card fc-reveal">
        <div id="bookingCalendar" class="booking-calendar-wrapper"></div>
        <p class="fc-booknote"><i class="ph ph-envelope-simple"></i> <span data-i18n="booking_note">Pēc rezervācijas saņemsiet apstiprinājumu e-pastā.</span></p>
      </div>
    </div>
    <div class="fc-wrap">
      <div class="fc-book-flex">
        <i class="ph ph-info" aria-hidden="true"></i>
        <span data-i18n="booking_flexibility">Pieteikšanās iespējama arī ārpus darba laika. Konsultācijas pieejamas klātienē Rīgā un tiešsaistē.</span>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="fc-final">
    <div class="fc-wrap">
      <div class="fc-final-card fc-reveal">
        <h2 data-i18n="final_cta_title">Gatavi sākt ceļu uz labāku veselību?</h2>
        <p data-i18n="final_cta_text">Pirmais solis ir vienkāršs — izvēlieties laiku, un es parūpēšos par pārējo.</p>
        <a href="#contact" class="fc-btn fc-btn--light" data-i18n="final_cta_btn">Rezervēt konsultāciju</a>
      </div>
    </div>
  </section>
</main>

<SiteFooter />

<!-- Reveal on scroll -->
<script is:inline>
  (function () {
    var els = document.querySelectorAll('.fc-reveal');
    if (!('IntersectionObserver' in window) || !els.length) { els.forEach(function (e) { e.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
