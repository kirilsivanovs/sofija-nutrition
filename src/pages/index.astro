---
import Layout from '../layouts/Layout.astro';
import ScrollToTop from '../components/common/ScrollToTop.astro';
---

<Layout
  title="Dietoloģe Rīgā — Sofija Ivanova | Personalizētas Uztura Konsultācijas"
  description="Sertificēta dietoloģe Rīgā (Nr. 75650061277). Individuālas uztura konsultācijas klātienē un tiešsaistē. Diabēta profilakse, personalizēts uztura plāns, metabolā veselība. MSc uzturzinātnē, doktorante LU."
  canonicalPath="/"
>
  <!-- Skip to Content (Accessibility) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-9999 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:outline-none"
  >
    Pāriet uz saturu
  </a>

  <!-- Header -->
  <header
    class="bg-white/95 backdrop-blur-sm sticky top-0 z-1000 shadow-sm border-b border-gray-100/50 transition-transform duration-300"
    id="site-header"
    role="banner"
  >
    <!-- Top Bar with Logo and Language -->
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-4 md:py-5">
      <div class="flex justify-between items-center">
        <!-- Logo -->
        <a href="#" class="no-underline cursor-pointer group">
          <div class="flex items-center gap-3">
            <img
              src="/assets/img/logo.svg"
              alt="Sofija Ivanova uztura speciāliste logo"
              class="h-8 md:h-10 w-auto"
            />
            <div class="flex flex-col">
              <span
                class="font-serif text-xl md:text-2xl font-semibold text-primary group-hover:text-accent transition-colors"
                >Sofija Ivanova</span
              >
              <span
                class="text-xs md:text-sm text-gray-500 uppercase tracking-widest"
                data-i18n="header_subtitle">Rīga · Zinātniska pieeja</span
              >
            </div>
          </div>
        </a>

        <!-- Language Switcher (Desktop) -->
        <div class="hidden md:flex gap-2 text-sm">
          <button class="lang-btn btn-chip" data-lang="lv">LV</button>
          <button class="lang-btn btn-chip" data-lang="en">EN</button>
          <button class="lang-btn btn-chip" data-lang="ru">RU</button>
        </div>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 mobile-menu-btn z-999 relative cursor-pointer"
          style="-webkit-tap-highlight-color:transparent;touch-action:manipulation;"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-nav-menu"
        >
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs (Desktop) -->
    <nav class="hidden md:block border-t border-gray-100" aria-label="Galvenā navigācija">
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <div class="flex gap-1">
          <a href="#services" class="nav-tab">
            <span data-i18n="nav_services">Pakalpojumi</span>
          </a>
          <a href="#about" class="nav-tab">
            <span data-i18n="nav_about">Par mani</span>
          </a>
          <a href="#faq" class="nav-tab">
            <span data-i18n="nav_faq">BUJ</span>
          </a>
          <a href="#contact" class="nav-tab">
            <span data-i18n="nav_contact">Pieteikties</span>
          </a>
          <a href="/.auth/login/aad?post_login_redirect_uri=/cabinet" class="nav-tab">
            <span data-i18n="nav_cabinet">Pacienta kabinets</span>
          </a>
        </div>
      </div>
    </nav>
  </header>

  <!-- Mobile Nav -->
  <div id="mobile-nav-menu" class="mobile-nav-menu">
    <a href="#services" data-i18n="nav_services" class="mobile-nav-item">Pakalpojumi</a>
    <a href="#about" data-i18n="nav_about" class="mobile-nav-item">Par mani</a>
    <a href="#faq" data-i18n="nav_faq" class="mobile-nav-item">BUJ</a>
    <a href="#contact" data-i18n="nav_contact" class="mobile-nav-item">Pieteikties</a>
    <a
      href="/.auth/login/aad?post_login_redirect_uri=/cabinet"
      data-i18n="nav_cabinet"
      class="mobile-nav-item">Pacienta kabinets</a
    >
    <div class="flex gap-4 pt-6 border-t border-gray-200">
      <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="lv">LV</button>
      <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="en">EN</button>
      <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="ru">RU</button>
    </div>
  </div>

  <!-- Mobile Menu Script - inline for iOS Safari compatibility -->
  <script is:inline>
    (function () {
      var btn = document.querySelector('.mobile-menu-btn');
      var menu = document.querySelector('.mobile-nav-menu');
      if (!btn || !menu) return;

      function toggle(e) {
        e.preventDefault();
        e.stopPropagation();
        var isOpen = menu.classList.toggle('open');
        btn.classList.toggle('active', isOpen);
        btn.setAttribute('aria-expanded', String(isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
        document.body.style.position = isOpen ? 'fixed' : '';
        document.body.style.width = isOpen ? '100%' : '';
        document.body.style.top = isOpen ? '0' : '';
      }

      function close() {
        menu.classList.remove('open');
        btn.classList.remove('active');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
        document.body.style.top = '';
      }

      // iOS Safari compatible click
      btn.addEventListener('click', toggle, false);

      // Close on link click
      var links = menu.querySelectorAll('a');
      for (var i = 0; i < links.length; i++) {
        links[i].addEventListener('click', close, false);
      }

      // Close on overlay click
      menu.addEventListener(
        'click',
        function (e) {
          if (e.target === menu) close();
        },
        false
      );
    })();
  </script>

  <!-- Smart Header: hide on scroll down, show on scroll up -->
  <script is:inline>
    (function () {
      var header = document.getElementById('site-header');
      if (!header) return;
      var lastY = 0;
      var ticking = false;
      var threshold = 60; // px before hiding kicks in

      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(function () {
              var y = window.pageYOffset;
              var menuOpen = document.querySelector('.mobile-nav-menu.open');
              if (menuOpen) {
                ticking = false;
                return;
              }

              if (y > threshold && y > lastY) {
                header.style.transform = 'translateY(-100%)';
              } else {
                header.style.transform = 'translateY(0)';
              }
              lastY = y;
              ticking = false;
            });
          }
        },
        { passive: true }
      );
    })();
  </script>

  <!-- Scroll to Top Button -->
  <ScrollToTop />
</Layout>

<!-- Hero Section -->
<main id="main-content">
  <section id="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">
      <!-- Header -->
      <div class="hero__header">
        <div class="hero__eyebrow">
          <span class="hero__eyebrow-line" aria-hidden="true"></span>
          <span data-i18n="hero_eyebrow">Sertificēta dietoloģe · Rīga</span>
        </div>
        <h1 id="hero-title" class="hero__title" data-i18n="hero_title">
          Uzturs, kas<br />strādā tieši Jums
        </h1>
      </div>

      <!-- Image -->
      <div class="hero__image-column">
        <picture class="hero__picture">
          <source
            type="image/webp"
            srcset="/assets/img/hero-doctor-cutout-480w.webp 480w, /assets/img/hero-doctor-cutout-768w.webp 768w, /assets/img/hero-doctor-cutout-1024w.webp 1024w, /assets/img/hero-doctor-cutout-1440w.webp 1440w"
            sizes="(max-width: 768px) 480px, (max-width: 1024px) 768px, (max-width: 1440px) 1024px, 1440px"
          />
          <img
            src="/assets/img/hero-doctor-cutout-fallback.png"
            alt="Uztura speciāliste Sofija Ivanova — individuālas konsultācijas Rīgā un tiešsaistē"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1024"
            height="787"
          />
        </picture>
        <div class="hero__credential">
          <span class="hero__credential-title" data-i18n="hero_credential_degree"
            >Klātienē un tiešsaistē</span
          >
          <span class="hero__credential-dot" aria-hidden="true"></span>
          <span class="hero__credential-location" data-i18n="hero_credential_label">Rīga</span>
        </div>
      </div>

      <!-- Body -->
      <div class="hero__body">
        <p class="hero__subtitle" data-i18n="hero_subtitle">
          Nepalīdz diētas? Trūkst enerģijas? Vēlaties sakārtot svaru vai cukura līmeni? Palīdzēšu ar
          individuālu, zinātniski pamatotu pieeju — bez gatavām shēmām.
        </p>
        <div class="hero__actions">
          <a href="#contact" class="hero__btn hero__btn--primary" data-i18n="hero_cta_primary">
            Rezervēt konsultāciju
          </a>
          <a href="#services" class="hero__btn hero__btn--outline" data-i18n="hero_cta_secondary">
            Pakalpojumi
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Metrics Bar -->
  <section class="trust-bar">
    <div class="trust-metrics">
      <div class="trust-metric">
        <div class="trust-metric-icon"><i class="ph ph-certificate"></i></div>
        <div class="trust-metric-text">
          <span class="trust-metric-value" data-i18n="trust_msc">MSc Uzturzinātnē</span>
          <span class="trust-metric-label" data-i18n="trust_msc_sub"
            >Rīgas Stradiņa universitāte</span
          >
        </div>
      </div>
      <div class="trust-metric">
        <div class="trust-metric-icon"><i class="ph ph-graduation-cap"></i></div>
        <div class="trust-metric-text">
          <span class="trust-metric-value" data-i18n="trust_phd">Doktorante</span>
          <span class="trust-metric-label" data-i18n="trust_phd_sub">Latvijas Universitāte</span>
        </div>
      </div>
      <div class="trust-metric">
        <div class="trust-metric-icon"><i class="ph ph-shield-check"></i></div>
        <div class="trust-metric-text">
          <span class="trust-metric-value" data-i18n="trust_reg">Sertificēta dietoloģe</span>
          <span class="trust-metric-label" data-i18n="trust_reg_sub">Nr. 75650061277</span>
        </div>
      </div>
    </div>
  </section>

  <!-- "For Whom" Section — conversion driver -->
  <section class="py-16 md:py-20 bg-cream">
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10 md:mb-12">
        <h2
          class="font-serif text-3xl md:text-4xl text-primary font-medium tracking-tight mb-4"
          data-i18n="whom_title"
        >
          Konsultācija ir piemērota, ja Jūs
        </h2>
      </div>

      <div class="whom-grid">
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_1"
            >Esat izmēģinājuši vairākas diētas, bet nekas nav palīdzējis ilgtermiņā</span
          >
        </div>
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_2">Vēlaties kontrolēt svaru bez striktu ierobežojumu</span>
        </div>
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_3">Jūtat hronisko nogurumu un enerģijas trūkumu</span>
        </div>
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_4"
            >Jums ir prediabēts, insulīna rezistence vai paaugstināts cukurs</span
          >
        </div>
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_5">Vēlaties uzlabot gremošanu un zarnu veselību</span>
        </div>
        <div class="whom-item">
          <i class="ph ph-arrow-right whom-icon" aria-hidden="true"></i>
          <span data-i18n="whom_6"
            >Meklējat speciālistu, kas balstās uz zinātni, nevis modes tendencēm</span
          >
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="#contact" class="btn-cta btn-solid" data-i18n="whom_cta">
          Pieteikties konsultācijai
        </a>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-20 md:py-24 lg:py-28 bg-cream">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <!-- Section Header -->
      <div class="text-center mb-12 md:mb-16">
        <span
          class="inline-block text-sm uppercase tracking-widest text-secondary font-semibold mb-3"
          data-i18n="services_tag">Pakalpojumi</span
        >
        <h2
          class="font-serif text-3xl md:text-4xl lg:text-5xl text-primary font-medium tracking-tight mb-4"
          data-i18n="services_title"
        >
          Kā es varu Jums palīdzēt
        </h2>
        <p class="text-gray-600 text-base md:text-lg max-w-2xl mx-auto" data-i18n="services_desc">
          Katrs cilvēks ir unikāls — tāpēc mans darbs sākas ar Jūsu stāstu, nevis gatavu shēmu.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="services-grid">
        <!-- Service 1: Individual Consultation -->
        <div class="service-card">
          <div class="service-icon">
            <i class="ph ph-chats-circle"></i>
          </div>
          <h3 class="service-title" data-i18n="srv_1_title">Individuāla konsultācija</h3>
          <p class="service-desc" data-i18n="srv_1_desc">
            Sapratīsiet, kas tieši Jūsu uzturā nestrādā un ko mainīt, lai jau pirmajās nedēļās juttu
            atšķirību. Klātienē vai tiešsaistē, 60 min.
          </p>
        </div>

        <!-- Service 2: Personalized Meal Plan -->
        <div class="service-card">
          <div class="service-icon">
            <i class="ph ph-notebook"></i>
          </div>
          <h3 class="service-title" data-i18n="srv_2_title">Personalizēts uztura plāns</h3>
          <p class="service-desc" data-i18n="srv_2_desc">
            Saņemsiet konkrētu ēdienkarti, kas garšo, ir reāli iekļaujama Jūsu ikdienā un ņem vērā
            veselības mērķus. Nevis diēta — bet jauns ēšanas veids.
          </p>
        </div>

        <!-- Service 3: Metabolic Health -->
        <div class="service-card">
          <div class="service-icon">
            <i class="ph ph-heartbeat"></i>
          </div>
          <h3 class="service-title" data-i18n="srv_3_title">Metabolā veselība</h3>
          <p class="service-desc" data-i18n="srv_3_desc">
            Stabilizēsiet cukura līmeni, uzlabosiet enerģiju un kontrolēsiet svaru bez galēju
            ierobežojumu. Īpaši aktuāli ar prediabētu vai insulīna rezistenci.
          </p>
        </div>

        <!-- Service 4: Gut Health -->
        <div class="service-card">
          <div class="service-icon">
            <i class="ph ph-leaf"></i>
          </div>
          <h3 class="service-title" data-i18n="srv_5_title">Zarnu veselība</h3>
          <p class="service-desc" data-i18n="srv_5_desc">
            Atvadīsieties no vēdera uzpūšanās, diskomforta un nestabilas gremošanas. Uztura
            stratēģija, kas atjauno līdzsvaru zarnu traktā.
          </p>
        </div>

        <!-- Service 6: Long-term Support -->
        <div class="service-card">
          <div class="service-icon">
            <i class="ph ph-hand-heart"></i>
          </div>
          <h3 class="service-title" data-i18n="srv_6_title">Ilgtermiņa atbalsts</h3>
          <p class="service-desc" data-i18n="srv_6_desc">
            Rezultāts saglabājas, jo neesat viena. Follow-up vizītes, plāna korekcijas un atbalsts,
            kamēr jaunie paradumi kļūst par normu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You'll Get Section (replaces generic Process) -->
  <section class="py-20 md:py-24 lg:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="text-center mb-12 md:mb-16">
        <span
          class="inline-block text-sm uppercase tracking-widest text-secondary font-semibold mb-3"
          data-i18n="outcomes_tag">Rezultāts</span
        >
        <h2
          class="font-serif text-3xl md:text-4xl lg:text-5xl text-primary font-medium tracking-tight"
          data-i18n="outcomes_title"
        >
          Ko Jūs iegūsiet
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        <!-- Outcome 1 -->
        <div class="outcome-card">
          <div class="outcome-icon">
            <i class="ph ph-clipboard-text"></i>
          </div>
          <h3 class="outcome-title" data-i18n="out_1_title">Individuāls uztura plāns</h3>
          <p class="outcome-desc" data-i18n="out_1_desc">
            Nevis gatava shēma, bet personalizēts plāns, kas ņem vērā Jūsu veselību, garšas
            preferences un dzīvesveidu.
          </p>
        </div>

        <!-- Outcome 2 -->
        <div class="outcome-card">
          <div class="outcome-icon">
            <i class="ph ph-lightning"></i>
          </div>
          <h3 class="outcome-title" data-i18n="out_2_title">Vairāk enerģijas un skaidrība</h3>
          <p class="outcome-desc" data-i18n="out_2_desc">
            Pirmās izmaiņas jūtamas jau 2–3 nedēļās: labāks miegs, stabilāka enerģija dienā,
            skaidrāka domāšana.
          </p>
        </div>

        <!-- Outcome 3 -->
        <div class="outcome-card">
          <div class="outcome-icon">
            <i class="ph ph-trend-up"></i>
          </div>
          <h3 class="outcome-title" data-i18n="out_3_title">Ilgtspējīgi rezultāti</h3>
          <p class="outcome-desc" data-i18n="out_3_desc">
            Bez jojo efekta. Iemācīsieties ēst pareizi sev — lai rezultāti saglabājas gadiem, ne
            tikai nedēļām.
          </p>
        </div>
      </div>

      <!-- Price hint -->
      <div class="mt-12 md:mt-16 text-center">
        <div
          class="inline-flex items-center gap-4 bg-cream rounded-2xl px-6 md:px-10 py-5 border border-secondary/15"
        >
          <div class="text-center">
            <span
              class="text-sm uppercase tracking-wider text-gray-500 block mb-1"
              data-i18n="price_consult">Konsultācija (60 min)</span
            >
            <span class="font-serif text-2xl font-bold text-primary" data-i18n="price_consult_val"
              >no 65 €</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 md:py-24 lg:py-28 bg-cream">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <!-- Two-column layout with photo -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16 md:mb-20">
        <!-- Photo Column -->
        <div class="relative">
          <div class="relative rounded-2xl overflow-hidden shadow-lg border border-gray-100/50">
            <picture>
              <source
                type="image/webp"
                srcset="/assets/img/aboutme-480w.webp 480w, /assets/img/aboutme-768w.webp 768w, /assets/img/aboutme-1024w.webp 1024w"
                sizes="(max-width: 768px) 480px, (max-width: 1024px) 768px, 1024px"
              />
              <img
                src="/assets/img/aboutme-fallback.png"
                alt="Uztura speciāliste Sofija Ivanova — personalizēta uztura konsultācija Rīgā"
                class="w-full aspect-4/3 object-cover"
                loading="lazy"
                decoding="async"
                width="1024"
                height="768"
              />
            </picture>
          </div>
        </div>

        <!-- Text Column -->
        <div>
          <span
            class="inline-block text-sm uppercase tracking-widest text-secondary font-semibold mb-4"
            data-i18n="about_tag">Par mani</span
          >
          <h2
            class="font-serif text-3xl md:text-4xl lg:text-5xl text-primary font-medium tracking-tight mb-6"
          >
            Sofija Ivanova
          </h2>
          <p class="text-lg md:text-xl text-gray-700 leading-relaxed mb-6" data-i18n="about_lead">
            Esmu sertificēta dietoloģe un doktorante Latvijas Universitātes Klīniskās un
            personalizētās medicīnas katedrā. Pētījumu fokuss — uztura loma diabēta ārstēšanā un
            profilaksē.
          </p>
          <p class="text-base text-gray-600 leading-relaxed" data-i18n="about_text">
            Mans mērķis — apvienot zinātniskos pierādījumus ar praktiskām stratēģijām, palīdzot
            cilvēkiem veikt ilgtspējīgas dzīvesveida izmaiņas, samazināt hronisko slimību risku un
            uzlabot ilgtermiņa veselības rezultātus.
          </p>

          <!-- Certification Badges -->
          <div class="cert-badges">
            <div class="cert-badge">
              <div class="cert-badge-icon">
                <i class="ph ph-graduation-cap"></i>
              </div>
              <div class="cert-badge-text">
                <span class="cert-badge-org">Rīgas Stradiņa universitāte</span>
                <span class="cert-badge-role">MSc Uzturzinātne</span>
              </div>
            </div>
            <div class="cert-badge">
              <div class="cert-badge-icon">
                <i class="ph ph-book-open-text"></i>
              </div>
              <div class="cert-badge-text">
                <span class="cert-badge-org">Latvijas Universitāte</span>
