                        <h2 class="font-serif text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3" data-i18n="program_title">14 dienu CGM programma</h2>
                        <p class="text-white/90 text-base" data-i18n="program_subtitle">Pilna diagnostika un personalizēts rīcības plāns</p>
                    </div>
                </div>
            </div>
            
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
                <!-- Program Info -->
                <div class="lg:col-span-3">
                    
                    <!-- What's Included -->
                    <div class="mb-8">
                        <h4 class="text-sm uppercase tracking-wider text-gray-500 font-semibold mb-4" data-i18n="program_includes_title">Kas iekļauts:</h4>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <i class="ph ph-check text-accent text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_item_1">CGM sensora uzlikšana uz 14 dienām</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-check text-accent text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_item_2">Glikozes datu analīze un detalizēta atskaite</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-check text-accent text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_item_3">60 min konsultācija (online vai klātienē)</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-check text-accent text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_item_4">Personalizēts uztura plāns uz 4 nedēļām</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-check text-accent text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_item_5">Follow-up zvans pēc 2–3 nedēļām</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Who Is It For -->
                    <div>
                        <h4 class="text-sm uppercase tracking-wider text-gray-500 font-semibold mb-4" data-i18n="program_for_title">Kam paredzēts:</h4>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <i class="ph ph-user text-secondary text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_for_1">Cilvēkiem ar prediabētu vai insulīna rezistenci</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-user text-secondary text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_for_2">Cilvēkiem ar 2. tipa diabēta risku</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i class="ph ph-user text-secondary text-lg shrink-0 mt-0.5"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="program_for_3">Cilvēkiem ar svara svārstībām un hronisko nogurumu</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Price Card -->
                <div class="lg:col-span-2">
                    <div class="bg-white/95 p-6 md:p-8 rounded-2xl shadow-lg border border-[#E6E0D6] sticky top-24">
                        <!-- Price -->
                        <div class="text-center pb-6 border-b border-gray-100 mb-6">
                            <span class="text-sm uppercase tracking-wider text-gray-500 block mb-2" data-i18n="price_label">Programmas cena</span>
                            <span class="font-serif text-4xl md:text-5xl font-bold text-primary block" data-i18n="price_value">no 249 €</span>
                            <span class="text-sm text-gray-500 mt-1 block" data-i18n="price_note">CGM sensors iekļauts cenā</span>
                        </div>
                        
                        <!-- Results -->
                        <div class="mb-6">
                            <h4 class="text-sm uppercase tracking-wider text-gray-500 font-semibold mb-4" data-i18n="result_title">Rezultāts:</h4>
                            <div class="space-y-3">
                                <p class="flex items-start gap-2 text-base text-gray-700">
                                    <i class="ph ph-arrow-right text-primary shrink-0 mt-0.5"></i>
                                    <span data-i18n="result_1">Sapratīsiet, kuri ēdieni tieši Jums izraisa straujus cukura lēcienus</span>
                                </p>
                                <p class="flex items-start gap-2 text-base text-gray-700">
                                    <i class="ph ph-arrow-right text-primary shrink-0 mt-0.5"></i>
                                    <span data-i18n="result_2">Saņemsiet konkrētu rīcības plānu, kā stabilizēt glikozes līmeni ikdienā</span>
                                </p>
                            </div>
                        </div>

                        <!-- CTA -->
                        <a href="#contact" class="btn-cta btn-solid w-full text-base md:text-lg" data-i18n="program_cta">Pieteikties programmai</a>
                        
                        <p class="flex items-center justify-center gap-2 text-sm text-gray-500">
                            <i class="ph ph-shield-check text-accent"></i>
                            <span data-i18n="program_guarantee">Pirmā konsultācija bezmaksas</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Approach Section -->
    <section id="approach" class="py-16 md:py-24 bg-white">
        <div class="max-w-6xl mx-auto px-4 md:px-8">
            <!-- Header -->
            <div class="text-center mb-12">
                <h2 class="font-serif text-2xl md:text-3xl lg:text-4xl font-bold text-primary" data-i18n="approach_title">Kāpēc vispārīgas diētas nestrādā?</h2>
            </div>

            <!-- Two-row layout -->
            <div class="space-y-8">
                <!-- Row 1: Text + Chart -->
                <div class="bg-cream rounded-2xl p-6 md:p-10 lg:p-12">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                        <div>
                            <h3 class="font-serif text-xl md:text-2xl font-bold text-primary mb-4" data-i18n="cgm_unique_title">Jūsu organisms reaģē atšķirīgi</h3>
                            <p class="text-gray-700 leading-relaxed" data-i18n="cgm_unique_desc">Tas pats produkts vienam cilvēkam var būt ideāls, citam — izraisīt cukura lēcienu. CGM sensors 14 dienas fiksē katru reakciju.</p>
                        </div>
                        
                        <!-- Chart -->
                        <div class="bg-white/95 rounded-xl p-4 md:p-6 shadow-sm border border-gray-100/70">
                            <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-2 mb-4">
                                <span class="text-sm font-medium text-gray-700" data-i18n="chart_glucose_response">Glikozes reakcija</span>
                                <div class="flex gap-4 text-sm">
                                    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-accent shrink-0"></span> <span data-i18n="chart_after">Pēc programmas</span></span>
                                    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500 shrink-0"></span> <span data-i18n="chart_before">Pirms</span></span>
                                </div>
                            </div>
                            <svg viewBox="0 0 400 150" class="w-full h-auto" role="img" aria-label="Glikozes līmeņa grafiks">
                                <line x1="0" y1="30" x2="400" y2="30" stroke="#eee" />
                                <line x1="0" y1="75" x2="400" y2="75" stroke="#eee" />
                                <line x1="0" y1="120" x2="400" y2="120" stroke="#eee" />
                                <path d="M0,100 C50,100 60,40 90,40 S120,110 150,110 S180,20 210,20 S240,100 270,100 S300,50 330,50 S360,110 400,110" 
