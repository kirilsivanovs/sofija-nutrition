  <!-- FAQ Accordion Script (exclusive open — close others when one opens) -->
  <script is:inline>
    (function () {
      var list = document.getElementById('faqList');
      if (!list) return;
      list.addEventListener(
        'toggle',
        function (e) {
          if (!e.target.open) return;
          var items = list.querySelectorAll('details.faq-item');
          for (var i = 0; i < items.length; i++) {
            if (items[i] !== e.target) items[i].removeAttribute('open');
          }
        },
        true
      );
    })();
  </script>

