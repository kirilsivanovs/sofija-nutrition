---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sofija Ivanova | Uztura Speciāliste Rīgā | Diabēta Profilakse un CGM Analīze">
    <!-- Header -->
    <header class="bg-white/95 backdrop-blur-sm py-4 md:py-5 sticky top-0 z-50 shadow-sm border-b border-gray-100/50">
        <div class="max-w-6xl mx-auto px-4 md:px-8">
            <nav class="flex justify-between items-center">
                <!-- Logo -->
                <a href="#" class="no-underline cursor-pointer group">
                    <div class="flex items-center gap-3">
                        <img src="/assets/img/logo.svg" alt="SI Logo" class="h-8 md:h-10 w-auto">
                        <div class="flex flex-col">
                            <span class="font-serif text-xl md:text-2xl font-semibold text-primary group-hover:text-accent transition-colors">Sofija Ivanova</span>
                            <span class="text-xs md:text-sm text-gray-500 uppercase tracking-widest" data-i18n="header_subtitle">Uztura speciāliste · PhD</span>
                        </div>
                    </div>
                </a>
                
                <!-- Desktop Nav -->
                <div class="hidden md:flex items-center gap-8">
                    <div class="flex gap-6">
                        <a href="#program" data-i18n="nav_program" class="text-base font-medium text-gray-600 transition-colors cursor-pointer relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-secondary after:transition-all hover:after:w-full">Programma</a>
                        <a href="#how-it-works" data-i18n="nav_how" class="text-base font-medium text-gray-600 transition-colors cursor-pointer relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-secondary after:transition-all hover:after:w-full">Kā tas strādā</a>
                        <a href="#about" data-i18n="nav_about" class="text-base font-medium text-gray-600 transition-colors cursor-pointer relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-secondary after:transition-all hover:after:w-full">Par mani</a>
                        <a href="#contact" data-i18n="nav_contact" class="text-base font-medium text-gray-600 transition-colors cursor-pointer relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-secondary after:transition-all hover:after:w-full">Pieteikties</a>
                    </div>
                    
                    <div class="flex gap-2 text-sm border-l border-gray-200 pl-4">
                        <button class="lang-btn btn-chip" data-lang="lv">LV</button>
                        <button class="lang-btn btn-chip" data-lang="en">EN</button>
                        <button class="lang-btn btn-chip" data-lang="ru">RU</button>
                    </div>
                </div>
                
                <!-- Mobile Menu Button -->
                <button type="button" onclick="this.classList.toggle('active');document.getElementById('mobile-nav-menu').classList.toggle('open');document.body.style.overflow=document.getElementById('mobile-nav-menu').classList.contains('open')?'hidden':'';" class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 mobile-menu-btn z-[999] relative cursor-pointer" style="-webkit-tap-highlight-color:transparent;touch-action:manipulation;" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav-menu">
                    <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
                    <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
                    <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;"></span>
                </button>
            </nav>
            
            <!-- Mobile Nav -->
            <div id="mobile-nav-menu" class="mobile-nav-menu">
                <a href="#program" data-i18n="nav_program" class="text-lg text-gray-700 py-3 px-2">Programma</a>
                <a href="#how-it-works" data-i18n="nav_how" class="text-lg text-gray-700 py-3 px-2">Kā tas strādā</a>
                <a href="#about" data-i18n="nav_about" class="text-lg text-gray-700 py-3 px-2">Par mani</a>
                <a href="#contact" data-i18n="nav_contact" class="text-lg text-gray-700 py-3 px-2">Pieteikties</a>
                <div class="flex gap-4 pt-4 border-t">
                    <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="lv">LV</button>
                    <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="en">EN</button>
                    <button class="lang-btn btn-chip bg-gray-100 text-base" data-lang="ru">RU</button>
                </div>
            </div>
        </div>
        
        <!-- Mobile Menu Script - inline for iOS Safari compatibility -->
        <script is:inline>
        (function() {
            var btn = document.querySelector('.mobile-menu-btn');
            var menu = document.querySelector('.mobile-nav-menu');
            if (!btn || !menu) return;
            
            function toggle(e) {
                e.preventDefault();
                e.stopPropagation();
                var isOpen = menu.classList.toggle('open');
                btn.classList.toggle('active', isOpen);
                btn.setAttribute('aria-expanded', String(isOpen));
                document.body.style.overflow = isOpen ? 'hidden' : '';
                document.body.style.position = isOpen ? 'fixed' : '';
                document.body.style.width = isOpen ? '100%' : '';
                document.body.style.top = isOpen ? '0' : '';
            }
            
            function close() {
                menu.classList.remove('open');
                btn.classList.remove('active');
                btn.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
                document.body.style.position = '';
                document.body.style.width = '';
                document.body.style.top = '';
            }
            
            // Multiple event types for iOS Safari
            btn.addEventListener('click', toggle, false);
            btn.addEventListener('touchstart', function(e) {
                e.preventDefault();
                toggle(e);
            }, { passive: false });
            
            // Close on link click
            var links = menu.querySelectorAll('a');
            for (var i = 0; i < links.length; i++) {
                links[i].addEventListener('click', close, false);
            }
            
            // Close on overlay click
            menu.addEventListener('click', function(e) {
                if (e.target === menu) close();
            }, false);
        })();
        </script>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="relative py-8 md:py-12 lg:py-16 flex items-center overflow-hidden bg-bg-light">
        <!-- Clean, professional background - subtle gradient accent -->
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-secondary/[0.03] to-transparent -z-10"></div>
        
        <div class="max-w-6xl mx-auto px-4 md:px-8 w-full">
            <!-- Integrated hero card -->
            <div class="bg-white/95 rounded-3xl shadow-[0_20px_50px_rgba(17,24,39,0.12)] border border-white/70 overflow-hidden">
                <div class="grid grid-cols-1 lg:grid-cols-5">
                    <!-- Photo - takes 2 columns -->
                    <div class="lg:col-span-2 relative" style="transform: none !important;">
                        <img 
                            src="/assets/img/photo in medical gown.png" 
                            alt="Sofija Ivanova - Sertificēta uztura speciāliste Rīgā" 
                            class="w-full h-64 md:h-80 lg:h-full lg:min-h-full object-cover object-[68%_top] lg:absolute lg:inset-0"
                            style="transform: none !important;"
                        >
                        <!-- Gradient overlay on mobile -->
                        <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent lg:hidden"></div>
                    </div>
                    
                    <!-- Text Content - takes 3 columns -->
                    <div class="lg:col-span-3 p-6 md:p-10 lg:p-12">
                        <!-- Badge -->
                        <div class="inline-flex items-center gap-2 bg-cream px-4 py-2 rounded-full mb-6">
                            <i class="ph ph-seal-check text-secondary text-lg"></i>
                            <span class="text-sm md:text-base text-primary font-medium" data-i18n="hero_badge">Reģistrēta ārstniecības persona Nr. 75650061277</span>
                        </div>
                        
                        <!-- Heading -->
                        <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold text-primary leading-tight mb-4 md:mb-6" data-i18n="hero_title">
                            14 dienās no cukura svārstībām līdz stabilam glikozes līmenim
                        </h1>
                        
                        <!-- Subtitle -->
                        <p class="text-base md:text-lg lg:text-xl text-gray-700 leading-relaxed mb-6 md:mb-8" data-i18n="hero_subtitle">
                            PhD pētniece un reģistrēta uztura speciāliste, kas palīdz cilvēkiem ar prediabētu un insulīna rezistenci stabilizēt cukura līmeni, izmantojot CGM datus.
                        </p>

                        <!-- Benefits - horizontal on desktop -->
                        <div class="grid grid-cols-2 gap-3 mb-6 md:mb-8">
                            <div class="flex items-center gap-3">
                                <i class="ph ph-check-circle text-accent text-xl shrink-0"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="hero_benefit_1">14 dienu CGM monitorēšana</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <i class="ph ph-check-circle text-accent text-xl shrink-0"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="hero_benefit_2">Datu analīze saprotamā valodā</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <i class="ph ph-check-circle text-accent text-xl shrink-0"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="hero_benefit_3">Personalizēts uztura plāns</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <i class="ph ph-check-circle text-accent text-xl shrink-0"></i>
                                <span class="text-sm md:text-base text-gray-700" data-i18n="hero_benefit_4">Fokuss uz prediabētu</span>
                            </div>
                        </div>

                        <!-- CTA Buttons -->
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="#program" class="btn-cta btn-solid text-base md:text-lg" data-i18n="hero_cta_primary">
                                Pieteikties 14 dienu programmai
                            </a>
                            <a href="#contact" class="btn-cta btn-outline text-base md:text-lg" data-i18n="hero_cta_secondary">
                                Bezmaksas 15 min konsultācija
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="py-16 md:py-24 bg-white/95">
        
        <div class="max-w-6xl mx-auto px-4 md:px-8">
            <!-- Section Header -->
            <div class="text-center mb-12 md:mb-16">
                <h2 class="font-serif text-2xl md:text-3xl lg:text-4xl font-bold text-primary mb-3" data-i18n="how_title">Kā tas strādā?</h2>
                <p class="text-gray-700 text-base md:text-lg max-w-2xl mx-auto" data-i18n="how_subtitle">Vienkāršs process, ko varēsiet iekļaut savā ikdienā</p>
            </div>

            <!-- Process Steps -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
                <!-- Step 1 -->
                <div class="flex flex-col items-center text-center bg-white/90 border border-[#E6E0D6] rounded-2xl p-6 md:p-7 shadow-[0_12px_28px_rgba(17,24,39,0.08)]">
                    <div class="w-16 h-16 bg-white border border-[#E6E0D6] rounded-full flex items-center justify-center mb-4">
                        <i class="ph ph-syringe text-primary text-2xl"></i>
                    </div>
                    <h4 class="font-sans font-bold text-primary text-xl md:text-2xl mb-4 min-h-[3.5rem] flex items-center justify-center" data-i18n="step_1_title">1. Uzliekam CGM sensoru</h4>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed" data-i18n="step_1_desc">Mazs, nemanāms sensors uz rokas. Pilnīgi nesāpīga procedūra.</p>
                </div>
                
                <!-- Step 2 -->
                <div class="flex flex-col items-center text-center bg-white/90 border border-[#E6E0D6] rounded-2xl p-6 md:p-7 shadow-[0_12px_28px_rgba(17,24,39,0.08)]">
                    <div class="w-16 h-16 bg-white border border-[#E6E0D6] rounded-full flex items-center justify-center mb-4">
                        <i class="ph ph-calendar-check text-primary text-2xl"></i>
                    </div>
                    <h4 class="font-sans font-bold text-primary text-xl md:text-2xl mb-4 min-h-[3.5rem] flex items-center justify-center" data-i18n="step_2_title">2. Dzīvojiet savu ierasto dzīvi</h4>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed" data-i18n="step_2_desc">Ēdat kā parasti 14 dienas. Sensors fiksē katras maltītes ietekmi.</p>
                </div>
                
                <!-- Step 3 -->
                <div class="flex flex-col items-center text-center bg-white/90 border border-[#E6E0D6] rounded-2xl p-6 md:p-7 shadow-[0_12px_28px_rgba(17,24,39,0.08)]">
                    <div class="w-16 h-16 bg-white border border-[#E6E0D6] rounded-full flex items-center justify-center mb-4">
                        <i class="ph ph-chart-line text-primary text-2xl"></i>
                    </div>
                    <h4 class="font-sans font-bold text-primary text-xl md:text-2xl mb-4 min-h-[3.5rem] flex items-center justify-center" data-i18n="step_3_title">3. Analizējam datus kopā</h4>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed" data-i18n="step_3_desc">Redzam, kuri ēdieni Jūs stabilizē, kuri — izraisa cukura lēcienus.</p>
                </div>
                
                <!-- Step 4 -->
                <div class="flex flex-col items-center text-center bg-white/90 border border-[#E6E0D6] rounded-2xl p-6 md:p-7 shadow-[0_12px_28px_rgba(17,24,39,0.08)]">
                    <div class="w-16 h-16 bg-white border border-[#E6E0D6] rounded-full flex items-center justify-center mb-4">
