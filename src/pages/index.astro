<!-- FAQ Section -->
<section id="faq" class="py-20 md:py-24 lg:py-28 bg-white">
  <div class="max-w-3xl mx-auto px-4 md:px-8">
    <div class="text-center mb-12 md:mb-16">
      <span
        class="inline-block text-sm uppercase tracking-widest text-secondary font-semibold mb-3"
        data-i18n="faq_tag">Biežāk uzdotie jautājumi</span
      >
      <h2
        class="font-serif text-3xl md:text-4xl lg:text-5xl text-primary font-semibold tracking-tight"
        data-i18n="faq_title"
      >
        Kas jāzina pirms pieteikšanās
      </h2>
    </div>

    <div class="faq-list" id="faqList">
      <!-- FAQ 1 -->
      <div class="faq-item">
        <button class="faq-question" type="button">
          <span data-i18n="faq_q1">Kam ir domātas konsultācijas?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <div class="faq-answer">
          <p class="faq-answer-inner" data-i18n="faq_a1">
            Visiem, kas vēlas sakārtot uzturu zinātniski pamatotā veidā — neatkarīgi no vecuma vai
            mērķa. Strādāju ar svara kontroli, enerģijas problēmām, metabolo veselību, prediabētu,
            zarnu veselību un uztura optimizāciju.
          </p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="faq-item">
        <button class="faq-question" type="button">
          <span data-i18n="faq_q2">Kāda ir atšķirība no parasta dietologa?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <div class="faq-answer">
          <p class="faq-answer-inner" data-i18n="faq_a2">
            Mana pieeja balstās pētniecībā un individuālos datos. Neizrakstu vispārīgas diētas —
            katrs ieteikums ir pielāgots tieši Jūsu situācijai. Papildus piedāvāju CGM diagnostiku,
            kas ir unikāla iespēja Latvijā.
          </p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="faq-item">
        <button class="faq-question" type="button">
          <span data-i18n="faq_q3">Vai konsultācijas ir pieejamas tiešsaistē?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <div class="faq-answer">
          <p class="faq-answer-inner" data-i18n="faq_a3">
            Jā, strādāju gan klātienē Rīgā, gan tiešsaistē. Video konsultācijas ir tikpat efektīvas
            un pieejamas klientiem visā Latvijā un ārpus tās.
          </p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="faq-item">
        <button class="faq-question" type="button">
          <span data-i18n="faq_q4">Cik ātri var sagaidīt rezultātus?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <div class="faq-answer">
          <p class="faq-answer-inner" data-i18n="faq_a4">
            Pirmās pozitīvās izmaiņas (enerģija, miegs, pašsajūta) parasti jūtamas jau 2–3 nedēļu
            laikā. Ilgtspējīgi svara un veselības rezultāti — 2–4 mēnešos. Regulāras follow-up
            konsultācijas nodrošina, ka progress turpinās ilgtermiņā.
          </p>
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="faq-item">
        <button class="faq-question" type="button">
          <span data-i18n="faq_q5">Kas ir CGM sensors un kam tas noderēs?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <div class="faq-answer">
          <p class="faq-answer-inner" data-i18n="faq_a5">
            CGM (nepārtrauktās glikozes monitorēšanas) sensors ir neliela ierīce uz ādas, kas 14
            dienas mēra cukura līmeni reāllaikā. Tas parāda, kā tieši Jūsu organisms reaģē uz katru
            ēdienu, stresu un miegu. Latvijā šo pakalpojumu uztura konsultāciju ietvaros piedāvāju
            tikai es — tā ir unikāla iespēja saņemt precīzus, personalizētus datus.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Toggle Script -->
<script is:inline>
  (function () {
    var list = document.getElementById('faqList');
    if (!list) return;
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('.faq-question');
      if (!btn) return;
      var item = btn.closest('.faq-item');
      var wasOpen = item.classList.contains('open');
      // Close all
      var items = list.querySelectorAll('.faq-item');
      for (var i = 0; i < items.length; i++) items[i].classList.remove('open');
      // Toggle clicked
      if (!wasOpen) item.classList.add('open');
    });
  })();
</script>

