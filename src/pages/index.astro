---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/common/AppHeader.astro';
import ScrollToTop from '../components/common/ScrollToTop.astro';
import '../styles/booking.css';
import '../styles/chart.css';
import '../styles/question-body.css';
---

<Layout
  title="Dietoloģe Rīgā — Sofija Ivanova | Personalizētas Uztura Konsultācijas"
  description="Sertificēta dietoloģe Rīgā. Individuālas uztura konsultācijas klātienē un tiešsaistē. Diabēta profilakse, personalizēts uztura plāns, metabolā veselība. MSc uzturzinātnē, doktorante LU."
  canonicalPath="/"
>
  <!-- Skip to Content (Accessibility) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-9999 focus:bg-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:outline-none"
  >
    Pāriet uz saturu
  </a>

  <AppHeader variant="public" showAuth={false} subtitle="uztura speciāliste, Rīga" />

  <!-- Scroll to Top Button -->
  <ScrollToTop />
<!-- Hero Section -->
<main id="main-content">
  <section id="hero" class="hero-chart" aria-labelledby="hero-title">
    <div class="hero-chart__inner">
      <div>
        <h1 id="hero-title" class="hero-chart__title" data-i18n="hero_title">
          Vienas un tās pašas brokastis. <strong>Divas dažādas glikozes līknes.</strong>
        </h1>
        <p class="hero-chart__lead" data-i18n="hero_lead">
          Tāpēc es nesāku ar gatavu ēdienkarti. Pirmajā konsultācijā apskatām Jūsu analīzes, ikdienu
          un ēšanas paradumus, un plānu veidojam no tiem.
        </p>
        <a class="btn-cta btn-solid" href="#f-q6"
          ><span data-i18n="hero_cta">Pieteikties konsultācijai</span
          ><i class="ph ph-arrow-right" aria-hidden="true"></i
        ></a>
        <ul class="hero-chart__facts">
          <li data-i18n="hero_fact">60 minūtes, klātienē Rīgā vai tiešsaistē</li>
        </ul>
      </div>

      <figure class="hero-chart__chart">
        <div class="hero-chart__chart-head">
          <h2 data-i18n="hero_chart_heading">Glikoze pēc brokastīm, 07:00–11:00</h2>
          <ul class="hero-chart__legend">
            <li>
              <i class="hero-chart__legend-mark hero-chart__legend-mark--a" aria-hidden="true"></i>
              <span data-i18n="hero_legend_a">Cilvēks A</span>
            </li>
            <li>
              <i class="hero-chart__legend-mark hero-chart__legend-mark--b" aria-hidden="true"></i>
              <span data-i18n="hero_legend_b">Cilvēks B</span>
            </li>
          </ul>
        </div>
        <svg
          id="hero-svg"
          class="hero-chart__svg"
          viewBox="0 0 640 352"
          role="img"
          tabindex="0"
          aria-label="Divu cilvēku glikozes līknes pēc vienādām brokastīm. A paliek diapazonā 3,9–7,8 mmol/L, B uz laiku pārsniedz 7,8 mmol/L."
        ></svg>
        <dl class="hero-chart__readout" aria-live="polite">
          <div>
            <dt data-i18n="hero_readout_time">Laiks</dt>
            <dd id="hero-t">08:30</dd>
          </div>
          <div>
            <dt data-i18n="hero_readout_a">Cilvēks A</dt>
            <dd id="hero-va">7,1 mmol/L</dd>
          </div>
          <div>
            <dt data-i18n="hero_readout_b">Cilvēks B</dt>
            <dd id="hero-vb">10,1 mmol/L</dd>
          </div>
        </dl>
        <figcaption class="hero-chart__caption">
          <span data-i18n="hero_chart_caption"
            >Ilustratīvi, sintētiski dati, nevis pacientu mērījumi. Diapazons 3,9–7,8 mmol/L.</span
          >
          <!-- copy pending from Sofija: 7.8 caption wording -->
          <span id="hero-tir"></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Six-question body (SN-015.2) — sticky index + questions, replaces the old
       trust-metrics/for-whom/services/outcomes/about-badges/FAQ sections. #services
       and #faq are kept as anchor ids on the wrapper (interim mapping for the frozen
       header's nav, not a redesign of its copy). -->
  <div class="F-body" id="faq">
    <nav class="question-index" id="services" aria-label="Jautājumi šajā lapā">
      <h2 data-i18n="qindex_title">Jautājumi šajā lapā</h2>
      <ol id="question-index-list">
        <li><a href="#f-q1" data-i18n="qindex_1">Vai konsultācija ir piemērota man?</a></li>
        <li><a href="#f-q2" data-i18n="qindex_2">Kā notiek pirmā konsultācija?</a></li>
        <li><a href="#f-q3" data-i18n="qindex_3">Cik tas maksā?</a></li>
        <li><a href="#about" data-i18n="qindex_4">Kas ir Sofija Ivanova?</a></li>
        <li><a href="#f-q5" data-i18n="qindex_5">Ar ko šī pieeja atšķiras?</a></li>
        <li><a href="#f-q6" data-i18n="qindex_6">Kā pieteikties?</a></li>
      </ol>
      <a class="btn-cta btn-solid" href="#f-q6" data-i18n="qindex_cta">Pieteikties</a>
    </nav>

    <div class="question-list">
      <!-- Q1: fit -->
      <section class="question" id="f-q1">
        <h2 data-i18n="q1_title">Vai konsultācija ir piemērota man?</h2>
        <p data-i18n="q1_intro">
          Visiem, kas vēlas sakārtot uzturu zinātniski pamatotā veidā. Visbiežāk pie manis nāk ar
          šiem jautājumiem:
        </p>
        <dl class="question__rows">
          <dt data-i18n="q1_row1_t">Metabolā veselība</dt>
          <dd data-i18n="q1_row1_d">
            Prediabēts, insulīna rezistence, paaugstināts cukurs. Mērķis ir stabilāks glikozes
            līmenis un enerģija dienas laikā.
          </dd>
          <dt data-i18n="q1_row2_t">Svars</dt>
          <dd data-i18n="q1_row2_d">
            Svara kontrole bez striktiem ierobežojumiem, arī tad, ja vairākas diētas nav
            palīdzējušas ilgtermiņā.
          </dd>
          <dt data-i18n="q1_row3_t">Enerģija</dt>
          <dd data-i18n="q1_row3_d">Hronisks nogurums un enerģijas trūkums.</dd>
          <dt data-i18n="q1_row4_t">Gremošana</dt>
          <dd data-i18n="q1_row4_d">Vēdera uzpūšanās, diskomforts un nestabila gremošana.</dd>
        </dl>
        <!-- copy pending from Sofija: exact wording of the practice's boundary line -->
        <p class="question__scope" data-i18n="q1_scope">
          Ja Jums vajadzīga steidzama medicīniska palīdzība, vispirms vērsieties pie sava ārsta.
        </p>
      </section>

      <!-- Q2: first consultation — no photo, dropped 2026-09-26 -->
      <section class="question" id="f-q2">
        <h2 data-i18n="q2_title">Kā notiek pirmā konsultācija?</h2>
        <ol class="question__steps">
          <li data-i18n="q2_step1">
            Izvēlaties laiku kalendārā un saņemat apstiprinājumu e-pastā.
          </li>
          <li data-i18n="q2_step2">
            Ja ir nesenas analīzes (bioķīmija, glikoze, lipīdi), paņemat tās līdzi. Ja nav, sāksim
            ar to, kas ir.
          </li>
          <li data-i18n="q2_step3">
            60 minūšu saruna klātienē Rīgā vai video tiešsaistē par Jūsu ikdienu, ēšanu un mērķiem.
          </li>
          <li data-i18n="q2_step4">
            Saņemat personalizētu uztura plānu un vienojamies par nākamo soli.
          </li>
        </ol>
      </section>

      <!-- Q3: price — the site's only place price appears -->
      <section class="question" id="f-q3">
        <h2 data-i18n="q3_title">Cik tas maksā?</h2>
        <table class="question__price">
          <tr>
            <th>
              <span data-i18n="q3_row1_t">Individuāla konsultācija</span>
              <small data-i18n="q3_row1_d">60 min, klātienē vai tiešsaistē, ar uztura plānu</small>
            </th>
            <td data-i18n="q3_row1_v">no 65 €</td>
          </tr>
          <tr>
            <th>
              <span data-i18n="q3_row2_t">Atkārtota vizīte</span>
              <small data-i18n="q3_row2_d">plāna pārskatīšana un korekcijas</small>
            </th>
            <!-- prices genuinely pending Sofija, don't invent numbers -->
            <td class="question__pending" data-i18n="q3_pending">cenu precizē Sofija</td>
          </tr>
          <tr>
            <th>
              <span data-i18n="q3_row3_t">Ilgtermiņa pakete</span>
              <small data-i18n="q3_row3_d">vairākas vizītes par izdevīgāku cenu</small>
            </th>
            <td class="question__pending" data-i18n="q3_pending">cenu precizē Sofija</td>
          </tr>
        </table>
      </section>

      <!-- Q4: who is Sofija — the site's only place the register number appears -->
      <section class="question question--research" id="about">
        <h2 data-i18n="q4_title">Kas ir Sofija Ivanova?</h2>
        <div class="question__research">
          <figure>
            <div class="question__photo-crop">
              <picture>
                <source
                  type="image/webp"
                  srcset="/assets/img/conference_EASD2025_Vienna-600w.webp"
                />
                <img
                  src="/assets/img/conference_EASD2025_Vienna.jpg"
                  alt="Sofija Ivanova uzstājas EASD 2025 kongresā Vīnē"
                  decoding="async"
                  width="1400"
                  height="1054"
                />
              </picture>
            </div>
          </figure>
          <div>
            <p data-i18n="about_lead">
              Esmu doktorante Latvijas Universitātes Klīniskās un personalizētās medicīnas
              katedrā. Pētu uztura lomu diabēta ārstēšanā un profilaksē.
            </p>
            <p data-i18n="about_text">
              Latvijas Universitātē strādāju projektā PRAESIDIUM, kas pēta, kā prognozēt un
              novērst paaugstinātu glikozes līmeni tukšā dūšā.
            </p>
            <ul class="question__talks">
              <li data-i18n="q4_talk1"><span>2025</span>EASD kongress, Vīne</li>
              <li data-i18n="q4_talk2">
                <span>Lekcija</span>„Uztura loma slimību profilaksē”, Veselībpratības diena, P.
                Stradiņa KUS
              </li>
              <li data-i18n="q4_talk3"><span>Stends</span>Zinātnieku nakts</li>
            </ul>
            <!-- title wording ("sertificēta dietoloģe" vs "uztura speciāliste") pending Sofija -->
            <p class="question__cred" data-i18n="q4_cred">
              Mg.sc.sal., Rīgas Stradiņa universitāte · Doktorantūra, Latvijas Universitāte ·
              Ārstniecības personu reģistrs Nr. 75650061277
            </p>
          </div>
        </div>
      </section>

      <!-- Q5: how it differs — text only, no CGM/sensor photo (dropped 2026-09-26) -->
      <section class="question" id="f-q5">
        <h2 data-i18n="q5_title">Ar ko šī pieeja atšķiras?</h2>
        <p data-i18n="q5_p1">
          Mana pieeja balstās pētniecībā un individuālos datos. Neizrakstu vispārīgas diētas:
          katrs ieteikums ir pielāgots tieši Jūsu situācijai, analīzēm un ikdienai.
        </p>
        <p data-i18n="q5_p2">
          Grafiks lapas augšā parāda iemeslu: viens un tas pats ēdiens dažādiem cilvēkiem
          iedarbojas atšķirīgi.
        </p>
      </section>

      <!-- Q6: how to book — heading/intro only; row 3 (booking restyle) fills
           everything inside #contact below this placeholder. -->
      <section class="question" id="f-q6">
        <h2 data-i18n="q6_title">Kā pieteikties?</h2>
      </section>
    </div>
  </div>

  <!-- Question index scrollspy (active link border) + smooth-scroll on click -->
  <script is:inline>
    (function () {
      var links = document.querySelectorAll('#question-index-list a');
      if (!links.length) return;
      var byHash = {};
      links.forEach(function (a) {
        byHash[a.getAttribute('href')] = a;
      });

      var sections = document.querySelectorAll('.question');
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            var link = byHash['#' + entry.target.id];
            if (!link) return;
            if (entry.isIntersecting) {
              links.forEach(function (a) {
                a.removeAttribute('aria-current');
              });
              link.setAttribute('aria-current', 'true');
            }
          });
        },
        { rootMargin: '-40% 0px -50% 0px' }
      );
      sections.forEach(function (s) {
        observer.observe(s);
      });

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      links.forEach(function (a) {
        a.addEventListener('click', function (e) {
          var target = document.querySelector(a.getAttribute('href'));
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
        });
      });
    })();
  </script>

  <!-- Contact Section -->
  <section id="contact" class="booking-section">
    <div class="booking-shell">
      <!-- Left column: minimal context, no clutter -->
      <div class="booking-intro">
        <h2 class="booking-title" data-i18n="booking_title">Rezervējiet konsultāciju</h2>
        <p class="booking-subtitle" data-i18n="booking_subtitle">
          Izvēlieties sev ērtu datumu un laiku. Pieejamība tiek atjaunināta reāllaikā.
        </p>

        <!-- Compact trust line — replaces 3 big trust cards -->
        <div class="booking-trust-compact">
          <span class="booking-trust-item">
            <i class="ph ph-shield-check"></i>
            <span data-i18n="booking_trust_compact_1">Konfidenciāli</span>
          </span>
          <span class="booking-trust-divider"></span>
          <span class="booking-trust-item">
            <i class="ph ph-video-camera"></i>
            <span data-i18n="booking_trust_compact_2">Klātienē vai online</span>
          </span>
          <span class="booking-trust-divider"></span>
          <span class="booking-trust-item">
            <i class="ph ph-clock"></i>
            <span data-i18n="booking_trust_compact_3">Atbilde 24h</span>
          </span>
        </div>
      </div>

      <!-- Calendar card — hero of the section -->
      <div class="booking-card">
        <div id="bookingCalendar" class="booking-calendar-wrapper"></div>
        <p class="booking-note" data-i18n="booking_note">
          Pēc rezervācijas saņemsiet apstiprinājumu e-pastā.
        </p>
      </div>
    </div>

    <!-- Flexibility note -->
    <div class="booking-urgency">
      <i class="ph ph-info"></i>
      <span data-i18n="booking_flexibility"
        >Pieteikšanās iespējama arī ārpus darba laika. Konsultācijas pieejamas klātienē Rīgā un
        tiešsaistē.</span
      >
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-white text-graphite border-t border-line py-12 relative">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <!-- Brand -->
        <div class="text-center md:text-left">
          <h3 class="text-xl font-semibold mb-1">Sofija Ivanova</h3>
          <p class="text-slate text-sm" data-i18n="footer_subtitle">
            Rīga
          </p>
        </div>

        <!-- Contact Links -->
        <div class="text-center">
          <h4
            class="text-sm text-slate mb-3"
            data-i18n="footer_contact_title"
          >
            Kontakti
          </h4>
          <div class="flex flex-col items-center gap-2 text-sm">
            <a
              href="mailto:info@sofijaivanova.lv"
              class="text-graphite hover:text-navy transition-colors"
            >
              <i class="ph ph-envelope-simple" aria-hidden="true"></i> info@sofijaivanova.lv
            </a>
            <a
              href="/.auth/login/aad?post_login_redirect_uri=/cabinet"
              class="text-graphite hover:text-navy transition-colors"
            >
              <i class="ph ph-user-circle" aria-hidden="true"></i>
              <span data-i18n="nav_cabinet">Pacienta kabinets</span>
            </a>
          </div>
        </div>

        <!-- Social & Links -->
        <div class="text-center md:text-right">
          <h4
            class="text-sm text-slate mb-3"
            data-i18n="footer_follow_title"
          >
            Sekojiet
          </h4>
          <div class="flex justify-center md:justify-end gap-3">
            <a
              href="https://www.instagram.com/sofija.nutrition"
              target="_blank"
              rel="noopener"
              class="footer-social-link"
              aria-label="Instagram"
            >
              <i class="ph ph-instagram-logo"></i>
            </a>
            <a
              href="https://www.facebook.com/sofijaivanova.nutrition"
              target="_blank"
              rel="noopener"
              class="footer-social-link"
              aria-label="Facebook"
            >
              <i class="ph ph-facebook-logo"></i>
            </a>
            <a
              href="https://www.linkedin.com/in/sofijaivanova"
              target="_blank"
              rel="noopener"
              class="footer-social-link"
              aria-label="LinkedIn"
            >
              <i class="ph ph-linkedin-logo"></i>
            </a>
          </div>
        </div>
      </div>

      <div
        class="border-t border-line pt-6 flex flex-col md:flex-row justify-between items-center gap-3"
      >
        <p class="text-slate text-sm">© 2026 Sofija Ivanova</p>
        <div class="flex items-center gap-4">
          <a
            href="/terms"
            class="text-slate text-sm hover:text-graphite transition-colors"
            data-i18n="footer_terms">Pakalpojumu noteikumi</a
          >
          <a
            href="/privacy-policy"
            class="text-slate text-sm hover:text-graphite transition-colors"
            data-i18n="footer_privacy">Privātuma politika</a
          >
        </div>
      </div>
    </div>
  </footer>
</main>

<!-- Cookie Settings Button (fixed bottom-right) - Minimal Premium Design -->
<button
  onclick="window.showCookieSettings()"
  class="cookie-settings-btn"
  aria-label="Sīkdatņu iestatījumi"
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <circle cx="8" cy="9" r="1.5" fill="currentColor"></circle>
    <circle cx="15" cy="8" r="1" fill="currentColor"></circle>
    <circle cx="10" cy="14" r="1" fill="currentColor"></circle>
    <circle cx="16" cy="13" r="1.5" fill="currentColor"></circle>
    <circle cx="12" cy="17" r="1" fill="currentColor"></circle>
  </svg>
  <span>Sīkdatnes</span>
</button>

<!-- GDPR Cookie Consent (TypeScript) -->
<script>
  import '../components/CookieConsent';
</script>

<script>
  import '../scripts/booking/booking-calendar.js';
</script>

<!-- Hero glucose-band chart (SN-015.1): synthetic/illustrative data only -->
<script>
  import { initGlucoseChart, heroChartConfig } from '../scripts/glucose-chart';
  initGlucoseChart('hero', heroChartConfig);
</script>
</Layout>