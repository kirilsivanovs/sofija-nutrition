                    </div>
                    <h4 class="font-sans font-bold text-primary text-xl md:text-2xl mb-4 min-h-[3.5rem] flex items-center justify-center" data-i18n="step_4_title">4. Saņemat personalizētu plānu</h4>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed" data-i18n="step_4_desc">Konkrētas rekomendācijas: ko mainīt, ko atstāt, ko pievienot.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Program Section -->
    <section id="program" class="py-16 md:py-24 bg-linear-to-br from-cream to-bg-light">
        
        <div class="max-w-6xl mx-auto px-4 md:px-8">
            <!-- Hero image for program -->
            <div class="relative rounded-2xl overflow-hidden shadow-xl mb-12">
                <img 
                    src="/assets/img/healthy-food-cgm.png" 
