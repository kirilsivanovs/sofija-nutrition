---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
}

const SITE_URL = 'https://sofijaivanova.lv';

const {
  title,
  description = 'Sertificēta dietoloģe Rīgā — personalizētas uztura konsultācijas, diabēta profilakse, metabolā veselība. Doktorante LU, reģistrēta ārstniecības persona Nr. 75650061277.',
  canonicalPath = '/',
  ogTitle = title,
  ogDescription = description,
} = Astro.props;

const canonicalUrl = `${SITE_URL}${canonicalPath}`;
---

<!doctype html>
<html lang="lv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-192.svg" />

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="uztura speciāliste Rīga, диетолог Рига, nutritionist Riga, dietologs Latvija, uztura konsultācija, personalizēts uzturs, diabēta profilakse, insulīna rezistence, prediabēts, metabolā veselība, svara kontrole, zarnu veselība, uztura plāns, konsultācija tiešsaistē, uzturzinātne, nutricioniste, специалист по питанию Латвия, консультация диетолога"
    />
    <meta name="author" content="Sofija Ivanova" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang — single-URL multilingual page (LV primary, content in RU/EN via JS i18n) -->
    <link rel="alternate" hreflang="lv" href={canonicalUrl} />
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={`${SITE_URL}/assets/img/hero-doctor-cutout.png`} />
    <meta property="og:image:width" content="2200" />
    <meta property="og:image:height" content="1691" />
    <meta property="og:image:alt" content="Sofija Ivanova — uztura speciāliste Rīgā" />
    <meta property="og:locale" content="lv_LV" />
    <meta property="og:locale:alternate" content="ru_LV" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Sofija Ivanova — Uztura Speciāliste" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${SITE_URL}/assets/img/hero-doctor-cutout.png`} />

    <!-- Geo targeting — Latvia / Riga -->
    <meta name="geo.region" content="LV-RIX" />
    <meta name="geo.placename" content="Rīga" />
    <meta name="geo.position" content="56.9496;24.1052" />
    <meta name="ICBM" content="56.9496, 24.1052" />

    <!-- Structured Data — MedicalBusiness + Person (combined graph) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "MedicalBusiness",
            "@id": "https://sofijaivanova.lv/#business",
            "name": "Sofija Ivanova — Uztura Speciāliste",
            "alternateName": [
              "Sofija Ivanova — Диетолог, Рига",
              "Sofija Ivanova — Nutritionist, Riga"
            ],
            "description": "Sertificēta dietoloģe Rīgā. Personalizētas uztura konsultācijas, diabēta profilakse, metabolā veselība. Doktorante Latvijas Universitātē, pētniece.",
            "url": "https://sofijaivanova.lv",
            "image": "https://sofijaivanova.lv/assets/img/hero-doctor-cutout.png",
            "logo": "https://sofijaivanova.lv/assets/img/logo.svg",
            "telephone": "+37120000000",
            "email": "info@sofijaivanova.lv",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Rīga",
              "addressRegion": "Rīga",
              "addressCountry": "LV"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 56.9496,
              "longitude": 24.1052
            },
            "areaServed": [
              { "@type": "City", "name": "Rīga" },
              { "@type": "Country", "name": "Latvija" }
            ],
            "medicalSpecialty": "Dietetics",
            "priceRange": "€€",
            "currenciesAccepted": "EUR",
            "paymentAccepted": "Cash, Bank Transfer",
            "openingHoursSpecification": {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
              "opens": "09:00",
              "closes": "18:00"
            },
            "sameAs": [
              "https://www.instagram.com/sofija.nutrition",
              "https://www.facebook.com/sofijaivanova.nutrition",
              "https://www.linkedin.com/in/sofijaivanova"
            ],
            "hasOfferCatalog": {
              "@type": "OfferCatalog",
              "name": "Uztura konsultāciju pakalpojumi",
              "itemListElement": [
                {
                  "@type": "Offer",
                  "itemOffered": {
                    "@type": "MedicalTherapy",
                    "name": "Individuāla uztura konsultācija",
                    "alternateName": "Индивидуальная консультация диетолога",
                    "description": "60 min personalizēta uztura konsultācija klātienē vai tiešsaistē"
                  },
                  "price": "65",
                  "priceCurrency": "EUR",
                  "priceSpecification": {
                    "@type": "PriceSpecification",
                    "price": "65",
                    "priceCurrency": "EUR",
                    "unitText": "60 min"
                  },
                  "availability": "https://schema.org/InStock"
                }
              ]
            }
          },
          {
            "@type": "Person",
            "@id": "https://sofijaivanova.lv/#person",
            "name": "Sofija Ivanova",
            "jobTitle": "Sertificēta dietoloģe, doktorante",
            "description": "Sertificēta dietoloģe (MSc Uzturzinātnē, RSU), doktorante Latvijas Universitātē. Pētniecība — uztura loma diabēta ārstēšanā un profilaksē, personalizēts uzturs.",
            "url": "https://sofijaivanova.lv",
            "image": "https://sofijaivanova.lv/assets/img/hero-doctor-cutout.png",
            "alumniOf": [
              {
                "@type": "EducationalOrganization",
                "name": "Rīgas Stradiņa universitāte",
                "alternateName": "RSU"
              },
              {
                "@type": "EducationalOrganization",
                "name": "Latvijas Universitāte",
                "alternateName": "LU"
              }
            ],
            "hasCredential": [
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "degree",
                "name": "MSc Uzturzinātnē"
              }
            ],
            "knowsAbout": [
              "Dietetics",
              "Diabetes Prevention",
              "Metabolic Health",
              "Gut Health",
              "Nutritional Science"
            ],
            "sameAs": [
              "https://www.instagram.com/sofija.nutrition",
              "https://www.facebook.com/sofijaivanova.nutrition",
              "https://www.linkedin.com/in/sofijaivanova"
            ],
            "worksFor": { "@id": "https://sofijaivanova.lv/#business" }
          },
          {
            "@type": "WebSite",
            "@id": "https://sofijaivanova.lv/#website",
            "url": "https://sofijaivanova.lv",
            "name": "Sofija Ivanova — Uztura Speciāliste Rīgā",
            "description": "Personalizētas uztura konsultācijas Rīgā un tiešsaistē. Diabēta profilakse, metabolā veselība, zarnu veselība.",
            "publisher": { "@id": "https://sofijaivanova.lv/#person" },
            "inLanguage": ["lv", "ru", "en"]
          },
          {
            "@type": "WebPage",
            "@id": "https://sofijaivanova.lv/#webpage",
            "url": "https://sofijaivanova.lv",
            "name": "Sofija Ivanova | Uztura Speciāliste Rīgā | Personalizētas Uztura Konsultācijas",
            "isPartOf": { "@id": "https://sofijaivanova.lv/#website" },
            "about": { "@id": "https://sofijaivanova.lv/#person" },
            "description": "Sertificēta uztura speciāliste Rīgā. Individuālas uztura konsultācijas, diabēta profilakse, metabolā veselība.",
            "inLanguage": ["lv", "ru", "en"],
            "breadcrumb": {
              "@type": "BreadcrumbList",
              "itemListElement": [
                {
                  "@type": "ListItem",
                  "position": 1,
                  "name": "Sākums",
                  "item": "https://sofijaivanova.lv/"
                }
              ]
            }
          }
        ]
      }
    </script>

    <!-- Structured Data — FAQPage (Google rich results) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kam ir domātas uztura konsultācijas?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Visiem, kas vēlas sakārtot uzturu zinātniski pamatotā veidā — neatkarīgi no vecuma vai mērķa. Strādāju ar svara kontroli, enerģijas problēmām, metabolo veselību, prediabētu, zarnu veselību un uztura optimizāciju."
            }
          },
          {
            "@type": "Question",
            "name": "Kāda ir atšķirība no parasta dietologa?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pieeja balstās pētniecībā un individuālos datos. Neizrakstu vispārīgas diētas — katrs ieteikums ir pielāgots tieši Jūsu situācijai. Katram klientam individuāla analīze un personalizēts uztura plāns."
            }
          },
          {
            "@type": "Question",
            "name": "Vai uztura konsultācijas ir pieejamas tiešsaistē?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Jā, strādāju gan klātienē Rīgā, gan tiešsaistē. Video konsultācijas ir tikpat efektīvas un pieejamas klientiem visā Latvijā un ārpus tās."
            }
          },
          {
            "@type": "Question",
            "name": "Cik ātri var sagaidīt rezultātus no uztura konsultācijām?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pirmās pozitīvās izmaiņas (enerģija, miegs, pašsajūta) parasti jūtamas jau 2–3 nedēļu laikā. Ilgtspējīgi svara un veselības rezultāti — 2–4 mēnešos."
            }
          }
        ]
      }
    </script>

    <!-- SPA-like page transitions -->
    <ClientRouter />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
      /></noscript
    >

    <!-- Preload LCP hero image -->
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/img/hero-doctor-cutout-1024w.webp"
      media="(min-width: 769px)"
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/img/hero-doctor-cutout-480w.webp"
      media="(max-width: 768px)"
    />

    <!-- Phosphor Icons (non-blocking) -->
    <link rel="preconnect" href="https://unpkg.com" />
    <script defer src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Booking Calendar Styles -->
    <link rel="stylesheet" href="/assets/booking.css" />

    <!-- Animations Styles (non-critical, load async) -->
    <link
      rel="preload"
      as="style"
      href="/assets/animations.css"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="/assets/animations.css" /></noscript>
  </head>
  <body class="font-sans text-gray-800 bg-bg-light antialiased">
    <noscript>
      <div
        style="background:#1b4332;color:#fff;padding:1rem;text-align:center;font-family:sans-serif;"
      >
        <p><strong>Sofija Ivanova</strong> — Uztura speciāliste</p>
        <p>
          Tālrunis: <a href="tel:+37120223399" style="color:#c4a06e">+371 2022 3399</a> | E-pasts: <a
            href="mailto:info@sofijaivanova.lv"
            style="color:#c4a06e">info@sofijaivanova.lv</a>
        </p>
      </div>
    </noscript>

    <slot />

    <!-- Shared translations (loaded before booking.js) -->
    <script is:inline src="/assets/shared-translations.js"></script>
    <script defer is:inline src="/assets/booking.js"></script>
    <script defer is:inline src="/assets/main.js"></script>
    <script defer is:inline src="/assets/animations.js"></script>
  </body>
</html>
