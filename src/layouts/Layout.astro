---
import '../styles/global.css';
import '@phosphor-icons/web/regular';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { t, type Locale } from '../i18n/landing';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  lang?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const SITE_URL = 'https://sofijaivanova.lv';
const OG_LOCALES: Record<Locale, string> = { lv: 'lv_LV', ru: 'ru_LV', en: 'en_US' };

const {
  title,
  description = 'Sertificēta dietoloģe Rīgā — personalizētas uztura konsultācijas, diabēta profilakse, metabolā veselība. Doktorante LU, reģistrēta ārstniecības persona Nr. 75650061277.',
  canonicalPath = '/',
  ogTitle = title,
  ogDescription = description,
  lang = 'lv',
  alternates,
} = Astro.props;

const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const dict = t(lang);
const otherLocales = (Object.keys(OG_LOCALES) as Locale[]).filter((l) => l !== lang);

const businessPersonGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalBusiness',
      '@id': 'https://sofijaivanova.lv/#business',
      name: 'Sofija Ivanova — Uztura Speciāliste',
      alternateName: ['Sofija Ivanova — Диетолог, Рига', 'Sofija Ivanova — Nutritionist, Riga'],
      description: dict.jsonld_business_description,
      url: 'https://sofijaivanova.lv',
      image: 'https://sofijaivanova.lv/assets/img/sofija-crop-512.jpg',
      email: 'info@sofijaivanova.lv',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rīga',
        addressRegion: 'Rīga',
        addressCountry: 'LV',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 56.9496,
        longitude: 24.1052,
      },
      areaServed: [
        { '@type': 'City', name: 'Rīga' },
        { '@type': 'Country', name: 'Latvija' },
      ],
      medicalSpecialty: 'Dietetics',
      priceRange: '€€',
      currenciesAccepted: 'EUR',
      paymentAccepted: 'Cash, Bank Transfer',
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
      sameAs: [
        'https://www.instagram.com/sofija.nutrition',
        'https://www.facebook.com/sofijaivanova.nutrition',
        'https://www.linkedin.com/in/sofijaivanova',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Uztura konsultāciju pakalpojumi',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'MedicalTherapy',
              name: 'Individuāla uztura konsultācija',
              alternateName: 'Индивидуальная консультация диетолога',
              description: dict.jsonld_offer_description,
            },
            price: '65',
            priceCurrency: 'EUR',
            priceSpecification: {
              '@type': 'PriceSpecification',
              price: '65',
              priceCurrency: 'EUR',
              unitText: '60 min',
            },
            availability: 'https://schema.org/InStock',
          },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://sofijaivanova.lv/#person',
      name: 'Sofija Ivanova',
      jobTitle: dict.jsonld_person_jobtitle,
      description: dict.jsonld_person_description,
      url: 'https://sofijaivanova.lv',
      image: 'https://sofijaivanova.lv/assets/img/sofija-crop-512.jpg',
      alumniOf: [
        {
          '@type': 'EducationalOrganization',
          name: 'Rīgas Stradiņa universitāte',
          alternateName: 'RSU',
        },
        {
          '@type': 'EducationalOrganization',
          name: 'Latvijas Universitāte',
          alternateName: 'LU',
        },
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'degree',
          name: 'MSc Uzturzinātnē',
        },
      ],
      knowsAbout: ['Dietetics', 'Diabetes Prevention', 'Metabolic Health', 'Gut Health', 'Nutritional Science'],
      sameAs: [
        'https://www.instagram.com/sofija.nutrition',
        'https://www.facebook.com/sofijaivanova.nutrition',
        'https://www.linkedin.com/in/sofijaivanova',
      ],
      worksFor: { '@id': 'https://sofijaivanova.lv/#business' },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sofijaivanova.lv/#website',
      url: 'https://sofijaivanova.lv',
      name: 'Sofija Ivanova — Uztura Speciāliste Rīgā',
      description: dict.jsonld_website_description,
      publisher: { '@id': 'https://sofijaivanova.lv/#person' },
      inLanguage: ['lv', 'ru', 'en'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://sofijaivanova.lv/#webpage',
      url: 'https://sofijaivanova.lv',
      name: 'Sofija Ivanova | Uztura Speciāliste Rīgā | Personalizētas Uztura Konsultācijas',
      isPartOf: { '@id': 'https://sofijaivanova.lv/#website' },
      about: { '@id': 'https://sofijaivanova.lv/#person' },
      description: dict.jsonld_webpage_description,
      inLanguage: ['lv', 'ru', 'en'],
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: dict.jsonld_breadcrumb_home,
            item: 'https://sofijaivanova.lv/',
          },
        ],
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="uztura speciāliste Rīga, диетолог Рига, nutritionist Riga, dietologs Latvija, uztura konsultācija, personalizēts uzturs, diabēta profilakse, insulīna rezistence, prediabēts, metabolā veselība, svara kontrole, zarnu veselība, uztura plāns, konsultācija tiešsaistē, uzturzinātne, nutricioniste, специалист по питанию Латвия, консультация диетолога"
    />
    <meta name="author" content="Sofija Ivanova" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hreflang — per-locale routes; emitted only when alternates are provided (landing) -->
    {
      alternates &&
        Object.entries(alternates).map(([localeCode, href]) => (
          <link rel="alternate" hreflang={localeCode} href={`${SITE_URL}${href}`} />
        ))
    }
    {alternates?.lv && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${alternates.lv}`} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={`${SITE_URL}/assets/img/sofija-crop-512.jpg`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Sofija Ivanova — uztura speciāliste Rīgā" />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {
      alternates &&
        otherLocales.map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)
    }
    <meta property="og:site_name" content="Sofija Ivanova — Uztura Speciāliste" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={`${SITE_URL}/assets/img/sofija-crop-512.jpg`} />

    <!-- Geo targeting — Latvia / Riga -->
    <meta name="geo.region" content="LV-RIX" />
    <meta name="geo.placename" content="Rīga" />
    <meta name="geo.position" content="56.9496;24.1052" />
    <meta name="ICBM" content="56.9496, 24.1052" />

    <!-- Structured Data — MedicalBusiness + Person (combined graph) -->
    <script type="application/ld+json" set:html={JSON.stringify(businessPersonGraph)} />

    <!-- Structured Data — FAQPage (Google rich results) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Kam ir domātas uztura konsultācijas?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Visiem, kas vēlas sakārtot uzturu zinātniski pamatotā veidā — neatkarīgi no vecuma vai mērķa. Strādāju ar svara kontroli, enerģijas problēmām, metabolo veselību, prediabētu, zarnu veselību un uztura optimizāciju."
            }
          },
          {
            "@type": "Question",
            "name": "Kāda ir atšķirība no parasta dietologa?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pieeja balstās pētniecībā un individuālos datos. Neizrakstu vispārīgas diētas — katrs ieteikums ir pielāgots tieši Jūsu situācijai. Katram klientam individuāla analīze un personalizēts uztura plāns."
            }
          },
          {
            "@type": "Question",
            "name": "Vai uztura konsultācijas ir pieejamas tiešsaistē?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Jā, strādāju gan klātienē Rīgā, gan tiešsaistē. Video konsultācijas ir tikpat efektīvas un pieejamas klientiem visā Latvijā un ārpus tās."
            }
          },
          {
            "@type": "Question",
            "name": "Cik ātri var sagaidīt rezultātus no uztura konsultācijām?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Pirmās pozitīvās izmaiņas (enerģija, miegs, pašsajūta) parasti jūtamas jau 2–3 nedēļu laikā. Ilgtspējīgi svara un veselības rezultāti — 2–4 mēnešos."
            }
          }
        ]
      }
    </script>

    <!-- SPA-like page transitions -->
    <ClientRouter />

    <!-- Fonts -->
    <Font cssVariable="--font-sans" preload />

    <!-- Preload LCP hero image -->
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/img/hero-doctor-cutout-1024w.webp"
      media="(min-width: 769px)"
    />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/img/hero-doctor-cutout-480w.webp"
      media="(max-width: 768px)"
    />

  </head>
  <body class="font-sans text-gray-800 bg-white antialiased">
    <slot />

    <!-- Shared translations -->
    <script is:inline src="/assets/shared-translations.js"></script>
  </body>
</html>
