---
import Layout from '../../layouts/Layout.astro';
import AppHeader from '../common/AppHeader.astro';
import ScrollToTop from '../common/ScrollToTop.astro';
import { t, type Locale } from '../../i18n/landing';
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../../styles/booking.css';
import '../../styles/chart.css';
import '../../styles/question-body.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const alternates = {
  lv: getRelativeLocaleUrl('lv', '/'),
  ru: getRelativeLocaleUrl('ru', '/'),
  en: getRelativeLocaleUrl('en', '/'),
};
---

<Layout
  title={dict.meta_title}
  description={dict.meta_description}
  canonicalPath={Astro.url.pathname}
  lang={locale}
  alternates={alternates}
>
  <!-- Skip to Content (Accessibility) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-9999 focus:bg-navy focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:outline-none"
  >
    Pāriet uz saturu
  </a>

  <AppHeader variant="public" showAuth={false} subtitle={dict.header_specialty} locale={locale} />

  <!-- Scroll to Top Button -->
  <ScrollToTop locale={locale} />
  <!-- Hero Section -->
  <main id="main-content">
    <section id="hero" class="landing-hero" aria-labelledby="hero-title">
      <div class="landing-hero__inner">
        <div>
          <h1 id="hero-title" class="landing-hero__title">
            {dict.hero_title_lead} <strong>{dict.hero_title_key}</strong>
          </h1>
          <p class="landing-hero__lead">
            {dict.hero_lead}
          </p>
          <a class="btn-cta btn-solid" href="#f-q6"
            ><span>{dict.hero_cta}</span><i class="ph ph-arrow-right" aria-hidden="true"></i
          ></a>
          <ul class="landing-hero__facts">
            <li>{dict.hero_fact}</li>
          </ul>
        </div>

        <aside class="hero-cred" aria-labelledby="hero-cred-title">
          <h2 id="hero-cred-title">{dict.cred_heading}</h2>
          <dl>
            <dt>{dict.cred_degree_t}</dt>
            <dd>{dict.cred_degree_d}</dd>
            <dt>{dict.cred_phd_t}</dt>
            <dd>{dict.cred_phd_d}</dd>
            <dt>{dict.cred_project_t}</dt>
            <dd>{dict.cred_project_d}</dd>
            <dt>{dict.cred_register_t}</dt>
            <dd>{dict.cred_register_d}</dd>
          </dl>
        </aside>
      </div>
    </section>

    <!-- Six-question body (SN-015.2) — sticky index + questions, replaces the old
         trust-metrics/for-whom/services/outcomes/about-badges/FAQ sections. #services
         and #faq are kept as anchor ids on the wrapper (interim mapping for the frozen
         header's nav, not a redesign of its copy). -->
    <div class="F-body" id="faq">
      <nav class="question-index" id="services" aria-label={dict.qindex_nav_label}>
        <h2>{dict.qindex_title}</h2>
        <ol id="question-index-list">
          <li><a href="#f-q1">{dict.qindex_1}</a></li>
          <li><a href="#f-q2">{dict.qindex_2}</a></li>
          <li><a href="#f-q3">{dict.qindex_3}</a></li>
          <li><a href="#about">{dict.qindex_4}</a></li>
          <li><a href="#f-q5">{dict.qindex_5}</a></li>
          <li><a href="#f-q6">{dict.qindex_6}</a></li>
        </ol>
        <a class="btn-cta btn-solid" href="#f-q6">{dict.qindex_cta}</a>
      </nav>

      <div class="question-list">
        <!-- Q1: fit -->
        <section class="question" id="f-q1">
          <h2>{dict.q1_title}</h2>
          <p>
            {dict.q1_intro}
          </p>
          <dl class="question__rows">
            <dt>{dict.q1_row1_t}</dt>
            <dd>
              {dict.q1_row1_d}
            </dd>
            <dt>{dict.q1_row2_t}</dt>
            <dd>
              {dict.q1_row2_d}
            </dd>
            <dt>{dict.q1_row3_t}</dt>
            <dd>{dict.q1_row3_d}</dd>
            <dt>{dict.q1_row4_t}</dt>
            <dd>{dict.q1_row4_d}</dd>
          </dl>
          <p class="question__scope">
            {dict.q1_scope}
          </p>
          <!-- proposal for Sofija: where her competence ends and she refers on -->
          <p class="question__scope">{dict.q1_refer}</p>
        </section>

        <!-- Q2: first consultation — no photo, dropped 2026-09-26 -->
        <section class="question" id="f-q2">
          <h2>{dict.q2_title}</h2>
          <ol class="question__steps">
            <li>
              {dict.q2_step1}
            </li>
            <li>
              {dict.q2_step2}
            </li>
            <li>
              {dict.q2_step3}
            </li>
            <li>
              {dict.q2_step4}
            </li>
            <!-- proposal for Sofija: the cabinet food diary between visits -->
            <li>{dict.q2_step5}</li>
          </ol>
        </section>

        <!-- Q3: price — the site's only place price appears -->
        <section class="question" id="f-q3">
          <h2>{dict.q3_title}</h2>
          <table class="question__price">
            <tr>
              <th>
                <span>{dict.q3_row1_t}</span>
                <small>{dict.q3_row1_d}</small>
              </th>
              <td>{dict.q3_row1_v}</td>
            </tr>
            <!-- follow-up and package rows return once Sofija sets their prices; don't invent numbers -->
          </table>
        </section>

        <!-- Q4: Sofija's research, with the glucose chart as its example; credentials and the register number sit in the hero only -->
        <section class="question question--research" id="about">
          <h2>{dict.q4_title}</h2>
          <div class="question__research">
            <figure>
              <div class="question__photo-crop">
                <picture>
                  <source type="image/webp" srcset="/assets/img/conference_EASD2025_Vienna-600w.webp" />
                  <img
                    src="/assets/img/conference_EASD2025_Vienna.jpg"
                    alt={dict.about_photo_alt}
                    decoding="async"
                    width="1400"
                    height="1054"
                  />
                </picture>
              </div>
            </figure>
            <div>
              <p>
                {dict.about_lead}
              </p>
              <p>
                {dict.about_text}
              </p>
              <ul class="question__talks">
                <li><span>{dict.q4_talk1_label}</span>{dict.q4_talk1_text}</li>
                <li>
                  <span>{dict.q4_talk2_label}</span>{dict.q4_talk2_text}
                </li>
                <li><span>{dict.q4_talk3_label}</span>{dict.q4_talk3_text}</li>
              </ul>
            </div>
          </div>
          <p>{dict.chart_intro}</p>
          <figure class="glucose-fig">
            <div class="glucose-fig__head">
              <h3>{dict.hero_chart_heading}</h3>
              <ul class="glucose-fig__legend">
                <li>
                  <i class="glucose-fig__mark glucose-fig__mark--a" aria-hidden="true"></i>
                  <span>{dict.hero_legend_a}</span>
                </li>
                <li>
                  <i class="glucose-fig__mark glucose-fig__mark--b" aria-hidden="true"></i>
                  <span>{dict.hero_legend_b}</span>
                </li>
              </ul>
            </div>
            <svg
              id="hero-svg"
              class="glucose-fig__svg"
              viewBox="0 0 640 352"
              role="img"
              tabindex="0"
              aria-label={dict.hero_chart_aria_label}
            ></svg>
            <dl class="glucose-fig__readout" aria-live="polite">
              <div>
                <dt>{dict.hero_readout_time}</dt>
                <dd id="hero-t">08:30</dd>
              </div>
              <div>
                <dt>{dict.hero_readout_a}</dt>
                <dd id="hero-va">7,1 {dict.glucose_unit}</dd>
              </div>
              <div>
                <dt>{dict.hero_readout_b}</dt>
                <dd id="hero-vb">10,1 {dict.glucose_unit}</dd>
              </div>
            </dl>
            <figcaption class="glucose-fig__caption">
              <span>{dict.hero_chart_caption}</span>
              <!-- copy pending from Sofija: 7.8 caption wording -->
              <span id="hero-tir"></span>
            </figcaption>
          </figure>
        </section>

        <!-- Q5: the plate model as the evidence baseline, then how it is individualised -->
        <section class="question" id="f-q5">
          <h2>{dict.q5_title}</h2>
          <p>
            {dict.q5_p1}
          </p>
          <p>{dict.plate_intro}</p>
          <figure class="plate">
            <svg class="plate__svg" viewBox="0 0 220 220" role="img" aria-label={dict.plate_aria}>
              <circle class="plate__rim" cx="110" cy="110" r="106"></circle>
              <path class="plate__veg" d="M110 18 A92 92 0 0 1 110 202 Z"></path>
              <path class="plate__grain" d="M110 110 L110 18 A92 92 0 0 0 18 110 Z"></path>
              <path class="plate__protein" d="M110 110 L18 110 A92 92 0 0 0 110 202 Z"></path>
              <text x="156" y="118">½</text>
              <text x="70" y="80">¼</text>
              <text x="70" y="156">¼</text>
            </svg>
            <div>
              <h3>{dict.plate_heading}</h3>
              <dl class="plate__parts">
                <dt><i class="plate__swatch plate__swatch--veg" aria-hidden="true"></i>½ · {dict.plate_veg_t}</dt>
                <dd>{dict.plate_veg_d}</dd>
                <dt><i class="plate__swatch plate__swatch--grain" aria-hidden="true"></i>¼ · {dict.plate_grain_t}</dt>
                <dd>{dict.plate_grain_d}</dd>
                <dt><i class="plate__swatch plate__swatch--protein" aria-hidden="true"></i>¼ · {dict.plate_protein_t}</dt>
                <dd>{dict.plate_protein_d}</dd>
              </dl>
              <p class="plate__extra">{dict.plate_extra}</p>
              <figcaption>{dict.plate_source}</figcaption>
            </div>
          </figure>
          <!-- proposal for Sofija: how the model becomes her plan -->
          <p>{dict.plate_adapt}</p>
        </section>

        <!-- Q6: how to book — format toggle + week grid + summary panel
             (booking-calendar.js render()), no separate booking section. -->
        <section class="question" id="f-q6">
          <h2>{dict.q6_title}</h2>
          <div id="contact">
            <div id="bookingCalendar" class="booking-calendar-wrapper">
              <noscript>
                <p class="booking-noscript">
                  {dict.booking_noscript}
                </p>
              </noscript>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Question index scrollspy (active link border) + smooth-scroll on click -->
    <script>
      import { initQuestionIndex } from '../../scripts/question-index';
      initQuestionIndex();
    </script>

    <!-- Footer — minimal, single row: name+specialty, email, cabinet link,
         legal links, social as plain text links (no tinted circles). -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <span class="site-footer__name">Sofija Ivanova</span>
          <span class="site-footer__specialty">
            {dict.footer_subtitle}
          </span>
        </div>

        <nav class="site-footer__links">
          <a href="mailto:info@sofijaivanova.lv">info@sofijaivanova.lv</a>
          <a href="/.auth/login/aad?post_login_redirect_uri=/cabinet">{dict.nav_cabinet}</a>
          <a href="/terms">{dict.footer_terms}</a>
          <a href="/privacy-policy">{dict.footer_privacy}</a>
        </nav>

        <div class="site-footer__social">
          <a href="https://www.instagram.com/sofija.nutrition" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/sofijaivanova.nutrition" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.linkedin.com/in/sofijaivanova" target="_blank" rel="noopener">LinkedIn</a>
        </div>

        <p class="site-footer__copy">© 2026 Sofija Ivanova</p>
      </div>
    </footer>
  </main>

  <script>
    import '../../scripts/booking/booking-calendar.js';
  </script>

  <script define:vars={{ locale }}>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof BookingCalendar !== 'undefined' && document.getElementById('bookingCalendar')) {
        new BookingCalendar('bookingCalendar', { lang: locale, onBookingComplete: () => {} });
      }
    });
  </script>

  <!-- Glucose-band chart in Q4: synthetic/illustrative data only -->
  <script>
    import { initGlucoseChart, heroChartConfig } from '../../scripts/glucose-chart';
    initGlucoseChart('hero', heroChartConfig);
  </script>
</Layout>
