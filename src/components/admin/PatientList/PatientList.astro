---
/**
 * PatientList component - displays filterable list of patients
 * Pure HTML template - logic in PatientListController.ts
 */
import './PatientList.css';
---

<div class="patients-search">
    <input 
        type="text" 
        id="patients-search-input" 
        placeholder="Meklēt pēc ID, vārda, e-pasta..."
    />
    <i class="ph ph-magnifying-glass search-icon"></i>
</div>

<div class="patients-add">
    <input 
        type="text" 
        id="patients-add-input" 
        placeholder="Pacien ID (email)"
    />
    <button id="patients-add-btn">Pievienot</button>
</div>

<div id="patients-list" class="patients-list"></div>

<div id="patients-empty" class="patients-empty hidden">
    <i class="ph ph-users" style="font-size: 48px; opacity: 0.3;"></i>
    <p>Nav neviena pacienta</p>
</div>
