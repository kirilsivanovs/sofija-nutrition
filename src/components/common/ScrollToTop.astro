---
/**
 * Scroll to Top Button
 * Shows when user scrolls down, hides at the top
 * Universal component for all pages
 */
---

<button
  id="scroll-to-top"
  class="scroll-to-top"
  aria-label="Atgriezties uz augšu"
  title="Atgriezties uz augšu"
>
  <i class="ph ph-arrow-up"></i>
</button>

<style>
  .scroll-to-top {
    position: fixed;
    bottom: 16px;
    left: 16px;
    width: 48px !important;
    height: 48px !important;
    min-width: 48px;
    min-height: 48px;
    padding: 0 !important;
    border-radius: 50% !important;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 6px 18px rgba(27, 67, 50, 0.28),
      0 0 0 3px rgba(255, 255, 255, 0.7);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: all 0.3s ease;
    z-index: 999;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    overflow: hidden;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .scroll-to-top:hover {
    transform: scale(1.1);
    box-shadow:
      0 10px 24px rgba(27, 67, 50, 0.35),
      0 0 0 4px rgba(255, 255, 255, 0.85);
  }

  .scroll-to-top:active {
    transform: scale(0.95);
  }

  .scroll-to-top i {
    font-size: 22px;
    font-weight: bold;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .scroll-to-top {
      width: 44px !important;
      height: 44px !important;
      min-width: 44px;
      min-height: 44px;
    }

    .scroll-to-top i {
      font-size: 20px;
    }
  }
</style>

<script is:inline>
  // Scroll to top functionality - inline for compatibility
  (function () {
    const scrollBtn = document.getElementById('scroll-to-top');
    if (!scrollBtn) return;

    const scrollRoot = document.scrollingElement || document.documentElement;
    const SCROLL_THRESHOLD = 200;
    let ticking = false;

    function getScrollTop() {
      return window.pageYOffset || scrollRoot.scrollTop || document.body.scrollTop || 0;
    }

    // Show/hide button based on scroll position
    function toggleButton() {
      if (getScrollTop() > SCROLL_THRESHOLD) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        toggleButton();
        ticking = false;
      });
    }

    // Smooth scroll to top
    function scrollToTop(e) {
      e.preventDefault();
      if (scrollRoot && typeof scrollRoot.scrollTo === 'function') {
        scrollRoot.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    // Event listeners
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('scroll', onScroll, { passive: true });
    scrollBtn.addEventListener('click', scrollToTop);

    // Check initial position
    toggleButton();
  })();
</script>
