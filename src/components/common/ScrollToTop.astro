---
/**
 * Scroll to Top Button
 * Shows when user scrolls down, hides at the top
 * Universal component for all pages
 */
import { t, type Locale } from '../../i18n/landing';

interface Props {
  locale?: Locale;
}

const { locale = 'lv' } = Astro.props;
const dict = t(locale);
---

<button id="scroll-to-top" class="scroll-to-top" aria-label={dict.scrolltop_label}>
  <i class="ph ph-arrow-up"></i>
</button>

<style>
  button.scroll-to-top {
    position: fixed;
    bottom: 16px;
    left: 16px;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-graphite);
    border: 1px solid var(--color-slate);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    z-index: 999;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    overflow: hidden;
  }

  button.scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  button.scroll-to-top:hover {
    opacity: 1;
    background: var(--color-white);
    border-color: var(--color-graphite);
  }

  button.scroll-to-top i {
    font-size: 20px;
    font-weight: 600;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    button.scroll-to-top {
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>

<script>
  const scrollRoot = document.scrollingElement || document.documentElement;
  const SCROLL_THRESHOLD = 200;
  let ticking = false;

  function getScrollTop(): number {
    return window.pageYOffset || scrollRoot.scrollTop || document.body.scrollTop || 0;
  }

  // Show/hide button based on scroll position; the button is replaced on navigation, so look it up each time
  function toggleButton() {
    const scrollBtn = document.getElementById('scroll-to-top');
    if (!scrollBtn) return;
    scrollBtn.classList.toggle('visible', getScrollTop() > SCROLL_THRESHOLD);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () {
      toggleButton();
      ticking = false;
    });
  }

  function scrollToTop(e: Event) {
    e.preventDefault();
    if (scrollRoot && typeof scrollRoot.scrollTo === 'function') {
      scrollRoot.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('astro:page-load', () => {
    const scrollBtn = document.getElementById('scroll-to-top');
    if (scrollBtn && scrollBtn.dataset.bound !== 'true') {
      scrollBtn.dataset.bound = 'true';
      scrollBtn.addEventListener('click', scrollToTop);
    }
    toggleButton();
  });
</script>