---
/**
 * Universal Application Header Component
 * Unified header design for admin, cabinet, and booking modules
 *
 * Props:
 * - variant: 'admin' | 'cabinet' | 'public'
 * - showBurger: boolean (show burger menu for mobile)
 * - showAuth: boolean (show login/logout)
 * - subtitle: string (header subtitle text)
 */

interface Props {
  variant?: 'admin' | 'cabinet' | 'public';
  showBurger?: boolean;
  showAuth?: boolean;
  subtitle?: string;
}

const { variant = 'public', showBurger = false, showAuth = true, subtitle = '' } = Astro.props;

// Generate unique IDs for mobile menu
const mobileMenuId = `mobile-nav-menu-${variant}`;
const logoutUrl = '/.auth/logout?post_logout_redirect_uri=/';
---

<header class={`app-header app-header--${variant}`}>
  <div class="app-header-inner">
    {
      showBurger && variant !== 'public' && (
        <button
          type="button"
          class="mobile-menu-btn"
          style="-webkit-tap-highlight-color:transparent;touch-action:manipulation;"
          aria-label="Atvērt izvēlni"
          aria-expanded="false"
          aria-controls={mobileMenuId}
        >
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
        </button>
      )
    }

    <a href="/" class="app-logo">
      {variant === 'public' && (
        <img
          src="/assets/img/sofija-crop-88.webp"
          width="44"
          height="44"
          alt=""
          loading="lazy"
          class="app-logo-crop"
        />
      )}
      <div class="app-logo-text">
        <span class="app-logo-name">Sofija Ivanova</span>
        {subtitle &&
          (variant === 'public' ? (
            <span class="app-logo-sub" data-i18n="header_specialty">
              {subtitle}
            </span>
          ) : (
            <span class="app-logo-sub">{subtitle}</span>
          ))}
      </div>
    </a>

    {
      variant === 'public' && (
        <nav class="app-public-nav">
          <a href="#services" data-i18n="nav_services">
            Pakalpojumi
          </a>
          <a href="#about" data-i18n="nav_about">
            Par mani
          </a>
          <a href="#faq" data-i18n="nav_faq">
            BUJ
          </a>
        </nav>
      )
    }

    {
      variant === 'public' && (
        <div class="app-public-actions">
          <div class="app-lang-switch">
            <button class="lang-btn" data-lang="lv" aria-pressed="true">
              LV
            </button>
            <button class="lang-btn" data-lang="ru" aria-pressed="false">
              RU
            </button>
            <button class="lang-btn" data-lang="en" aria-pressed="false">
              EN
            </button>
          </div>
          <a href="#contact" class="app-public-cta" data-i18n="nav_contact">
            Pieteikties
          </a>
        </div>
      )
    }

    {
      showAuth && (
        <div class="app-auth">
          {variant === 'admin' ? (
            <>
              <span id="user-info" class="app-user-name" />
              <a href={logoutUrl} class="app-logout">
                <i class="ph ph-sign-out" />
                <span>Iziet</span>
              </a>
            </>
          ) : (
            <>
              <div id="auth-actions" class="app-auth-actions">
                <a
                  class="btn-login"
                  id="login-aad"
                  href={`/.auth/login/aad?post_login_redirect_uri=${variant === 'cabinet' ? '/cabinet' : '/'}`}
                >
                  <i class="ph ph-sign-in" />
                  <span class="login-text">Pieslēgties</span>
                </a>
              </div>
              <div id="auth-user" class="app-auth-user hidden">
                <span id="user-name" class="app-user-name" />
                <a id="logout-link" href={logoutUrl} class="app-logout">
                  <i class="ph ph-sign-out" />
                </a>
              </div>
            </>
          )}
        </div>
      )
    }
  </div>
</header>

{
  showBurger && variant !== 'public' && (
    <div id={mobileMenuId} class="mobile-nav-menu">
      <slot name="mobile-menu" />
    </div>
  )
}

<style>
  /* Header Base Styles */
  .app-header {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-line);
    /* Horizontal spacing lives on .app-header-inner (matches .hero__inner);
       keep only vertical padding here. */
    padding: 14px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  @media (max-width: 760px) {
    .app-header {
      position: static;
    }

    .app-lang-switch button {
      padding: 8px 10px;
      font-size: 13px;
      min-width: 40px;
      min-height: 36px;
    }

    .app-header--public .app-logo-sub {
      display: none;
    }
  }

  .app-header-inner {
    /* Matches .hero__inner (src/styles/booking.css) so the header and hero
       content columns share one left edge at every viewport width. */
    max-width: min(1280px, 96vw);
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .app-header-inner {
      padding: 0 clamp(18px, 3vw, 42px);
    }
  }

  @media (min-width: 1440px) {
    .app-header-inner {
      max-width: min(1340px, 94vw);
      padding: 0 clamp(14px, 2vw, 30px);
    }
  }

  /* Logo Styles */
  .app-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .app-logo-crop {
    height: 44px;
    width: 44px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
  }

  @media (min-width: 761px) {
    .app-logo-crop {
      display: none;
    }
  }

  .app-logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .app-logo-name {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-graphite);
    line-height: 1.1;
  }

  .app-logo-sub {
    font-size: 14px;
    color: var(--color-slate);
    font-weight: 500;
  }

  /* Public nav / lang / CTA */
  .app-public-nav {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .app-public-nav a {
    padding: 12px 16px;
    color: var(--color-graphite);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .app-public-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .app-lang-switch {
    display: flex;
    gap: 4px;
  }

  .app-lang-switch button {
    background: transparent;
    border: none;
    padding: 8px 10px;
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-slate);
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }

  .app-lang-switch button[aria-pressed='true'] {
    color: var(--color-graphite);
    font-weight: 600;
    border-bottom-color: var(--color-navy);
  }

  .app-public-cta {
    display: none;
    background: var(--color-navy);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    height: 44px;
    padding: 10px 20px;
    align-items: center;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }

  .app-public-cta:hover {
    background: var(--color-navy-hover);
  }

  @media (min-width: 761px) {
    .app-public-nav {
      display: flex;
    }
    .app-public-cta {
      display: inline-flex;
    }
  }

  /* Auth Styles */
  .app-auth {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .app-user-name {
    font-size: 14px;
    color: var(--color-ink);
    font-weight: 500;
    display: none;
  }

  .app-logout,
  .btn-login {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text-light);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    transition: all 0.2s;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .app-logout:hover {
    background: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
  }

  .btn-login {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .btn-login:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    z-index: 999;
    position: relative;
    background: none;
    border: none;
    padding: 12px;
    min-width: 48px;
    min-height: 48px;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    touch-action: manipulation;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .mobile-menu-btn:hover span {
    background: var(--color-accent);
  }

  /* Hamburger animation to X */
  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 6px);
    background: var(--color-primary);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -6px);
    background: var(--color-primary);
  }

  /* ── Premium Fullscreen Mobile Menu ── */
  .mobile-nav-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding-top: 72px; /* header height */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0;
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 60px;
    background: var(--color-white);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.4s;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .mobile-nav-menu > * {
    position: relative;
    z-index: 1;
  }

  .mobile-nav-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Premium nav items */
  .mobile-nav-menu :global(a),
  .mobile-nav-menu :global(button) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 24px;
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-graphite);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    min-height: 56px;
    width: 100%;
    max-width: 320px;
    box-shadow: none;
    position: relative;
  }

  .mobile-nav-menu :global(a:hover),
  .mobile-nav-menu :global(button:hover) {
    color: var(--color-graphite);
    background: rgba(0, 0, 0, 0.04);
    box-shadow: none;
  }

  .mobile-nav-menu :global(.mobile-nav-item) {
    justify-content: flex-start;
  }

  .mobile-nav-menu :global(.mobile-nav-item.active) {
    color: var(--color-graphite);
    background: var(--color-mist);
    font-weight: 600;
  }

  .mobile-nav-menu :global(.mobile-nav-item.active)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 24px;
    background: var(--color-range);
    border-radius: 0 3px 3px 0;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .app-header {
      padding: 12px 0;
    }
    .app-logo-name {
      font-size: 17px;
    }
    .app-logo-sub {
      font-size: 14px;
    }
    .app-logout span,
    .login-text {
      display: none;
    }
    .app-logout,
    .btn-login {
      padding: 8px;
      font-size: 20px;
    }
  }

  @media (min-width: 600px) {
    .app-user-name {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu-btn,
    .mobile-nav-menu,
    .mobile-nav-menu.open {
      display: none;
    }
    .app-header {
      padding: 18px 0;
    }
    .app-logo-name {
      font-size: 17px;
    }
    .app-logout span,
    .login-text {
      display: inline;
    }
  }

  /* Variant-specific adjustments */
  .app-header--cabinet {
    border-bottom: 1px solid var(--color-line);
  }

  .app-header--public {
    background: var(--color-white);
  }
</style>

<script is:inline>
  // Mobile menu functionality - inline for iOS Safari compatibility
  (function () {
    function initBurgerMenu() {
      const btns = document.querySelectorAll('.mobile-menu-btn');

      btns.forEach(function (btn) {
        if (btn.dataset.burgerBound === 'true') return;
        const menuId = btn.getAttribute('aria-controls');
        const menu = document.getElementById(menuId);
        if (!menu) return;
        btn.dataset.burgerBound = 'true';

        function toggle(e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = menu.classList.toggle('open');
          btn.classList.toggle('active', isOpen);
          btn.setAttribute('aria-expanded', String(isOpen));
          document.body.style.overflow = isOpen ? 'hidden' : '';
          document.body.style.position = isOpen ? 'fixed' : '';
          document.body.style.width = isOpen ? '100%' : '';
          document.body.style.top = isOpen ? '0' : '';
        }

        function close() {
          menu.classList.remove('open');
          btn.classList.remove('active');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          document.body.style.position = '';
          document.body.style.width = '';
          document.body.style.top = '';
        }

        // Add click handler to button
        btn.addEventListener('click', toggle, false);
        btn.addEventListener(
          'touchstart',
          function (e) {
            e.preventDefault();
            toggle(e);
          },
          { passive: false }
        );

        // Close on link/button click inside menu
        const links = menu.querySelectorAll('a, button[data-tab]');
        for (let i = 0; i < links.length; i++) {
          links[i].addEventListener('click', close, false);
        }

        // Close on overlay click
        menu.addEventListener(
          'click',
          function (e) {
            if (e.target === menu) close();
          },
          false
        );

        // Escape closes the menu and refocuses the button; Tab traps focus inside it
        document.addEventListener('keydown', function (e) {
          if (!menu.classList.contains('open')) return;

          if (e.key === 'Escape') {
            close();
            btn.focus();
            return;
          }

          if (e.key !== 'Tab') return;

          const focusable = menu.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });
      });
    }

    // Initialize immediately if DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBurgerMenu);
    } else {
      initBurgerMenu();
    }
  })();

  // Logout: Azure SWA handles session cleanup server-side via /.auth/logout
  // No need to manually clear cookies/storage — auth cookies are httpOnly.
  // The <a href="/.auth/logout?post_logout_redirect_uri=..."> link works as-is.
</script>

<script>
  // Initialize auth state for cabinet variant
  if (document.querySelector('.app-header--cabinet')) {
    const authActions = document.getElementById('auth-actions');
    const authUser = document.getElementById('auth-user');
    const userName = document.getElementById('user-name');

    // Check authentication (this will be called by cabinet.astro's auth logic)
    (window as any).updateHeaderAuth = (user: any) => {
      if (user && authActions && authUser && userName) {
        authActions.classList.add('hidden');
        authUser.classList.remove('hidden');
        userName.textContent = user.userDetails || user.userId || '';
      }
    };
  }
</script>
