---
/**
 * Universal Application Header Component
 * Unified header design for admin, cabinet, and booking modules
 *
 * Props:
 * - variant: 'admin' | 'cabinet' | 'public'
 * - showBurger: boolean (show burger menu for mobile)
 * - showAuth: boolean (show login/logout)
 * - subtitle: string (header subtitle text)
 */

interface Props {
  variant?: 'admin' | 'cabinet' | 'public';
  showBurger?: boolean;
  showAuth?: boolean;
  subtitle?: string;
}

const { variant = 'public', showBurger = false, showAuth = true, subtitle = '' } = Astro.props;

// Generate unique IDs for mobile menu
const mobileMenuId = `mobile-nav-menu-${variant}`;
const logoutReturnPath = variant === 'admin' ? '/admin' : variant === 'cabinet' ? '/cabinet' : '/';
const loginAfterLogout = `/.auth/login/aad?post_login_redirect_uri=${logoutReturnPath}`;
const logoutUrl = `/.auth/logout?post_logout_redirect_uri=${encodeURIComponent(loginAfterLogout)}`;
---

<header class={`app-header app-header--${variant}`}>
  <div class="app-header-inner">
    {
      showBurger && (
        <button
          type="button"
          class="mobile-menu-btn"
          style="-webkit-tap-highlight-color:transparent;touch-action:manipulation;"
          aria-label="Atvērt izvēlni"
          aria-expanded="false"
          aria-controls={mobileMenuId}
        >
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
          <span class="w-6 h-0.5 bg-primary transition-all" style="pointer-events:none;" />
        </button>
      )
    }

    <a href="/" class="app-logo">
      <img src="/assets/img/logo.svg" alt="Sofija Ivanova" class="app-logo-img" />
      <div class="app-logo-text">
        <span class="app-logo-name">Sofija Ivanova</span>
        {subtitle && <span class="app-logo-sub">{subtitle}</span>}
      </div>
    </a>

    {
      showAuth && (
        <div class="app-auth">
          {variant === 'admin' ? (
            <>
              <span id="user-info" class="app-user-name" />
              <a href={logoutUrl} class="app-logout">
                <i class="ph ph-sign-out" />
                <span>Iziet</span>
              </a>
            </>
          ) : (
            <>
              <div id="auth-actions" class="app-auth-actions">
                <a
                  class="btn-login"
                  id="login-aad"
                  href={`/.auth/login/aad?post_login_redirect_uri=${variant === 'cabinet' ? '/cabinet' : '/'}`}
                >
                  <i class="ph ph-sign-in" />
                  <span class="login-text">Pieslēgties</span>
                </a>
              </div>
              <div id="auth-user" class="app-auth-user hidden">
                <span id="user-name" class="app-user-name" />
                <a id="logout-link" href={logoutUrl} class="app-logout">
                  <i class="ph ph-sign-out" />
                </a>
              </div>
            </>
          )}
        </div>
      )
    }
  </div>
</header>

{
  showBurger && (
    <div id={mobileMenuId} class="mobile-nav-menu">
      <slot name="mobile-menu" />
    </div>
  )
}

<style>
  /* Header Base Styles */
  .app-header {
    background: var(--color-white, #ffffff);
    border-bottom: 2px solid var(--color-primary, #1b4332);
    padding: 14px 20px;
    position: sticky;
    top: 0;
    z-index: 300;
    box-shadow: 0 2px 8px rgba(27, 67, 50, 0.08);
  }

  .app-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  /* Logo Styles */
  .app-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .app-logo:hover {
    opacity: 0.85;
  }

  .app-logo-img {
    height: 42px;
    width: auto;
  }

  .app-logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .app-logo-name {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 23px;
    font-weight: 700;
    color: var(--color-primary, #1b4332);
    line-height: 1.1;
  }

  .app-logo-sub {
    font-size: 11px;
    color: var(--color-text-light, #6b7280);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
  }

  /* Auth Styles */
  .app-auth {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .app-user-name {
    font-size: 14px;
    color: var(--color-text, #1f2937);
    font-weight: 500;
    display: none;
  }

  .app-logout,
  .btn-login {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text-light, #6b7280);
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 8px;
    transition: all 0.2s;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .app-logout:hover {
    background: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
  }

  .btn-login {
    background: var(--color-primary, #1b4332);
    color: white;
    border-color: var(--color-primary, #1b4332);
  }

  .btn-login:hover {
    background: var(--color-accent, #295d45);
    border-color: var(--color-accent, #295d45);
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    gap: 6px;
    cursor: pointer;
    z-index: 999;
    position: relative;
    background: none;
    border: none;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-primary, #1b4332);
    border-radius: 2px;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .mobile-menu-btn:hover span {
    background: var(--color-accent, #295d45);
  }

  /* Hamburger animation to X */
  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 6px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -6px);
  }

  /* Premium Mobile Menu */
  .mobile-nav-menu {
    position: fixed;
    inset: 0;
    /* iOS Safari 100vh fix */
    height: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 28px 20px 40px;
    background: linear-gradient(160deg, #fbf8f2 0%, #ffffff 48%, #f6f1e8 100%);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) scale(0.98);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  .mobile-nav-menu::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 15%, rgba(201, 163, 106, 0.18), transparent 45%),
      radial-gradient(circle at 85% 30%, rgba(27, 67, 50, 0.12), transparent 40%);
    pointer-events: none;
  }

  .mobile-nav-menu > * {
    position: relative;
    z-index: 1;
  }

  .mobile-nav-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .mobile-nav-menu :global(a),
  .mobile-nav-menu :global(button) {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text, #1f2937);
    text-decoration: none;
    transition: all 0.2s ease;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(27, 67, 50, 0.12);
    border-radius: 16px;
    padding: 14px 18px;
    min-height: 52px;
    width: min(360px, 92vw);
    box-shadow: 0 12px 30px rgba(27, 67, 50, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .mobile-nav-menu :global(a:hover),
  .mobile-nav-menu :global(button:hover) {
    transform: translateY(-1px);
    border-color: rgba(27, 67, 50, 0.3);
    box-shadow: 0 16px 36px rgba(27, 67, 50, 0.16);
    color: var(--color-primary, #1b4332);
  }

  .mobile-nav-menu :global(.mobile-nav-item) {
    justify-content: flex-start;
  }

  .mobile-nav-menu :global(.mobile-nav-item.active) {
    background: linear-gradient(135deg, var(--color-primary, #1b4332), #295d45);
    color: white;
    border-color: transparent;
  }

  .mobile-nav-menu :global(.mobile-nav-item i) {
    font-size: 1.4rem;
  }

  .mobile-nav-menu :global(.mobile-nav-item span) {
    font-size: 1.05rem;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .app-header {
      padding: 12px 16px;
    }
    .app-logo-img {
      height: 38px;
    }
    .app-logo-name {
      font-size: 18px;
    }
    .app-logo-sub {
      font-size: 9px;
      letter-spacing: 1.5px;
    }
    .app-logout span,
    .login-text {
      display: none;
    }
    .app-logout,
    .btn-login {
      padding: 8px;
      font-size: 20px;
    }
  }

  @media (min-width: 600px) {
    .app-user-name {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu-btn,
    .mobile-nav-menu,
    .mobile-nav-menu.open {
      display: none;
    }
    .app-header {
      padding: 18px 32px;
    }
    .app-logo-img {
      height: 48px;
    }
    .app-logo-name {
      font-size: 26px;
    }
    .app-logout span,
    .login-text {
      display: inline;
    }
  }

  /* Variant-specific adjustments */
  .app-header--cabinet {
    border-bottom: 1px solid #e5e7eb;
  }

  .app-header--public {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
  }
</style>

<script is:inline>
  // Mobile menu functionality - inline for iOS Safari compatibility
  (function () {
    function initBurgerMenu() {
      const btns = document.querySelectorAll('.mobile-menu-btn');

      btns.forEach(function (btn) {
        if (btn.dataset.burgerBound === 'true') return;
        const menuId = btn.getAttribute('aria-controls');
        const menu = document.getElementById(menuId);
        if (!menu) return;
        btn.dataset.burgerBound = 'true';

        function toggle(e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = menu.classList.toggle('open');
          btn.classList.toggle('active', isOpen);
          btn.setAttribute('aria-expanded', String(isOpen));
          document.body.style.overflow = isOpen ? 'hidden' : '';
          document.body.style.position = isOpen ? 'fixed' : '';
          document.body.style.width = isOpen ? '100%' : '';
          document.body.style.top = isOpen ? '0' : '';
        }

        function close() {
          menu.classList.remove('open');
          btn.classList.remove('active');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          document.body.style.position = '';
          document.body.style.width = '';
          document.body.style.top = '';
        }

        // Add click handler to button
        btn.addEventListener('click', toggle, false);
        btn.addEventListener(
          'touchstart',
          function (e) {
            e.preventDefault();
            toggle(e);
          },
          { passive: false }
        );

        // Close on link/button click inside menu
        const links = menu.querySelectorAll('a, button[data-tab]');
        for (let i = 0; i < links.length; i++) {
          links[i].addEventListener('click', close, false);
        }

        // Close on overlay click
        menu.addEventListener(
          'click',
          function (e) {
            if (e.target === menu) close();
          },
          false
        );
      });
    }

    // Initialize immediately if DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBurgerMenu);
    } else {
      initBurgerMenu();
    }
  })();
</script>

<script>
  // Initialize auth state for cabinet variant
  if (document.querySelector('.app-header--cabinet')) {
    const authActions = document.getElementById('auth-actions');
    const authUser = document.getElementById('auth-user');
    const userName = document.getElementById('user-name');

    // Check authentication (this will be called by cabinet.astro's auth logic)
    (window as any).updateHeaderAuth = (user: any) => {
      if (user && authActions && authUser && userName) {
        authActions.classList.add('hidden');
        authUser.classList.remove('hidden');
        userName.textContent = user.userDetails || user.userId || '';
      }
    };
  }
</script>
